// motor_tojs FILE: a script as Caustic text on stdout, with the prelude and no document.
use "../src/motor/jsc.cst" as jsc;
use "std/env.cst" as env;
use "std/io.cst" as io;
let is [8388608]u8 as buf with mut;
fn slurp(path as *u8, at as i64) as i64 {
    let is i64 as fd = syscall(2, path, 0, 0);
    if (fd < 0) { return 0; }
    let is i64 as n = syscall(0, fd, cast(i64, &buf) + at, 8388608 - at);
    syscall(3, fd);
    return n;
}
fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i64 as a = slurp("src/motor/prelude.js", 0);
    let is i64 as b = slurp(env.argv(1), a);
    let is i64 as out with mut = 0;
    let is *u8 as t = jsc.translate(cast(*u8, &buf), a + b, &out);
    if (cast(i64, t) == 0) { io.write_str(2, "ERR: "); io.write_str(2, jsc.last_error()); io.write_str(2, "\n"); return 1; }
    let is i64 as off with mut = 0;
    while (off < out) { let is i64 as w = syscall(1, 1, cast(i64, t) + off, out - off); if (w <= 0) { return 2; } off = off + w; }
    return 0;
}
