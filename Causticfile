name "caustic-browser"
version "0.0.2"
author "Cauã Alvarenga Neves"

// caustic-browser — build and test surface.
//
//   caustic-mk run test        the surface test, then the window build
//   caustic-mk build browser   the window
//   caustic-mk run clean       build artifacts
//
// caustic-sdl3 used to be both a git submodule and a `depend` on the local
// directory that submodule checked out into. That is two mechanisms for one
// dependency and neither of them pinned anything useful: the submodule pinned a
// commit that `depend` then ignored, and `depend` read whatever happened to be
// on disk. It also relied on a file — windowsurface.cst — that was never
// committed to caustic-sdl3 at all, so this could only ever have been built on
// the one machine that had it.
//
// One mechanism now, pinned to a tag, resolved from the published repository.
depend "caustic-sdl3" in "https://github.com/Caua726/caustic-sdl3" tag "v0.1.0"

// ── Targets ──────────────────────────────────────────────────────────

target "browser"  { src "src/main.cst"       out "build/browser" }
target "surftest" { src "tests/surftest.cst" out "build/surftest" }
target "test_tok" { src "tests/test_tok.cst" out "build/test_tok" }

// ── Scripts ──────────────────────────────────────────────────────────

// The surface test exercises the platform seam without opening a window, so it
// runs anywhere SDL3 is installed. `browser` is built and not run, because it
// opens one.
script "test" {
    "caustic-mk build test_tok"
    "./build/test_tok"
    "caustic-mk build surftest"
    "./build/surftest"
    "caustic-mk build browser"
    "echo 'test: tokenizer green, surface green, window builds'"
}

// The tokenizer through the optimizing backend as well. It is a state machine
// over a large generated table, which is the shape a second code generator is
// most likely to disagree about.
script "test-opt" {
    "caustic -q -O1 tests/test_tok.cst -o build/test_tok_opt"
    "./build/test_tok_opt"
    "echo 'test-opt: tokenizer green at -O1'"
}

// Build both and run neither.
//
// Everything here links SDL3 — the dependency's `system "SDL3"` is collected
// transitively, so even surftest is dynamically linked against libSDL3.so and
// will not load without it. Ubuntu's current LTS has no SDL3 package, so a
// runner cannot have it without building SDL from source, which would say
// nothing about this repository. Compiling is what CI can honestly check here:
// that the dependency resolves and both targets build.
// The tokenizer links nothing and CAN run on a runner, so it does.
script "test-ci" {
    "caustic-mk build test_tok"
    "./build/test_tok"
    "caustic-mk build surftest"
    "caustic-mk build browser"
    "echo 'test-ci: tokenizer green; SDL3 targets build (not run — no SDL3 on the runner)'"
}

script "clean" {
    "rm -rf .caustic build"
    "echo 'clean: build artifacts and resolved dependencies removed'"
}

script "distclean" {
    "caustic-mk run clean"
    "find . -name '*.cst.s' -delete"
    "find . -name '*.cst.s.o' -delete"
    "echo 'distclean: generated assembly and objects removed too'"
}
