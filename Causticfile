name "caustic-browser"
version "0.0.2"
author "Cauã Alvarenga Neves"

// caustic-browser — build and test surface.
//
//   caustic-mk run test        the tokenizer and paint tests, then the window, driven
//   caustic-mk build browser   the window
//   caustic-mk run clean       build artifacts
//
// caustic-media's toolkit is the window. Its X11 backend links glibc and libX11,
// libXext, libXi, libXfixes, libXrandr, libXcursor and libxkbcommon, so `browser`
// needs them to start. The tokenizer and paint tests link nothing.
depend "caustic-media" in "https://github.com/Caua726/caustic-media" tag "v0.0.2"

// ── Targets ──────────────────────────────────────────────────────────

target "browser"  { src "src/main.cst"       out "build/browser" }
target "test_paint" { src "tests/test_paint.cst" out "build/test_paint" }
target "test_tok" { src "tests/test_tok.cst" out "build/test_tok" }

// ── Scripts ──────────────────────────────────────────────────────────

// The tokenizer and paint tests open no window and link nothing, so they run
// anywhere. test-ui opens the real window on a private X server and drives it.
script "test" {
    "caustic-mk build test_tok"
    "./build/test_tok"
    "caustic-mk build test_paint"
    "./build/test_paint"
    "caustic-mk run test-ui"
    "echo 'test: tokenizer green, paint green, window green'"
}

script "test-ui" {
    "caustic-mk build browser"
    "env -u WAYLAND_DISPLAY xvfb-run -a ./build/browser --check"
}

// The tokenizer through BOTH optimizing backends. It is a state machine over a
// large generated table, which is the shape a second code generator is most
// likely to disagree about — and a level nobody runs is how an -O1-only pass
// in the compiler broke every threaded program while every test passed.
//
// It costs 0.1 s a level, so there is no argument for checking only one.
script "test-opt" {
    "caustic -q -O1 tests/test_tok.cst -o build/test_tok_o1"
    "./build/test_tok_o1"
    "caustic -q -O2 tests/test_tok.cst -o build/test_tok_o2"
    "./build/test_tok_o2"
    "echo 'test-opt: tokenizer green at -O1 and -O2'"
}

// What the published toolchain can build: the tokenizer at all three levels and
// the paint tests. `browser` is left out because the v0.1.11 release cannot compile
// caustic-media, and a runner has no reason to have the libraries it opens with.
script "test-ci" {
    "caustic-mk build test_tok"
    "./build/test_tok"
    "caustic-mk run test-opt"
    "caustic-mk build test_paint"
    "./build/test_paint"
    "echo 'test-ci: tokenizer green at -O0/-O1/-O2, paint green (window not built here)'"
}

script "clean" {
    "rm -rf .caustic build"
    "echo 'clean: build artifacts and resolved dependencies removed'"
}

script "distclean" {
    "caustic-mk run clean"
    "find . -name '*.cst.s' -delete"
    "find . -name '*.cst.s.o' -delete"
    "echo 'distclean: generated assembly and objects removed too'"
}
