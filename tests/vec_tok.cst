// =======================================================
// caustic-browser/tests/vec_tok.cst  —  GENERATED, do not edit.
//
//   git clone --depth 1 https://github.com/html5lib/html5lib-tests
//   python3 tools/gen_tok_vectors.py html5lib-tests/tokenizer > tests/vec_tok.cst
//
// 7032 cases from the html5lib tokenizer conformance suite — the one every
// browser is checked against. Using it rather than cases written here is
// the point: a tokenizer tested against its own author's idea of HTML
// passes.
//
// Each record is  state | u32+lastStartTag | u32+input | u32+expected |
// u32+description, laid end to end. Lengths rather than terminators
// because the inputs contain NUL — several cases exist to check exactly
// that.
//
// `expected` is the token stream flattened to one string; the format and
// why attributes are sorted and character runs joined are documented in
// tools/gen_tok_vectors.py.
//
// xmlViolation.test is left out: it asks for XML-compatible output, a
// different and non-normative contract.
// =======================================================

let is i64 as VEC_COUNT  with imut = 7032;
let is i64 as VEC_BLOBS  with imut = 18;

let is i64 as _VL00 with imut = 40977;
let is *u8 as _VB00 with imut =
