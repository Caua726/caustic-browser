// Static files for the test page, on 127.0.0.1:PORT. usage: srv ROOT PORT
use "std/env.cst" as env;
let is [65536]u8 as req with mut;
let is [8192]u8 as path with mut;
let is [1048576]u8 as file with mut;
fn slen(s as *u8) as i64 { let is i64 as n with mut = 0; while (cast(i64, s[n]) != 0) { n = n + 1; } return n; }
fn ends(p as *u8, n as i64, s as *u8) as i32 {
    let is i64 as m = slen(s);
    if (n < m) { return 0; }
    let is i64 as i with mut = 0;
    while (i < m) { if (cast(i64, p[n - m + i]) != cast(i64, s[i])) { return 0; } i = i + 1; }
    return 1;
}
fn say(fd as i64, s as *u8) as void { syscall(1, fd, s, slen(s)); }
fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is *u8 as root = env.argv(1);
    let is *u8 as ps = env.argv(2);
    let is i64 as port with mut = 0;
    let is i64 as i with mut = 0;
    while (cast(i64, ps[i]) != 0) { port = port * 10 + cast(i64, ps[i]) - 48; i = i + 1; }
    let is i64 as s = syscall(41, 2, 1, 0);
    let is i32 as one with mut = 1;
    syscall(54, s, 1, 2, &one, 4);
    let is [16]u8 as sa;
    i = 0; while (i < 16) { sa[i] = cast(u8, 0); i = i + 1; }
    sa[0] = cast(u8, 2); sa[2] = cast(u8, port >> 8); sa[3] = cast(u8, port & 255);
    sa[4] = cast(u8, 127); sa[7] = cast(u8, 1);
    if (syscall(49, s, &sa, 16) < 0) { return 1; }
    syscall(50, s, 64);
    while (1 == 1) {
        let is i64 as c = syscall(43, s, 0, 0);
        if (c < 0) { continue; }
        let is i64 as n = syscall(0, c, &req, 65535);
        let is i64 as a with mut = 0;
        while (a < n && cast(i64, req[a]) != 32) { a = a + 1; }
        a = a + 1;
        let is i64 as b with mut = a;
        while (b < n && cast(i64, req[b]) != 32 && cast(i64, req[b]) != 63) { b = b + 1; }
        let is i64 as rl = slen(root);
        i = 0; while (i < rl) { path[i] = root[i]; i = i + 1; }
        let is i64 as pl with mut = rl;
        i = a; while (i < b) { path[pl] = req[i]; pl = pl + 1; i = i + 1; }
        if (cast(i64, path[pl - 1]) == 47) { let is *u8 as ix = "index.html"; i = 0; while (i < 10) { path[pl] = ix[i]; pl = pl + 1; i = i + 1; } }
        path[pl] = cast(u8, 0);
        let is i64 as f = syscall(2, &path, 0, 0);
        if (f < 0) { say(c, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"); syscall(3, c); continue; }
        let is i64 as got = syscall(0, f, &file, 1048576);
        syscall(3, f);
        say(c, "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: ");
        if (ends(cast(*u8, &path), pl, ".html") == 1) { say(c, "text/html"); }
        else if (ends(cast(*u8, &path), pl, ".js") == 1) { say(c, "text/javascript"); }
        else if (ends(cast(*u8, &path), pl, ".css") == 1) { say(c, "text/css"); }
        else if (ends(cast(*u8, &path), pl, ".svg") == 1) { say(c, "image/svg+xml"); }
        else if (ends(cast(*u8, &path), pl, ".png") == 1) { say(c, "image/png"); }
        else { say(c, "application/octet-stream"); }
        if (ends(cast(*u8, &path), pl, "-deny.html") == 1) { say(c, "\r\nX-Frame-Options: DENY"); }
        if (ends(cast(*u8, &path), pl, "-csp.html") == 1) { say(c, "\r\nContent-Security-Policy: frame-ancestors 'none'"); }
        if (ends(cast(*u8, &path), pl, "-csp-self.html") == 1) { say(c, "\r\nContent-Security-Policy: frame-ancestors 'self'"); }
        say(c, "\r\nContent-Length: ");
        let is [24]u8 as d;
        let is i64 as p with mut = 23;
        let is i64 as v with mut = got;
        if (v == 0) { d[p] = cast(u8, 48); p = p - 1; }
        while (v > 0) { d[p] = cast(u8, 48 + v % 10); v = v / 10; p = p - 1; }
        syscall(1, c, cast(i64, &d) + p + 1, 23 - p);
        say(c, "\r\n\r\n");
        let is i64 as off with mut = 0;
        while (off < got) { let is i64 as w = syscall(1, c, cast(i64, &file) + off, got - off); if (w <= 0) { break; } off = off + w; }
        syscall(3, c);
    }
    return 0;
}
