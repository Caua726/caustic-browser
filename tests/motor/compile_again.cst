// The compiler in this process, many times over: each must succeed, and memory must not climb.
// Usage: compile_again <generated.cst> <times>. Run from the checkout, after `caustic-mk run motor`.
use "../../src/motor/host.cst" as host;
use "../../src/motor/pack.cst" as pack;
use "../../src/motor/embed.cst" as embed;
fn _rss() as i64 {
    let is [2048]u8 as b;
    let is i64 as fd = syscall(2, "/proc/self/statm", 0, 0);
    let is i64 as n = syscall(0, fd, &b, 2047);
    syscall(3, fd);
    let is i64 as i with mut = 0;
    while (i < n && b[i] != 32) { i = i + 1; }
    i = i + 1;
    let is i64 as v with mut = 0;
    while (i < n && b[i] != 32) { v = v * 10 + cast(i64, b[i]) - 48; i = i + 1; }
    return v * 4;
}
fn _say(v as i64) as void {
    let is [32]u8 as t;
    let is i64 as i with mut = 31;
    let is i64 as x with mut = v;
    t[31] = 10;
    if (x == 0) { i = i - 1; t[i] = 48; }
    while (x > 0) { i = i - 1; t[i] = cast(u8, 48 + x % 10); x = x / 10; }
    syscall(1, 1, cast(i64, &t) + i, 32 - i);
}
fn main(argc as i64, argv as **u8) as i32 {
    // The compiler's image checks the stack against %fs:0. A limit of 0 never trips.
    let is [64]i64 as tls;
    let is i64 as z with mut = 0;
    while (z < 64) { tls[z] = 0; z = z + 1; }
    syscall(158, 4098, &tls);
    let is *u8 as bundle = embed.start();
    let is i64 as rn with mut = 0;
    let is *u8 as rt = pack.find(bundle, "rt.cst", &rn);
    let is i64 as cap = 64 * 1024 * 1024;
    let is *u8 as text = cast(*u8, syscall(9, 0, cap, 3, 34, -1, 0));
    let is i64 as k with mut = 0;
    while (k < rn) { text[k] = rt[k]; k = k + 1; }
    let is i64 as fd = syscall(2, argv[1], 0, 0);
    let is i64 as n with mut = rn;
    while (1 == 1) { let is i64 as r = syscall(0, fd, cast(i64, text) + n, cap - n); if (r <= 0) { break; } n = n + r; }
    syscall(3, fd);
    let is i64 as times with mut = 0;
    let is i64 as q with mut = 0;
    while (argv[2][q] != 0) { times = times * 10 + cast(i64, argv[2][q]) - 48; q = q + 1; }
    let is i64 as t with mut = 0;
    while (t < times) {
        let is i32 as rc = host._compile(bundle, text, n, "-O1", "build/motor/test/again.csl", cast(*u8, 0));
        if (rc != 0) { syscall(1, 1, "refused\n", 8); return 1; }
        _say(_rss());
        t = t + 1;
    }
    return 0;
}
