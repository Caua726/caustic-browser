// The display list: no window and nothing linked, so it runs anywhere.
// Exit 0 = all pass; non-zero = the number of failures.

use "std/io.cst" as io;
use "../src/paint/display_list.cst" as dl;
use "../src/paint/placeholder.cst" as placeholder;

let is i64 as _fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 1) { return; }
    _fails = _fails + 1;
    io.write_str(1, "FAIL  ");
    io.write_str(1, name);
    io.write_str(1, "\n");
}

fn main() as i32 {
    let is dl.List as l;
    check("init", cast(i32, dl.init(&l) == 0));
    check("starts empty", cast(i32, dl.count(&l) == 0));
    check("rgb packs 0xRRGGBB", cast(i32, dl.rgb(1, 2, 3) == 66051));

    let is *u8 as hello = "hello";
    dl.rect(&l, 1.0, 2.0, 3.0, 4.0, 5);
    dl.text(&l, 6.0, 7.0, 8.0, hello, 5, 16.0, 700, 9);
    check("both are listed", cast(i32, dl.count(&l) == 2));
    let is *dl.Cmd as r = dl.at(&l, 0);
    check("rect keeps its fields", cast(i32, r.kind == dl.RECT && r.x == 1.0 && r.y == 2.0 && r.w == 3.0 && r.h == 4.0 && r.color == 5));
    let is *dl.Cmd as t = dl.at(&l, 1);
    check("text keeps its fields", cast(i32, t.kind == dl.TEXT && t.x == 6.0 && t.y == 7.0 && t.w == 8.0 && t.len == 5 && t.size == 16.0 && t.weight == 700 && t.color == 9));
    check("text is not copied", cast(i32, cast(i64, t.text) == cast(i64, hello)));

    // Past the starting capacity, in order, nothing lost on the way.
    dl.clear(&l);
    let is i64 as i with mut = 0;
    while (i < 1000) {
        check("grows", dl.rect(&l, 0.0, 0.0, 0.0, 0.0, i));
        i = i + 1;
    }
    check("all of them are there", cast(i32, dl.count(&l) == 1000));
    i = 0;
    let is i32 as kept with mut = 1;
    while (i < 1000) {
        if (dl.at(&l, i).color != i) { kept = 0; }
        i = i + 1;
    }
    check("growing keeps what was listed", kept);

    // A new tab's content, replacing whatever the list held.
    placeholder.fill(&l);
    check("placeholder: title, rule, body", cast(i32, dl.count(&l) == 3));
    check("placeholder: text has its length", cast(i32, dl.at(&l, 0).len == 15));

    dl.free(&l);
    if (_fails != 0) { return cast(i32, _fails); }
    io.write_str(1, "paint: all checks pass\n");
    return 0;
}
