// The seam's pixel code against a plain buffer: no window and no display server,
// so it runs anywhere. Exit 0 = all pass; non-zero = the number of failures.

use "std/io.cst" as io;
use "../src/platform/pixels.cst" as px;

let is i64 as W with imut = 8;
let is i64 as H with imut = 6;
let is [48]u32 as _px with mut;
let is i64 as _fails with mut = 0;

fn check(name as *u8, ok as i32) as void {
    if (ok == 1) { return; }
    _fails = _fails + 1;
    io.write_str(1, "FAIL  ");
    io.write_str(1, name);
    io.write_str(1, "\n");
}

fn count(color as u32) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    while (i < W * H) {
        if (_px[i] == color) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn main() as i32 {
    let is px.Canvas as s;
    s.base = cast(*u8, &_px);
    s.width = W;
    s.height = H;
    let is u32 as black = cast(u32, 0);
    let is u32 as c = px.rgb(1, 2, 3);

    // 0xFF030201: red in the low byte. caustic-media's buffers read this way.
    check("rgb packs 0xAABBGGRR", cast(i32, cast(i64, c) == 4278387201));

    px.put_pixel(&s, 3, 2, c);
    check("put_pixel lands at y * width + x", cast(i32, _px[19] == c));
    check("put_pixel writes one pixel", cast(i32, count(c) == 1));

    px.put_pixel(&s, 0 - 1, 0, px.rgb(9, 9, 9));
    px.put_pixel(&s, 0, 0 - 1, px.rgb(9, 9, 9));
    px.put_pixel(&s, W, 0, px.rgb(9, 9, 9));
    px.put_pixel(&s, 0, H, px.rgb(9, 9, 9));
    check("put_pixel ignores out of bounds", cast(i32, count(px.rgb(9, 9, 9)) == 0));

    px.clear(&s, black);
    check("clear reaches every pixel", cast(i32, count(black) == W * H));

    px.fill_rect(&s, 0 - 2, 0 - 2, 4, 4, c);
    check("fill_rect clips at the corner", cast(i32, count(c) == 4));
    check("fill_rect fills what is left", cast(i32, _px[0] == c && _px[1] == c && _px[8] == c && _px[9] == c));

    px.clear(&s, black);
    px.fill_rect(&s, 6, 4, 5, 5, c);
    check("fill_rect clips at the far edge", cast(i32, count(c) == 4));

    if (_fails != 0) { return cast(i32, _fails); }
    io.write_str(1, "surface: all checks pass\n");
    return 0;
}
