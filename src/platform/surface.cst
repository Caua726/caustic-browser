// platform/surface.cst — the engine's window/pixel seam.
//
// The whole engine draws into OUR pixel buffer (`canvas`, see pixels.cst) and
// never talks to a backend directly. caustic-media opens the window and hands
// out that buffer one frame at a time: there is no GPU and no drawing call of
// anyone else's, so we own every pixel. `canvas` is only good between begin() and
// present(), since the next frame may be a different buffer, or a different size.

use "caustic-media/window/window.cst" as win;
use "caustic-media/window/device.cst" as device;
use "caustic-media/window/event.cst" as event;
use "caustic-media/input/event.cst" as input;
use "caustic-media/window/wait.cst" as wait;
use "caustic-media/gpu/software/target.cst" as tgt;
use "./pixels.cst" as px;

// What poll() reports. The engine's own names, so no backend's numbering leaks
// past this file.
let is i32 as EV_NONE   with imut = 0;
let is i32 as EV_OTHER  with imut = 1;
let is i32 as EV_REDRAW with imut = 2;   // what is on screen is stale: draw again
let is i32 as EV_CLOSE  with imut = 3;

struct Surface {
    win    as device.Window;
    waiter as wait.Wait;
    canvas as px.Canvas;   // the frame being drawn
    ok     as i64;         // 1 when open() succeeded
}

// open — create the window and what the loop sleeps on. Returns 0 on success,
// or a positive stage code on failure (1 window, 2 waiter).
fn open(s as *Surface, title as *u8, w as i64, h as i64) as i64 {
    s.canvas.base = cast(*u8, 0);
    s.canvas.width = 0; s.canvas.height = 0; s.ok = 0;

    s.win = win.open(title, w, h);
    if (win.is_open(&s.win) == 0) { return 1; }

    s.waiter = wait.open();
    if (wait.is_open(&s.waiter) == 0) { win.close(&s.win); return 2; }

    s.ok = 1;
    return 0;
}

// begin — start a frame and take its buffer. Returns 1 when there is one; 0 when
// the window is closing or has none to give, and the caller should wait and try
// again. next_frame comes first because acquire hands out nothing without it, and
// it is where Wayland paces us, so a window with nothing to draw never calls it.
fn begin(s as *Surface) as i64 {
    if (win.next_frame(&s.win) == 0) { return 0; }
    let is tgt.Target as t = win.acquire(&s.win);
    s.canvas.base = t.color;
    s.canvas.width = t.width;
    s.canvas.height = t.height;
    if (cast(i64, t.color) == 0) { return 0; }
    return 1;
}

// present — publish the finished frame to the window.
fn present(s as *Surface) as void { win.submit(&s.win); }

// wait — sleep until something arrives for the window, then bring it in.
fn wait_event(s as *Surface) as void {
    wait.wait(&s.waiter, &s.win, 0 - 1);
    device.pump(&s.win);
}

// poll — next pending event, or EV_NONE once both queues are empty. Input has to
// be read even while nothing uses it: wait_event does not sleep while any of it
// is queued, so leaving it there turns the idle loop into a spin.
fn poll(s as *Surface) as i32 {
    let is event.Event as e;
    if (win.poll_event(&s.win, &e) == 1) {
        if (e.kind == event.CLOSE) { return EV_CLOSE; }
        if (e.kind == event.RESIZE || e.kind == event.EXPOSE) { return EV_REDRAW; }
        return EV_OTHER;
    }
    let is input.Event as i;
    if (win.poll_input(&s.win, &i) == 1) { return EV_OTHER; }
    return EV_NONE;
}

fn should_close(s as *Surface) as i32 { return win.should_close(&s.win); }

fn close(s as *Surface) as void {
    if (s.ok != 1) { return; }
    wait.close(&s.waiter);
    win.close(&s.win);
    s.ok = 0;
}
