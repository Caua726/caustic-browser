// platform/pixels.cst — drawing into a buffer of pixels.
//
// No window and no backend in here. What draws does not need to know what shows
// the result, and this way its test links nothing and runs on any machine.

struct Canvas {
    base   as *u8;    // width * height pixels, no padding
    width  as i64;    // pixels
    height as i64;    // rows
}

// 0xAABBGGRR with alpha forced opaque: red in the low byte, which is what
// caustic-media's buffers hold on every backend. Each one converts on its way
// to the screen.
fn rgb(r as i64, g as i64, b as i64) as u32 {
    return cast(u32, 4278190080 + b * 65536 + g * 256 + r);  // 4278190080 = 0xFF000000
}

// put_pixel — one pixel (0xAABBGGRR), bounds-checked.
fn put_pixel(c as *Canvas, x as i64, y as i64, color as u32) as void {
    if (x < 0 || y < 0 || x >= c.width || y >= c.height) { return; }
    let is *u32 as p = cast(*u32, cast(i64, c.base) + (y * c.width + x) * 4);
    p[0] = color;
}

fn fill_rect(c as *Canvas, x as i64, y as i64, w as i64, h as i64, color as u32) as void {
    let is i64 as yy with mut = y;
    while (yy < y + h) {
        let is i64 as xx with mut = x;
        while (xx < x + w) { put_pixel(c, xx, yy, color); xx = xx + 1; }
        yy = yy + 1;
    }
}

fn clear(c as *Canvas, color as u32) as void { fill_rect(c, 0, 0, c.width, c.height, color); }
