// ui/chrome.cst — the parts of the window the toolkit has no widget for: the mark,
// the tabs in the title bar, and buttons that show an icon. Their colours come from
// the theme (theme.cst) and their shapes from icons.cst.

use "caustic-media/math/math.cst" as math;
use "caustic-media/render/shapes2d.cst" as shapes;
use "caustic-media/text/layout/model.cst" as model;
use "caustic-media/ui/tree.cst" as tree;
use "caustic-media/ui/widget.cst" as widget;
use "caustic-media/ui/geom.cst" as geom;
use "caustic-media/ui/layout.cst" as layout;
use "caustic-media/ui/event.cst" as event;
use "caustic-media/ui/painter.cst" as painter;
use "caustic-media/ui/signal.cst" as signal;
use "caustic-media/ui/style.cst" as style;
use "caustic-media/ui/access.cst" as access;
use "caustic-media/ui/text.cst" as txt;
use "caustic-media/ui/scroll.cst" as scroll;
use "caustic-media/input/keys.cst" as keys;
use "caustic-media/ui/widgets/titlebar.cst" as titlebar;
use "./icons.cst" as icons;

let is i32 as BACK    with imut = icons.BACK;
let is i32 as FORWARD with imut = icons.FORWARD;
let is i32 as RELOAD  with imut = icons.RELOAD;
let is i32 as PLUS    with imut = icons.PLUS;
let is i32 as MORE    with imut = icons.MORE;

let is f64 as TAB_PAD   with imut = 12.0;   // either side of a title; its × sits in this
let is f64 as TAB_TEXT  with imut = 13.0;
let is f64 as ICON_SIZE with imut = 30.0;   // what takes the pointer; icons draw at 18
let is f64 as LOGO_W    with imut = 46.0;
let is f64 as WHEEL     with imut = 48.0;   // the strip's travel per notch
let is f64 as DRAG_ROOM  with imut = 48.0;  // kept free to take hold of the window
let is f64 as TABS_LEAST with imut = 120.0;
// The title bar's own gap beside each of its buttons (its _GAP), which it does not say.
let is f64 as BUTTON_GAP with imut = 6.0;

let is txt.Run as _run with mut;
let is i32 as _ready with mut = 0;
let is tree.Kind as _logo_kind with mut;
let is tree.Kind as _tab_kind with mut;
let is tree.Kind as _tab_area_kind with mut;
let is tree.Kind as _icon_kind with mut;

struct Tab {
    title   as *u8;
    n       as i64;
    active  as i32;
    closing as i32;   // held down over the ×, or with the middle button
    reveal  as i32;   // scroll it into view once it has been laid out
    _pad0   as i32;
}

struct Icon {
    icon     as i32;
    pressing as i32;
}

fn _init() as void {
    if (_ready == 1) { return; }
    _run = txt.run();
    _logo_kind = widget.kind("browser_mark", 0);
    _logo_kind.measure = fn_ptr(_logo_measure);
    _logo_kind.paint = fn_ptr(_logo_paint);
    _tab_area_kind = widget.kind("browser_tab_area", 0);
    _tab_area_kind.measure = fn_ptr(_tab_area_measure);
    _tab_area_kind.arrange = fn_ptr(_tab_area_arrange);
    _tab_kind = widget.kind("browser_tab", sizeof(Tab));
    _tab_kind.measure = fn_ptr(_tab_measure);
    _tab_kind.paint = fn_ptr(_tab_paint);
    _tab_kind.arrange = fn_ptr(_tab_arrange);
    _tab_kind.event = fn_ptr(_tab_event);
    _tab_kind.role = access.ROLE_TAB;
    _tab_kind.access = fn_ptr(_tab_access);
    _icon_kind = widget.kind("browser_icon", sizeof(Icon));
    _icon_kind.measure = fn_ptr(_icon_measure);
    _icon_kind.paint = fn_ptr(_icon_paint);
    _icon_kind.event = fn_ptr(_icon_event);
    _icon_kind.role = access.ROLE_BUTTON;
    _icon_kind.access = fn_ptr(_icon_access);
    _ready = 1;
}

// s laid out into _run on one line, in the interface's family. 1 when it could be.
fn _lay(svc as *txt.Service, th as *style.Theme, s as *u8, n as i64, size as f64, weight as i64) as i32 {
    let is txt.Style as st = txt.style_of(th.fonts.body);
    st.family = th.fonts.family;
    st.size = size;
    st.weight = weight;
    let is model.Params as pp = model.params();
    pp.width = 0.0 - 1.0;
    return txt.lay_plain(svc, &_run, s, n, &st, &pp);
}

// --- the mark -----------------------------------------------------------------

fn logo(t as *tree.Tree, parent as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_logo_kind, parent);
    if (w != 0) { layout.set_stretch(t, w, 0.0, 1.0); }
    return w;
}

fn _logo_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    geom.size_zero(out);
    out.min_w = LOGO_W;
    out.pref_w = LOGO_W;
    out.max_w = LOGO_W;
    out.max_h = layout.UNBOUNDED;
}

fn _logo_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *txt.Service as svc = txt.of(t);
    if (cast(i64, svc) == 0) { return; }
    if (_lay(svc, p.theme, "C", 1, 22.0, 800) == 1) {
        txt.draw(svc, p.canvas, &_run, p.rect.x + 22.0 - _run.width / 2.0,
                 p.rect.y + (p.rect.h - _run.height) / 2.0, p.theme.palette.fg);
    }
    shapes.fill_rect(p.canvas, p.rect.x + LOGO_W - 1.0, p.rect.y + (p.rect.h - 16.0) / 2.0, 1.0, 16.0,
                     p.theme.palette.separator);
}

// --- tabs ---------------------------------------------------------------------

// Where the tabs' scroll area goes. A title bar gives what it holds all it asks for,
// so a scroll area alone would ask for every tab and run under the window's buttons.
// This asks for that much only while there is room.
fn tab_area(t as *tree.Tree, parent as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_tab_area_kind, parent);
    if (w != 0) { layout.set_stretch(t, w, 0.0, 1.0); }
    return w;
}

// What else shares the title bar's line with the tabs, measured: the rest of the
// start row, the window's buttons, the bar's padding, and room to drag the window.
fn _rest_of_title_bar(t as *tree.Tree, area as i64) as f64 {
    let is i64 as start = tree.parent(t, area);
    let is i64 as head = tree.parent(t, start);
    let is style.Theme as th;
    widget.theme(t, area, &th);
    let is geom.Constraint as free = geom.unbounded();
    let is geom.Size as s;
    let is f64 as used with mut = th.metrics.space_m * 3.0 + DRAG_ROOM;
    let is i64 as ch with mut = tree.first_child(t, start);
    while (ch != 0) {
        if (ch != area) {
            layout.measure(t, ch, &free, &s);
            used = used + s.pref_w;
        }
        ch = tree.next_sibling(t, ch);
    }
    let is i32 as which with mut = titlebar.MINIMIZE;
    while (which <= titlebar.CLOSE) {
        let is i64 as b = titlebar.button(t, head, which);
        if (b != 0) {
            layout.measure(t, b, &free, &s);
            used = used + s.pref_w + BUTTON_GAP;
        }
        which = which + 1;
    }
    return used;
}

fn _tab_area_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    layout.measure(t, tree.first_child(t, w), c, out);
    // The root has the window's size before anything is measured.
    let is f64 as room with mut = layout.rect(t, tree.root(t)).w - _rest_of_title_bar(t, w);
    if (room < TABS_LEAST) { room = TABS_LEAST; }
    if (out.pref_w > room) { out.pref_w = room; }
    out.min_w = 0.0;
}

fn _tab_area_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is math.rect.Rect as all = math.rect.rect(0.0, 0.0, r.w, r.h);
    layout.place(t, tree.first_child(t, w), &all);
}

// A tab as the last child of parent, a row that is the content of a scroll area. It
// keeps title, which must outlive it. Says CLICKED when chosen and CLOSED when asked
// to close: both are the program's to do.
fn tab(t as *tree.Tree, parent as i64, title as *u8, n as i64) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_tab_kind, parent);
    if (w == 0) { return 0; }
    let is *Tab as d = cast(*Tab, tree.data(t, w));
    d.title = title;
    d.n = n;
    d.active = 0;
    d.closing = 0;
    d.reveal = 0;
    layout.set_stretch(t, w, 0.0, 1.0);
    tree.set_focusable(t, w, 1);
    return w;
}

fn _scroller(t as *tree.Tree, w as i64) as i64 { return tree.parent(t, tree.parent(t, w)); }

// Scrolled into view at the next layout, the first time a new tab has a place.
fn reveal_tab(t as *tree.Tree, w as i64) as void {
    cast(*Tab, tree.data(t, w)).reveal = 1;
    widget.changed(t, w, widget.CHANGED_LAYOUT | widget.CHANGED_PAINT);
}

fn _tab_arrange(t as *tree.Tree, w as i64, data as *u8, r as *math.rect.Rect) as void {
    let is *Tab as d = cast(*Tab, data);
    if (d.reveal == 0) { return; }
    d.reveal = 0;
    scroll.scroll_to(t, _scroller(t, w), w, scroll.NEAREST, scroll.NEAREST);
}

fn _tab_access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    let is *Tab as d = cast(*Tab, data);
    if (q.action == access.ASK) {
        q.name = d.title;
        q.name_len = d.n;
        q.actions = access.PRESS;
        if (d.active == 1) { q.states = q.states | access.SELECTED; }
        return 1;
    }
    if (q.action == access.PRESS) {
        signal.emit(t, w, signal.CLICKED, cast(*u8, 0));
        return 1;
    }
    return 0;
}

fn set_tab_active(t as *tree.Tree, w as i64, on as i32) as void {
    cast(*Tab, tree.data(t, w)).active = on;
    widget.changed(t, w, widget.CHANGED_PAINT);
}

fn tab_active(t as *tree.Tree, w as i64) as i32 {
    return cast(*Tab, tree.data(t, w)).active;
}

fn _tab_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    geom.size_zero(out);
    out.max_h = layout.UNBOUNDED;
    let is *txt.Service as svc = txt.of(t);
    if (cast(i64, svc) == 0) { return; }
    let is style.Theme as th;
    widget.theme(t, w, &th);
    let is *Tab as d = cast(*Tab, data);
    // At the active weight whatever its state, so choosing a tab moves nothing.
    if (_lay(svc, &th, d.title, d.n, TAB_TEXT, 600) == 0) { return; }
    out.min_w = _run.width + TAB_PAD * 2.0;
    out.pref_w = out.min_w;
    out.max_w = out.min_w;
}

fn _tab_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *txt.Service as svc = txt.of(t);
    if (cast(i64, svc) == 0) { return; }
    let is *Tab as d = cast(*Tab, data);
    let is i32 as hover = painter.has(p, painter.S_HOVER);
    let is i64 as weight with mut = 400;
    if (d.active == 1) { weight = 600; }
    if (_lay(svc, p.theme, d.title, d.n, TAB_TEXT, weight) == 0) { return; }
    let is math.color.Color as col with mut = p.theme.palette.fg_dim;
    if (d.active == 1 || hover == 1) { col = p.theme.palette.fg; }
    txt.draw(svc, p.canvas, &_run, p.rect.x + TAB_PAD, p.rect.y + (p.rect.h - _run.height) / 2.0, col);
    if (d.active == 1) {
        shapes.fill_rounded(p.canvas, p.rect.x + TAB_PAD, p.rect.y + p.rect.h - 6.0, _run.width, 2.0,
                            1.0, 1.0, 1.0, 1.0, p.theme.palette.accent);
    }
    if (hover == 1) {
        icons.draw(svc, p.canvas, icons.CLOSE, p.rect.x + p.rect.w - TAB_PAD / 2.0, p.rect.y + p.rect.h / 2.0, col);
    }
}

fn _in_close(t as *tree.Tree, w as i64, e as *event.Event) as i32 {
    let is math.rect.Rect as r = layout.rect(t, w);
    return cast(i32, e.local_x >= r.w - TAB_PAD && e.local_x < r.w && e.local_y >= 0.0 && e.local_y < r.h);
}

fn _plain(e as *event.Event) as i32 {
    return cast(i32, e.mods == 0 && (e.key == keys.SPACE || e.key == keys.RETURN));
}

fn _tab_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Tab as d = cast(*Tab, data);
    // A plain wheel moves the strip, which scrolls sideways and nothing else.
    if (e.kind == event.SCROLL) {
        scroll.scroll_by(t, _scroller(t, w), (e.dx + e.dy) * WHEEL, 0.0);
        return 1;
    }
    if (e.kind == event.SHORTCUT_OVERRIDE) { return cast(i64, _plain(e)); }
    if (e.kind == event.KEY_DOWN && _plain(e) == 1) {
        signal.emit(t, w, signal.CLICKED, cast(*u8, 0));
        return 1;
    }
    if (e.kind == event.POINTER_DOWN) {
        if (e.button == 2) { d.closing = 2; return 1; }
        if (e.button != 1) { return 0; }
        if (_in_close(t, w, e) == 1) { d.closing = 1; return 1; }
        signal.emit(t, w, signal.CLICKED, cast(*u8, 0));
        return 1;
    }
    if (e.kind == event.POINTER_UP || e.kind == event.POINTER_CANCEL) {
        let is i32 as was = d.closing;
        d.closing = 0;
        if (was == 0) { return 0; }
        if (e.kind == event.POINTER_UP && (was == 2 || _in_close(t, w, e) == 1)) {
            signal.emit(t, w, signal.CLOSED, cast(*u8, 0));
        }
        return 1;
    }
    return 0;
}

// --- icon buttons -------------------------------------------------------------

// A button showing icon, as the last child of parent. Says CLICKED.
fn icon_button(t as *tree.Tree, parent as i64, icon as i32) as i64 {
    _init();
    let is i64 as w = tree.create(t, &_icon_kind, parent);
    if (w == 0) { return 0; }
    let is *Icon as d = cast(*Icon, tree.data(t, w));
    d.icon = icon;
    d.pressing = 0;
    layout.set_stretch(t, w, 0.0, 1.0);
    tree.set_focusable(t, w, 1);
    return w;
}

fn _icon_name(icon as i32) as *u8 {
    if (icon == BACK) { return "Voltar"; }
    if (icon == FORWARD) { return "Avançar"; }
    if (icon == RELOAD) { return "Recarregar"; }
    if (icon == PLUS) { return "Nova aba"; }
    return "Menu";
}

fn _icon_access(t as *tree.Tree, w as i64, data as *u8, q as *tree.Access) as i64 {
    if (q.action == access.ASK) {
        q.name = _icon_name(cast(*Icon, data).icon);
        q.name_len = 0;
        while (q.name[q.name_len] != 0) { q.name_len = q.name_len + 1; }
        q.actions = access.PRESS;
        return 1;
    }
    if (q.action == access.PRESS) {
        signal.emit(t, w, signal.CLICKED, cast(*u8, 0));
        return 1;
    }
    return 0;
}

fn _icon_measure(t as *tree.Tree, w as i64, data as *u8, c as *geom.Constraint, out as *geom.Size) as void {
    geom.size_zero(out);
    out.min_w = ICON_SIZE;
    out.pref_w = ICON_SIZE;
    out.max_w = ICON_SIZE;
    out.min_h = ICON_SIZE;
    out.pref_h = ICON_SIZE;
    out.max_h = layout.UNBOUNDED;
}

fn _icon_paint(t as *tree.Tree, w as i64, data as *u8, p as *painter.Painter) as void {
    let is *Icon as d = cast(*Icon, data);
    let is f64 as cx = p.rect.x + p.rect.w / 2.0;
    let is f64 as cy = p.rect.y + p.rect.h / 2.0;
    let is i32 as off = painter.has(p, painter.S_DISABLED);
    if (off == 0 && (d.pressing == 1 || painter.has(p, painter.S_HOVER) == 1)) {
        let is f64 as a with mut = 0.08;
        if (d.pressing == 1) { a = 0.14; }
        let is f64 as half = ICON_SIZE / 2.0;
        shapes.fill_rounded(p.canvas, cx - half, cy - half, ICON_SIZE, ICON_SIZE, 9.0, 9.0, 9.0, 9.0,
                            style.with_alpha(p.theme.palette.fg, a));
    }
    let is *txt.Service as svc = txt.of(t);
    if (cast(i64, svc) == 0) { return; }
    let is math.color.Color as col with mut = p.theme.palette.fg;
    if (off == 1) { col = style.with_alpha(col, p.theme.control.disabled_alpha); }
    icons.draw(svc, p.canvas, d.icon, cx, cy, col);
}

fn _icon_event(t as *tree.Tree, w as i64, data as *u8, e as *event.Event) as i64 {
    let is *Icon as d = cast(*Icon, data);
    if (e.kind == event.SHORTCUT_OVERRIDE) { return cast(i64, _plain(e)); }
    if (e.kind == event.KEY_DOWN && _plain(e) == 1) {
        signal.emit(t, w, signal.CLICKED, cast(*u8, 0));
        return 1;
    }
    if (e.kind == event.POINTER_DOWN) {
        if (e.button != 1) { return 0; }
        d.pressing = 1;
        widget.changed(t, w, widget.CHANGED_PAINT);
        return 1;
    }
    if (e.kind == event.POINTER_UP || e.kind == event.POINTER_CANCEL) {
        if (d.pressing == 0) { return 0; }
        d.pressing = 0;
        widget.changed(t, w, widget.CHANGED_PAINT);
        let is math.rect.Rect as r = layout.rect(t, w);
        if (e.kind == event.POINTER_UP && e.local_x >= 0.0 && e.local_y >= 0.0 && e.local_x < r.w && e.local_y < r.h) {
            signal.emit(t, w, signal.CLICKED, cast(*u8, 0));
        }
        return 1;
    }
    return 0;
}
