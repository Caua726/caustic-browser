// ui/theme.cst — the browser's look: dark always, flat, and blue only for what is
// selected or has the focus.

use "caustic-media/math/math.cst" as math;
use "caustic-media/ui/ui.cst" as ui;

fn apply(a as *ui.app.App) as void {
    let is ui.style.Theme as th with mut = ui.style.dark();
    let is math.color.Color as head = math.color.hex(0x15181D);
    let is math.color.Color as field = math.color.hex(0x252930);
    let is math.color.Color as blue = math.color.hex(0x3478F6);
    th.palette.window_bg = head;
    th.palette.titlebar_bg = head;
    th.palette.popover_bg = math.color.hex(0x1C2026);
    th.palette.separator = math.color.hex(0x30353D);
    th.palette.fg = math.color.hex(0xF1F2F4);
    th.palette.fg_dim = math.color.hex(0x9CA3AD);
    th.palette.accent = blue;
    th.palette.focus = blue;
    th.fonts.family = "Inter";       // the system's faces are its fallback
    th.fonts.body.size = 13.0;
    th.metrics.titlebar_height = 38.0;
    th.metrics.control_height = 32.0;
    th.metrics.control_pad_x = 14.0;
    th.metrics.radius_m = 9.0;
    // One thin line, on the control's own edge, only when focus moved by keyboard.
    th.metrics.focus_width = 1.0;
    th.metrics.focus_offset = 0.0;
    th.metrics.focus_radius = 9.0;
    // The address: a filled surface. The ring above is its only outline, because
    // it has the focus from the start and blue must not be permanent.
    th.field.normal.bg = field;
    th.field.normal.border = ui.style.with_alpha(field, 0.0);
    th.field.checked.bg = field;
    th.field.checked.border = ui.style.with_alpha(field, 0.0);
    th.metrics.caption_button = 30.0;
    th.control.disabled_alpha = 0.35;
    // Fixed, because the desktop's preferences would otherwise replace it.
    ui.app.fix_theme(a, &th);
}
