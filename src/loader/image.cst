// loader/image.cst — encoded bytes into pixels the page can draw.
//
// caustic-image decodes to whatever the file holds, and a texture wants one layout, so
// everything becomes 8-bit RGBA here. 16-bit samples keep their high byte, which on the
// little-endian machines this runs on is the second of the pair.

use "caustic-image/decode.cst" as dec;
use "caustic-image/formats/gif.cst" as gif;
use "caustic-image/core/image.cst" as cimg;
use "caustic-image/core/pixfmt.cst" as pf;
use "../paint/display_list.cst" as dl;
use "std/mem.cst" as mem;

// More frames than this comes to, in memory, and it is shown still: its frames are kept
// whole, and a long one at a large size is a lot of them.
let is i64 as MAX_ANIM_BYTES with imut = 268435456;

fn _still(im as *dl.Image) as void {
    im.anim = cast(*u8, 0);
    im.frame = 0;
    im.frame_due = 0;
    im.frame_up = 0;
    im.moved = 0;
}

// A GIF of more than one frame into im, ready to run. 0 when it is not one, for the
// ordinary way to read it.
fn _decode_moving(data as *u8, len as i64, im as *dl.Image) as i64 {
    if (len < 6 || data[0] != 71 || data[1] != 73 || data[2] != 70) { return 0; }
    let is *gif.GifAnim as a = cast(*gif.GifAnim, mem.core.mmap_anon(sizeof(gif.GifAnim)));
    let is i64 as got = cast(i64, a);
    if (got == 0 || got == 0 - 1) { return 0; }
    if (gif.gif_decode_anim(data, len, a) != 0) {
        mem.core.munmap(cast(*u8, a), sizeof(gif.GifAnim));
        return 0;
    }
    if (a.count < 2 || a.count * a.width * a.height * 4 > MAX_ANIM_BYTES) {
        gif.gif_anim_free(a);
        mem.core.munmap(cast(*u8, a), sizeof(gif.GifAnim));
        return 0;
    }
    im.anim = cast(*u8, a);
    im.frame = 0;
    im.frame_due = 0;
    im.frame_up = 0;
    im.moved = 0;
    im.pixels = gif.gif_anim_frame(a, 0);
    im.width = a.width;
    im.height = a.height;
    im.tex = 0;
    im.nat_w = cast(f64, a.width);
    im.nat_h = cast(f64, a.height);
    im.sized = 1;
    im.keeps_shape = 0;
    im.mask_tex = 0;
    return 1;
}

// Onto its next frame, if it is time. 1 when it moved. A delay of nothing, or next to it,
// is how old files say "as fast as you can", and every browser reads it as a tenth of a second.
fn step(im as *dl.Image, now as i64) as i64 {
    if (cast(i64, im.anim) == 0) { return 0; }
    let is *gif.GifAnim as a = cast(*gif.GifAnim, im.anim);
    if (im.frame_due == 0) { im.frame_due = now + _delay_of(a, im.frame); }
    if (now < im.frame_due) { return 0; }
    im.frame = (im.frame + 1) % a.count;
    im.pixels = gif.gif_anim_frame(a, im.frame);
    im.frame_due = now + _delay_of(a, im.frame);
    im.moved = 1;
    return 1;
}

fn _delay_of(a as *gif.GifAnim, i as i64) as i64 {
    let is i64 as cs = *cast(*i64, a.delays + i * 8);
    if (cs <= 1) { return 100; }
    return cs * 10;
}

// len bytes into im. 1, or 0 when they are not an image this can read.
fn decode(data as *u8, len as i64, im as *dl.Image) as i64 {
    if (_decode_moving(data, len, im) == 1) { return 1; }
    _still(im);
    let is cimg.Image as src with mut;
    if (dec.decode(data, len, &src) != 0) { return 0; }
    let is i64 as w = src.width;
    let is i64 as h = src.height;
    let is i64 as f = src.fmt;
    let is i64 as chans with mut = 0;
    let is i64 as step with mut = 1;
    if (f == pf.FMT_GRAY8) { chans = 1; }
    if (f == pf.FMT_GRAYA8) { chans = 2; }
    if (f == pf.FMT_RGB8) { chans = 3; }
    if (f == pf.FMT_RGBA8) { chans = 4; }
    if (f == pf.FMT_GRAY16) { chans = 1; step = 2; }
    if (f == pf.FMT_GRAYA16) { chans = 2; step = 2; }
    if (f == pf.FMT_RGB16) { chans = 3; step = 2; }
    if (f == pf.FMT_RGBA16) { chans = 4; step = 2; }
    if (chans == 0) {
        cimg.image_free(&src);
        return 0;
    }
    let is *u8 as out = mem.core.mmap_anon(w * h * 4);
    let is i64 as ok = cast(i64, out);
    if (ok == 0 || ok == 0 - 1) {
        cimg.image_free(&src);
        return 0;
    }
    let is i64 as hi = step - 1;
    let is i64 as y with mut = 0;
    while (y < h) {
        let is *u8 as row = cimg.image_row(&src, y);
        let is *u8 as dst = &out[y * w * 4];
        let is i64 as x with mut = 0;
        while (x < w) {
            let is *u8 as s = &row[x * chans * step];
            if (chans >= 3) {
                dst[x * 4] = s[hi];
                dst[x * 4 + 1] = s[step + hi];
                dst[x * 4 + 2] = s[step * 2 + hi];
            } else {
                dst[x * 4] = s[hi];
                dst[x * 4 + 1] = s[hi];
                dst[x * 4 + 2] = s[hi];
            }
            if (chans == 4) { dst[x * 4 + 3] = s[step * 3 + hi]; }
            else if (chans == 2) { dst[x * 4 + 3] = s[step + hi]; }
            else { dst[x * 4 + 3] = cast(u8, 255); }
            x = x + 1;
        }
        y = y + 1;
    }
    cimg.image_free(&src);
    im.pixels = out;
    im.width = w;
    im.height = h;
    im.tex = 0;
    im.nat_w = cast(f64, w);
    im.nat_h = cast(f64, h);
    im.sized = 1;
    im.keeps_shape = 0;
    im.mask_tex = 0;
    return 1;
}

fn free(im as *dl.Image) as void {
    if (cast(i64, im.anim) != 0) {
        gif.gif_anim_free(cast(*gif.GifAnim, im.anim));
        mem.core.munmap(im.anim, sizeof(gif.GifAnim));
        im.anim = cast(*u8, 0);
        im.pixels = cast(*u8, 0);
        return;
    }
    if (im.pixels != null) { mem.core.munmap(im.pixels, im.width * im.height * 4); }
    im.pixels = cast(*u8, 0);
}
