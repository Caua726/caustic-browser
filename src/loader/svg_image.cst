// loader/svg_image.cst — an SVG file as a picture, for <img> and for CSS.
//
// An <svg> in a page is drawn at whatever size its box comes to. A file is parsed once,
// its rules applied to it alone, and drawn here to pixels the page then treats like those
// of any other image. It knows nothing of the page it is in, as a browser's image must not.

use "../base/arena.cst" as arena;
use "../css/decl.cst" as decl;
use "../css/sheet.cst" as sh;
use "../css/style.cst" as style;
use "../dom/dom.cst" as dom;
use "../html/tree.cst" as tree;
use "../paint/display_list.cst" as dl;
use "../paint/svg.cst" as svg;
use "std/mem.cst" as mem;

// A CSS size for a file that gives no size of its own at all.
let is f64 as PLAIN_W with imut = 300.0;
let is f64 as PLAIN_H with imut = 150.0;
// Drawn at twice its size, at least this big, so a small one can be shown large and stay
// sharp enough; and at most this big, so a big one is not a fortune in memory.
let is f64 as MIN_SIDE with imut = 256.0;
let is f64 as MAX_SIDE with imut = 2048.0;

fn _is_ws(c as i64) as i64 { return cast(i64, c == 32 || c == 9 || c == 10 || c == 13 || c == 12); }

// 1 when the bytes open as markup holding an <svg> soon enough to be one.
fn looks_like(s as *u8, n as i64) as i64 {
    let is i64 as i with mut = 0;
    if (n >= 3 && cast(i64, s[0]) == 239 && cast(i64, s[1]) == 187 && cast(i64, s[2]) == 191) { i = 3; }
    while (i < n && _is_ws(cast(i64, s[i])) == 1) { i = i + 1; }
    if (i >= n || s[i] != 60) { return 0; }
    let is i64 as most with mut = i + 8192;
    if (most > n - 5) { most = n - 5; }
    while (i < most) {
        if (s[i] == 60 && decl.eq(&s[i + 1], 3, "svg") == 1) {
            let is i64 as c = cast(i64, s[i + 4]);
            if (_is_ws(c) == 1 || c == 62 || c == 47) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

// A length as CSS pixels, or below 0 for what is no length here: a percentage has nothing
// to be a percentage of, for a file.
fn _length(a as *dom.Attr) as f64 {
    if (a == null || a.value_len == 0) { return 0.0 - 1.0; }
    let is *u8 as s = a.value;
    let is i64 as n = a.value_len;
    let is i64 as i with mut = 0;
    let is f64 as v with mut = 0.0;
    let is i64 as digits with mut = 0;
    while (i < n && s[i] >= 48 && s[i] <= 57) {
        v = v * 10.0 + cast(f64, cast(i64, s[i]) - 48);
        i = i + 1;
        digits = digits + 1;
    }
    if (i < n && s[i] == 46) {
        i = i + 1;
        let is f64 as place with mut = 0.1;
        while (i < n && s[i] >= 48 && s[i] <= 57) {
            v = v + cast(f64, cast(i64, s[i]) - 48) * place;
            place = place * 0.1;
            i = i + 1;
            digits = digits + 1;
        }
    }
    if (digits == 0 || v <= 0.0) { return 0.0 - 1.0; }
    let is i64 as left = n - i;
    if (left == 0 || decl.eq(&s[i], left, "px") == 1) { return v; }
    if (decl.eq(&s[i], left, "pt") == 1) { return v * 96.0 / 72.0; }
    if (decl.eq(&s[i], left, "pc") == 1) { return v * 16.0; }
    if (decl.eq(&s[i], left, "in") == 1) { return v * 96.0; }
    if (decl.eq(&s[i], left, "cm") == 1) { return v * 96.0 / 2.54; }
    if (decl.eq(&s[i], left, "mm") == 1) { return v * 96.0 / 25.4; }
    if (decl.eq(&s[i], left, "em") == 1) { return v * 16.0; }
    return 0.0 - 1.0;
}

// The third and fourth numbers of a viewBox, or 0 when it has not got them.
fn _view_size(a as *dom.Attr, w as *f64, h as *f64) as i64 {
    if (a == null) { return 0; }
    let is *u8 as s = a.value;
    let is i64 as i with mut = 0;
    let is i64 as k with mut = 0;
    let is [4]f64 as nums with mut;
    while (k < 4) {
        while (i < a.value_len && (_is_ws(cast(i64, s[i])) == 1 || s[i] == 44)) { i = i + 1; }
        let is f64 as sign with mut = 1.0;
        if (i < a.value_len && s[i] == 45) {
            sign = 0.0 - 1.0;
            i = i + 1;
        }
        let is i64 as from = i;
        let is f64 as v with mut = 0.0;
        while (i < a.value_len && s[i] >= 48 && s[i] <= 57) {
            v = v * 10.0 + cast(f64, cast(i64, s[i]) - 48);
            i = i + 1;
        }
        if (i < a.value_len && s[i] == 46) {
            i = i + 1;
            let is f64 as place with mut = 0.1;
            while (i < a.value_len && s[i] >= 48 && s[i] <= 57) {
                v = v + cast(f64, cast(i64, s[i]) - 48) * place;
                place = place * 0.1;
                i = i + 1;
            }
        }
        if (i == from) { return 0; }
        nums[k] = v * sign;
        k = k + 1;
    }
    if (nums[2] <= 0.0 || nums[3] <= 0.0) { return 0; }
    *w = nums[2];
    *h = nums[3];
    return 1;
}

// A number the way a viewBox wants it, into out. Two decimals are finer than any pixel.
fn _put_num(v as f64, out as *u8, at as i64) as i64 {
    let is i64 as hundredths = cast(i64, v * 100.0 + 0.5);
    let is [24]u8 as rev with mut;
    let is i64 as n with mut = 0;
    let is i64 as left with mut = hundredths / 100;
    if (left == 0) {
        rev[0] = cast(u8, 48);
        n = 1;
    }
    while (left > 0 && n < 20) {
        rev[n] = cast(u8, 48 + left % 10);
        left = left / 10;
        n = n + 1;
    }
    let is i64 as w with mut = at;
    while (n > 0) {
        n = n - 1;
        out[w] = rev[n];
        w = w + 1;
    }
    out[w] = cast(u8, 46);
    out[w + 1] = cast(u8, 48 + (hundredths / 10) % 10);
    out[w + 2] = cast(u8, 48 + hundredths % 10);
    return w + 3;
}

fn _next_element(root as *dom.Node, n as *dom.Node) as *dom.Node {
    let is *dom.Node as x with mut = n;
    while (1 == 1) {
        if (x.first != null) {
            x = x.first;
        } else {
            while (x != root && x.next == null) { x = x.parent; }
            if (x == root) { return cast(*dom.Node, 0); }
            x = x.next;
        }
        if (x.kind == dom.ELEMENT) { return x; }
    }
    return cast(*dom.Node, 0);
}

// Each <style> in the file, as a sheet for it alone.
fn _sheets(e as *style.Engine, a as *arena.Arena, root as *dom.Node) as void {
    let is *dom.Node as x with mut = _next_element(root, root);
    while (x != null) {
        if (decl.eq(x.name, x.name_len, "style") == 1) {
            let is i64 as cap with mut = 1;
            let is *dom.Node as t with mut = x.first;
            while (t != null) {
                if (t.kind == dom.TEXT) { cap = cap + t.text_len; }
                t = t.next;
            }
            let is *u8 as src = arena.alloc(a, cap);
            let is i64 as w with mut = 0;
            t = x.first;
            while (t != null) {
                if (t.kind == dom.TEXT) {
                    mem.core.memcpy(&src[w], t.text, t.text_len);
                    w = w + t.text_len;
                }
                t = t.next;
            }
            let is *sh.Sheet as s = cast(*sh.Sheet, arena.alloc(a, sizeof(sh.Sheet)));
            sh.init(s, a);
            sh.parse(s, src, w, sh.ORIGIN_AUTHOR, "");
            style.add_sheet(e, s);
        }
        x = _next_element(root, x);
    }
}

// What a picture's edge can be drawn from: the colours as they are, not multiplied by
// how much shows, which is how page_view takes any other image.
fn _straighten(px as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as a = cast(i64, px[i * 4 + 3]);
        if (a > 0 && a < 255) {
            let is i64 as k with mut = 0;
            while (k < 3) {
                let is i64 as v = (cast(i64, px[i * 4 + k]) * 255 + a / 2) / a;
                if (v > 255) { px[i * 4 + k] = cast(u8, 255); }
                else { px[i * 4 + k] = cast(u8, v); }
                k = k + 1;
            }
        }
        i = i + 1;
    }
}

// len bytes into im. 1, or 0 when they are not a picture this can draw.
fn decode(data as *u8, len as i64, im as *dl.Image) as i64 {
    if (looks_like(data, len) == 0) { return 0; }
    let is dom.Document as doc with mut;
    let is arena.Arena as docs_a with mut;
    let is arena.Arena as style_a with mut;
    dom.init(&doc);
    arena.init(&docs_a);
    arena.init(&style_a);
    let is i64 as ok with mut = 0;
    let is *dom.Node as root with mut = cast(*dom.Node, 0);
    if (tree.parse(&doc, data, len) == 0) {
        let is *dom.Node as x with mut = _next_element(doc.node, doc.node);
        while (x != null && root == null) {
            if (x.ns == dom.NS_SVG) { root = x; }
            x = _next_element(doc.node, x);
        }
    }
    if (root != null) {
        // Its size: both as asked; one and the shape of its view; or the view's shape alone.
        let is f64 as vw with mut = 0.0;
        let is f64 as vh with mut = 0.0;
        let is *dom.Attr as vb = dom.find_attr(root, "viewBox", 7);
        let is i64 as has_view = _view_size(vb, &vw, &vh);
        let is f64 as w with mut = _length(dom.find_attr(root, "width", 5));
        let is f64 as h with mut = _length(dom.find_attr(root, "height", 6));
        let is i64 as sized with mut = 1;
        let is *dom.Attr as par = dom.find_attr(root, "preserveAspectRatio", 19);
        let is i64 as keeps = cast(i64, par == null || par.value_len < 4 || decl.eq(par.value, 4, "none") == 0);
        if (w <= 0.0 && h <= 0.0) {
            if (has_view == 1) {
                sized = 0;
                w = PLAIN_W;
                h = PLAIN_W * vh / vw;
            } else {
                w = PLAIN_W;
                h = PLAIN_H;
            }
        } else if (w <= 0.0) {
            w = PLAIN_W;
            if (has_view == 1) { w = h * vw / vh; }
        } else if (h <= 0.0) {
            h = PLAIN_H;
            if (has_view == 1) { h = w * vh / vw; }
        }
        // With no view of its own, a file's units are its pixels at its size.
        if (has_view == 0) {
            let is [80]u8 as words with mut;
            words[0] = cast(u8, 48);
            words[1] = cast(u8, 32);
            words[2] = cast(u8, 48);
            words[3] = cast(u8, 32);
            let is i64 as at with mut = _put_num(w, cast(*u8, &words), 4);
            words[at] = cast(u8, 32);
            at = _put_num(h, cast(*u8, &words), at + 1);
            dom.add_attr(&doc, root, dom.ATTR_PLAIN, "viewBox", 7, cast(*u8, &words), at);
        }
        let is f64 as side with mut = w;
        if (h > w) { side = h; }
        let is f64 as k with mut = 2.0;
        if (side * k < MIN_SIDE) { k = MIN_SIDE / side; }
        if (side * k > MAX_SIDE) { k = MAX_SIDE / side; }
        let is i64 as pw = cast(i64, w * k + 0.999);
        let is i64 as ph = cast(i64, h * k + 0.999);
        let is *u8 as px = mem.core.mmap_anon(pw * ph * 4);
        let is i64 as got = cast(i64, px);
        if (pw > 0 && ph > 0 && got != 0 && got != 0 - 1) {
            // The file's own rules, kept from the page's: this cascade runs in the middle
            // of the page's load, and the one thing the parser remembers is put back.
            let is i64 as saw = decl.saw_viewport;
            let is *style.Engine as e = cast(*style.Engine, arena.alloc(&docs_a, sizeof(style.Engine)));
            style.init(e, &style_a, &docs_a, "");
            _sheets(e, &docs_a, doc.node);
            style.style_document(e, &doc, cast(f64, pw), cast(f64, ph));
            decl.saw_viewport = saw;
            svg.render(cast(*u8, root), pw, ph, 4278190080, px);
            _straighten(px, pw * ph);
            im.pixels = px;
            im.width = pw;
            im.height = ph;
            im.nat_w = w;
            im.nat_h = h;
            im.sized = sized;
            im.keeps_shape = keeps;
            im.mask_tex = 0;
            im.anim = cast(*u8, 0);
            im.frame = 0;
            im.frame_due = 0;
            im.frame_up = 0;
            im.moved = 0;
            im.tex = 0;
            ok = 1;
        }
    }
    arena.free(&docs_a);
    arena.free(&style_a);
    dom.free(&doc);
    return ok;
}
