}
// Frames, as the page knows them.
let is *u8 as frame_fn with mut = cast(*u8, 0);
fn h_frame(op as i64, a as i64) as i64 {
    if (cast(i64, frame_fn) == 0) { return 0; }
    return call(frame_fn, owner, op, a);
}
// A script element's text, for its page's runtime. ok: 0 it could not be had, 1 fetched, 2 inline.
fn script(d as *dom.Document, f as i64, text as *u8, n as i64, node as *dom.Node, ok as i64) as void {
    if (f == 0) { return; }
    cur_doc = d;
    call(cast(*u8, f), cast(i64, text), n, cast(i64, node), ok);
}
fn message(d as *dom.Document, f as i64, text as *u8, n as i64, origin as *u8, from as i64) as void {
    if (f == 0) { return; }
    cur_doc = d;
    call(cast(*u8, f), cast(i64, text), n, cast(i64, origin), from);
}
fn h_nav(u as i64, n as i64, replace as i64) as i64 {
    if (n > 4095) { return 0; }
