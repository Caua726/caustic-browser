    return call(fetch_fn, owner, info);
}
let is *dom.Node as focused with mut = cast(*dom.Node, 0);
let is *dom.Node as focus_asked with mut = cast(*dom.Node, 0);
let is *u8 as focus_owner with mut = cast(*u8, 0);
fn h_state(op as i64, node as i64) as i64 {
    if (op == 0) { return cast(i64, focused); }
    if (focused != null) { focused.flags = focused.flags & (~dom.FLAG_FOCUS); }
    focused = cast(*dom.Node, node);
    // A script gave it the focus: the browser opens what typing needs when the page can show it.
    focus_asked = focused;
    focus_owner = owner;
    if (focused != null) { focused.flags = focused.flags | dom.FLAG_FOCUS; }
    dirty = 1;
    return 0;
}
fn _table() as void {
    if (table_ready == 1) { return; }
    table[1] = cast(i64, fn_ptr(h_query));
    table[2] = cast(i64, fn_ptr(h_query_all));
    table[3] = cast(i64, fn_ptr(h_set_html));
    table[4] = cast(i64, fn_ptr(h_set_text));
    table[5] = cast(i64, fn_ptr(h_get_text));
    table[6] = cast(i64, fn_ptr(h_get_attr));
    table[7] = cast(i64, fn_ptr(h_set_attr));
    table[8] = cast(i64, fn_ptr(h_create));
    table[9] = cast(i64, fn_ptr(h_append));
    table[10] = cast(i64, fn_ptr(h_tag));
    table[11] = cast(i64, fn_ptr(h_root));
    table[12] = cast(i64, fn_ptr(h_parent));
    table[13] = cast(i64, fn_ptr(h_remove));
    table[14] = cast(i64, fn_ptr(h_link));
    table[15] = cast(i64, fn_ptr(h_kind));
    table[16] = cast(i64, fn_ptr(h_text_node));
    table[17] = cast(i64, fn_ptr(h_insert));
    table[18] = cast(i64, fn_ptr(h_del_attr));
    table[19] = cast(i64, fn_ptr(h_get_html));
    table[20] = cast(i64, fn_ptr(h_clone));
    table[21] = cast(i64, fn_ptr(h_ns));
    table[22] = cast(i64, fn_ptr(h_create_ns));
    table[23] = cast(i64, fn_ptr(h_set_data));
    table[24] = cast(i64, fn_ptr(h_computed));
    table[31] = cast(i64, fn_ptr(h_fetch));
    table[25] = cast(i64, fn_ptr(h_url));
    table[26] = cast(i64, fn_ptr(h_viewport));
    table[27] = cast(i64, fn_ptr(h_rect));
    table[28] = cast(i64, fn_ptr(h_fragment));
    table[29] = cast(i64, fn_ptr(h_comment));
    table[30] = cast(i64, fn_ptr(h_state));
    table[32] = cast(i64, fn_ptr(h_eval));
    table[33] = cast(i64, fn_ptr(h_cookie));
    table[34] = cast(i64, fn_ptr(h_nav));
    table[35] = cast(i64, fn_ptr(h_frame));
    table[36] = cast(i64, fn_ptr(h_attr));
    table[37] = cast(i64, fn_ptr(h_submit));
    table[38] = cast(i64, fn_ptr(h_by_id));
    table[39] = cast(i64, fn_ptr(h_img));
    table[40] = cast(i64, fn_ptr(h_area));
