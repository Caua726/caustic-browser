// ── Files ──
fn _read_all(path as *u8, out_n as *i64) as *u8 {
    let is i64 as fd = syscall(2, path, 0, 0);
    if (fd < 0) { return cast(*u8, 0); }
    let is i64 as sz = syscall(8, fd, 0, 2);
    syscall(8, fd, 0, 0);
    let is *u8 as b = cast(*u8, syscall(9, 0, sz + 1, 3, 34, -1, 0));
    let is i64 as got with mut = 0;
    while (got < sz) {
        let is i64 as r = syscall(0, fd, cast(i64, b) + got, sz - got);
        if (r <= 0) { break; }
        got = got + r;
    }
    syscall(3, fd);
    *out_n = got;
    return b;
}
fn _write_all(fd as i64, p as *u8, n as i64) as void {
    let is i64 as off with mut = 0;
    while (off < n) {
        let is i64 as r = syscall(1, fd, cast(i64, p) + off, n - off);
        if (r <= 0) { return; }
        off = off + r;
    }
}
fn _cat(to as *u8, at as i64, s as *u8) as i64 {
    let is i64 as i with mut = 0;
    let is i64 as a with mut = at;
    while (cast(i64, s[i]) != 0) { to[a] = s[i]; a = a + 1; i = i + 1; }
    to[a] = cast(u8, 0);
    return a;
}
fn _itoa(to as *u8, at as i64, v as i64) as i64 {
    let is [24]u8 as b;
    let is i64 as p with mut = 23;
    let is i64 as x with mut = v;
    b[p] = cast(u8, 0);
    if (x == 0) { p = p - 1; b[p] = cast(u8, 48); }
    while (x > 0) { p = p - 1; b[p] = cast(u8, 48 + x % 10); x = x / 10; }
    return _cat(to, at, cast(*u8, cast(i64, &b) + p));
}
// The sources sit next to the build: <checkout>/build/browser and <checkout>/build/motor.
fn _checkout(to as *u8) as i64 {
    let is i64 as n = syscall(89, "/proc/self/exe", to, 3000);
    if (n <= 0) { return 0; }
    let is i64 as i with mut = n;
    let is i64 as slashes with mut = 0;
    while (i > 0 && slashes < 2) { i = i - 1; if (cast(i64, to[i]) == 47) { slashes = slashes + 1; } }
    to[i] = cast(u8, 0);
    return i;
}
// <checkout>/build/motor/cache, made if it has to be.
fn _cache_dir(to as *u8) as i64 {
    let is i64 as n = _checkout(to);
    if (n == 0) { return 0; }
    let is i64 as a = _cat(to, n, "/build/motor/cache");
    syscall(83, to, 448);
    return a;
}
fn _us(label as *u8, v as i64) as void {
    let is [64]u8 as b;
    let is i64 as a with mut = _cat(cast(*u8, &b), 0, label);
    a = _itoa(cast(*u8, &b), a, v / 1000);
    a = _cat(cast(*u8, &b), a, ".");
    let is i64 as frac = (v % 1000) / 100;
    a = _itoa(cast(*u8, &b), a, frac);
    a = _cat(cast(*u8, &b), a, " ms");
    syscall(1, 2, &b, a);
}

// The compiler, in this process: a clean copy of its image for each use, the files it needs
// from what is packed into this program, and all its memory given back after.
fn _compile(bundle as *u8, text as *u8, n as i64, opt as *u8, out as *u8, link_to as *u8) as i32 {
    let is i64 as csl_n with mut = 0;
    let is *u8 as bytes = pack.find(bundle, "caustic.csl", &csl_n);
    if (cast(i64, bytes) == 0) { io.write_str(2, "js: no compiler in the pack\n"); return 1; }
    let is image.Image as im with mut;
    if (image.open(bytes, csl_n, &im) == 0) { io.write_str(2, "js: compiler image not loaded\n"); return 1; }
    let is *u8 as add = image.resolve(&im, "motor_add_file");
    let is *u8 as run = image.resolve(&im, "motor_compile");
    let is *u8 as done = image.resolve(&im, "motor_done");
    if (cast(i64, add) == 0 || cast(i64, run) == 0 || cast(i64, done) == 0) { io.write_str(2, "js: compiler entry not found\n"); image.close(&im); return 1; }
    if (env.getenv("CAUSTIC_JS_LOUD") != null) {
        let is *u8 as loud = image.resolve(&im, "motor_loud");
        if (cast(i64, loud) != 0) { call(loud); }
    }
    pack.each_std(bundle, add);
    call(add, cast(i64, "/motor/page.cst"), cast(i64, text), n);
    let is [11]*u8 as av;
    av[0] = "caustic"; av[1] = "-q"; av[2] = opt; av[3] = "--target=caustic-x86_64";
    av[4] = "--shared"; av[5] = "--mode=pure"; av[6] = "/motor/page.cst"; av[7] = "-o"; av[8] = out;
    // For an eval: an object, whose runtime is the page's, already loaded.
    if (cast(i64, link_to) != 0) {
        av[4] = "-c";
        let is *u8 as lk = image.resolve(&im, "motor_link_to");
        if (cast(i64, lk) != 0) { call(lk, cast(i64, link_to)); }
    }
    av[9] = cast(*u8, 0);
    av[10] = cast(*u8, 0);
    let is [4096]u8 as obj;
    let is i64 as ol with mut = 0;
    while (out[ol] != 0 && ol < 4090) { obj[ol] = out[ol]; ol = ol + 1; }
    obj[ol] = 46; obj[ol + 1] = 111; obj[ol + 2] = 0;
    let is *u8 as op = image.resolve(&im, "motor_obj_path");
    if (cast(i64, op) != 0) { call(op, cast(i64, &obj)); }
    let is i64 as rc = call(run, 9, cast(i64, &av));
    call(done);
    syscall(87, cast(i64, &obj));
    image.close(&im);
    return cast(i32, rc);
}

// The pages' images, for an eval to be linked to the one that asked for it.
struct LoadedPage { im as image.Image; path as [640]u8; room as [2]i64; }
let is [64]LoadedPage as loaded with mut;
let is i64 as loaded_n with mut = 0;
// A page's image, from its file. Its bytes stay: the export table is read from them.
fn _page_load(path as *u8) as *LoadedPage {
    let is i64 as fd = syscall(2, path, 0, 0);
    if (fd < 0) { return cast(*LoadedPage, 0); }
    let is i64 as size = syscall(8, fd, 0, 2);
    syscall(8, fd, 0, 0);
    let is *u8 as f = cast(*u8, syscall(9, 0, size + 1, 3, 34, -1, 0));
    let is i64 as got with mut = 0;
    while (got < size) {
        let is i64 as r = syscall(0, fd, cast(i64, f) + got, size - got);
        if (r <= 0) { break; }
        got = got + r;
    }
    syscall(3, fd);
    let is *LoadedPage as lp = &loaded[loaded_n % 64];
    if (got < size || image.open_in(f, size, &lp.im, cast(*i64, &lp.room)) == 0) { return cast(*LoadedPage, 0); }
    let is i64 as i with mut = 0;
    while (path[i] != 0) { lp.path[i] = path[i]; i = i + 1; }
    lp.path[i] = 0;
    loaded_n = loaded_n + 1;
    return lp;
}
fn _page_of(addr as i64) as *LoadedPage {
    let is *LoadedPage as best with mut = cast(*LoadedPage, 0);
    let is i64 as i with mut = 0;
    let is i64 as n with mut = loaded_n;
    if (n > 64) { n = 64; }
    while (i < n) {
        let is *LoadedPage as lp = &loaded[i];
        if (lp.im.base <= addr && (cast(i64, best) == 0 || lp.im.base > best.im.base)) { best = lp; }
        i = i + 1;
    }
    return best;
}
struct EvalDone { page as i64; hash as i64; strs as i64; roots as i64; names as i64; top as i64; }
let is [1024]EvalDone as evals with mut;
let is i64 as evals_n with mut = 0;
let is [512]u8 as eval_error with mut;
fn _eval_error(s as *u8) as void {
    let is i64 as i with mut = 0;
    while (s[i] != 0 && i < 511) { eval_error[i] = s[i]; i = i + 1; }
    eval_error[i] = 0;
}
// On the stack h_eval made for it. info: text, length, an address in the asking page; then, on
// the way out, the module's four functions, or the error text; and 1 if it has not run before.
fn _eval_work(info as *i64) as i64 {
    let is *u8 as source = cast(*u8, info[0]);
    let is i64 as n = info[1];
    let is *LoadedPage as lp = _page_of(info[2]);
    if (cast(i64, lp) == 0) { return 0; }
    let is *u8 as bundle = embed.start();
    let is i64 as rn with mut = 0;
    let is *u8 as rt = pack.find(bundle, "rt.cst", &rn);
    let is i64 as h with mut = 7809847782465536322;
    let is i64 as i with mut = 0;
    while (i < n) { h = (h ^ cast(i64, source[i])) * 1099511628211; i = i + 1; }
    let is [18]i64 as st with mut;
    if (syscall(4, "/proc/self/exe", &st) == 0) { h = (h ^ st[11]) * 1099511628211; h = (h ^ st[12]) * 1099511628211; }
    h = h + jsc.trace_calls;
    i = 0;
    while (i < evals_n) {
        let is *EvalDone as ed = &evals[i];
        if (ed.page == lp.im.base && ed.hash == h) {
            info[3] = ed.strs; info[4] = ed.roots; info[5] = ed.names; info[6] = ed.top; info[7] = 0;
            return 1;
        }
        i = i + 1;
    }
    if (evals_n >= 1024) { return 0; }
    let is [512]u8 as cache;
    if (_cache_dir(cast(*u8, &cache)) == 0) { return 0; }
    let is [640]u8 as obj;
    let is i64 as a with mut = _cat(cast(*u8, &obj), 0, cast(*u8, &cache));
    a = _cat(cast(*u8, &obj), a, "/e");
    let is i64 as bit with mut = 0;
    while (bit < 16) {
        let is i64 as nib = (h >> (bit * 4)) & 15;
        if (nib < 10) { obj[a] = cast(u8, 48 + nib); } else { obj[a] = cast(u8, 87 + nib); }
        a = a + 1;
        bit = bit + 1;
    }
    _cat(cast(*u8, &obj), a, ".o");
    if (syscall(21, &obj, 4) != 0) {
        let is i64 as gn with mut = 0;
        let is *u8 as gtext = jsc.translate_eval(source, n, &gn);
        if (cast(i64, gtext) == 0) {
            _eval_error(jsc.last_error());
            info[3] = cast(i64, &eval_error);
            jsc.release();
            return 0;
        }
        // A very big script is rarely hot all over, and the wait for it is the first thing seen.
        let is *u8 as eval_opt with mut = "-O1";
        if (n > 262144) { eval_opt = "-O0"; }
        let is [700]u8 as tmp;
        let is i64 as ta with mut = _cat(cast(*u8, &tmp), 0, cast(*u8, &obj));
        ta = _cat(cast(*u8, &tmp), ta, ".building-");
        ta = _itoa(cast(*u8, &tmp), ta, syscall(39));
        let is *u8 as text = cast(*u8, syscall(9, 0, rn + gn + 1, 3, 34, -1, 0));
        i = 0;
        while (i < rn) { text[i] = rt[i]; i = i + 1; }
        i = 0;
        while (i < gn) { text[rn + i] = gtext[i]; i = i + 1; }
        jsc.release();
        let is i32 as rc = _compile(bundle, text, rn + gn, eval_opt, cast(*u8, &tmp), cast(*u8, &lp.path));
        syscall(11, text, rn + gn + 1);
        if (rc != 0) { io.write_str(2, "js: eval: the compiler refused the text\n"); return 0; }
        // The target names what it writes this way, even an object.
        _cat(cast(*u8, &tmp), ta, ".cse");
        syscall(82, &tmp, &obj);
    }
    let is i64 as fd = syscall(2, &obj, 0, 0);
    if (fd < 0) { return 0; }
    let is i64 as size = syscall(8, fd, 0, 2);
    syscall(8, fd, 0, 0);
    let is *u8 as f = cast(*u8, syscall(9, 0, size + 1, 3, 34, -1, 0));
    let is i64 as got with mut = 0;
    while (got < size) {
        let is i64 as r = syscall(0, fd, cast(i64, f) + got, size - got);
        if (r <= 0) { break; }
        got = got + r;
    }
    syscall(3, fd);
    let is image.Linked as l with mut;
    let is i64 as ok = image.link_object(f, size, &lp.im, cast(*i64, &lp.room), &l);
    if (ok == 0) { io.write_str(2, "js: eval: could not link\n"); syscall(11, f, size + 1); return 0; }
    let is *EvalDone as ed = &evals[evals_n];
    ed.page = lp.im.base; ed.hash = h;
    ed.strs = cast(i64, image.linked_sym(&l, "js_strs"));
    ed.roots = cast(i64, image.linked_sym(&l, "js_gc_roots"));
    ed.names = cast(i64, image.linked_sym(&l, "js_names"));
    ed.top = cast(i64, image.linked_sym(&l, "js_top"));
    syscall(11, f, size + 1);
    if (ed.strs == 0 || ed.roots == 0 || ed.names == 0 || ed.top == 0) { return 0; }
    evals_n = evals_n + 1;
    info[3] = ed.strs; info[4] = ed.roots; info[5] = ed.names; info[6] = ed.top; info[7] = 1;
    return 1;
}
fn _stack_call(f as *u8, arg as i64, top as i64) as i64 with naked {
    asm("push rbp\nmov rbp, rsp\nmov rsp, rdx\nmov rax, rdi\nmov rdi, rsi\ncall rax\nmov rsp, rbp\npop rbp\nret\n");
}
// A script may call eval from a generator's small stack, and the compiler recurses deeply: all
// of this runs on a stack of its own, with a stack limit that does not get in its way.
fn h_eval(info as *i64) as i64 {
    let is i64 as size = 67108864;
    let is i64 as st = syscall(9, 0, size, 3, 34 + 16384, -1, 0);
    if (st <= 0) { return 0; }
    let is [64]i64 as tls;
    let is i64 as z with mut = 0;
    while (z < 64) { tls[z] = 0; z = z + 1; }
    let is i64 as old_fs with mut = 0;
    syscall(158, 4099, &old_fs);
    syscall(158, 4098, &tls);
    let is i64 as r = _stack_call(cast(*u8, fn_ptr(_eval_work)), cast(i64, info), st + size - 64);
    syscall(158, 4098, old_fs);
    syscall(11, st, size);
    return r;
}

// Runs the page's script text. The function to call for events, or 0.
fn run(d as *dom.Document, source as *u8, n as i64) as i64 {
    _table();
    cur_doc = d;
    let is i64 as t0 = _now_us();
    let is *u8 as bundle = embed.start();
    let is i64 as rn with mut = 0;
    let is *u8 as rt = pack.find(bundle, "rt.cst", &rn);
    let is i64 as pn with mut = 0;
    let is *u8 as prelude = pack.find(bundle, "prelude.js", &pn);
    if (cast(i64, rt) == 0 || cast(i64, prelude) == 0) { io.write_str(2, "js: the runtime is not in this program\n"); return 0; }

    let is *u8 as all = cast(*u8, syscall(9, 0, pn + n + 1, 3, 34, -1, 0));
    let is i64 as i with mut = 0;
    while (i < pn) { all[i] = prelude[i]; i = i + 1; }
    i = 0;
    while (i < n) { all[pn + i] = source[i]; i = i + 1; }
    let is *u8 as optv = env.getenv("CAUSTIC_JS_OPT");
    let is *u8 as opt with mut = "-O1";
    if (optv != null && optv[0] != 0) { opt = optv; }
    // The same page's image is the same image: kept by what went into it, and the translation
    // is not needed at all once it exists. The program's own time says which translator it was.
    let is i64 as h with mut = -3750763034362895579;
    i = 0;
    while (i < rn) { h = (h ^ cast(i64, rt[i])) * 1099511628211; i = i + 1; }
    i = 0;
    while (i < pn + n) { h = (h ^ cast(i64, all[i])) * 1099511628211; i = i + 1; }
    i = 0;
    while (opt[i] != 0) { h = (h ^ cast(i64, opt[i])) * 1099511628211; i = i + 1; }
    let is [18]i64 as st with mut;
    if (syscall(4, "/proc/self/exe", &st) == 0) { h = (h ^ st[11]) * 1099511628211; h = (h ^ st[12]) * 1099511628211; }
    jsc.trace_calls = cast(i64, env.getenv("CAUSTIC_JS_TRACE") != null);
    h = h + jsc.trace_calls;
    let is i64 as t1 with mut = _now_us();
    let is [512]u8 as cache;
    let is i64 as cn = _cache_dir(cast(*u8, &cache));
    if (cn == 0) { jsc.release(); return 0; }
    let is [640]u8 as lib;
    let is i64 as a with mut = _cat(cast(*u8, &lib), 0, cast(*u8, &cache));
    a = _cat(cast(*u8, &lib), a, "/");
    let is i64 as bit with mut = 0;
    while (bit < 16) {
        let is i64 as nib = (h >> (bit * 4)) & 15;
        if (nib < 10) { lib[a] = cast(u8, 48 + nib); } else { lib[a] = cast(u8, 87 + nib); }
        a = a + 1;
        bit = bit + 1;
    }
    _cat(cast(*u8, &lib), a, ".csl");
    let is i64 as have = syscall(21, &lib, 4);
    if (have != 0) {
        let is i64 as gn with mut = 0;
        let is *u8 as gtext = jsc.translate(all, pn + n, &gn);
        if (cast(i64, gtext) == 0) {
            io.write_str(2, "js: not run: ");
            io.write_str(2, jsc.last_error());
            io.write_str(2, "\n");
            jsc.release();
            return 0;
        }
        t1 = _now_us();
        runs = runs + 1;
        let is [700]u8 as tmp;
        let is i64 as ta with mut = _cat(cast(*u8, &tmp), 0, cast(*u8, &lib));
        ta = _cat(cast(*u8, &tmp), ta, ".building-");
        ta = _itoa(cast(*u8, &tmp), ta, syscall(39));
        let is *u8 as text = cast(*u8, syscall(9, 0, rn + gn + 1, 3, 34, -1, 0));
        i = 0;
        while (i < rn) { text[i] = rt[i]; i = i + 1; }
        i = 0;
        while (i < gn) { text[rn + i] = gtext[i]; i = i + 1; }
        jsc.release();
        let is i32 as rc = _compile(bundle, text, rn + gn, opt, cast(*u8, &tmp), cast(*u8, 0));
        syscall(11, text, rn + gn + 1);
        if (rc != 0) { io.write_str(2, "js: the compiler refused the generated text\n"); return 0; }
        syscall(82, &tmp, &lib);
    }
    let is i64 as t2 = _now_us();

    // Images are not closed: a tab may still be running one.
    let is *LoadedPage as lp = _page_load(cast(*u8, &lib));
    if (cast(i64, lp) == 0) { io.write_str(2, "js: could not load the image\n"); return 0; }
    let is i64 as entry = cast(i64, image.resolve(&lp.im, "js_main"));
    let is i64 as disp = cast(i64, image.resolve(&lp.im, "js_dispatch"));
    last_next = cast(i64, image.resolve(&lp.im, "js_next_timer"));
    last_tick = cast(i64, image.resolve(&lp.im, "js_tick"));
    last_done = cast(i64, image.resolve(&lp.im, "js_fetch_done"));
    last_msg = cast(i64, image.resolve(&lp.im, "js_message"));
    last_script = cast(i64, image.resolve(&lp.im, "js_run_script"));
    if (entry == 0) { return 0; }
    let is i64 as t3 = _now_us();
    dirty = 1;
    call(cast(*u8, entry), cast(i64, &table));
    let is i64 as t4 = _now_us();
    _us("js: translate ", t1 - t0);
    _us(", compile ", t2 - t1);
    _us(", load ", t3 - t2);
    _us(", run ", t4 - t3);
    syscall(1, 2, "\n", 1);
    return disp;
}

// A kind of event at a node, for that page's scripts. 1 when a listener ran, 2 more when
// the default was stopped.
fn fire(d as *dom.Document, disp as i64, node as *dom.Node, type_s as *u8, tn as i64, info as *i64) as i64 {
    if (disp == 0) { return 0; }
    cur_doc = d;
    return call(cast(*u8, disp), cast(i64, node), cast(i64, type_s), tn, cast(i64, info));
}
fn deliver(d as *dom.Document, done as i64, id as i64, status as i64, data as *u8, n as i64, ctype as *u8) as void {
    if (done == 0) { return; }
    cur_doc = d;
    call(cast(*u8, done), id, status, cast(i64, data), n, cast(i64, ctype));
}

// When its next timer is due, in ms, or -1.
fn next_timer(f as i64) as i64 {
    if (f == 0) { return -1; }
    return call(cast(*u8, f));
}
fn tick(d as *dom.Document, f as i64) as void {
    if (f == 0) { return; }
    cur_doc = d;
    call(cast(*u8, f));
}
