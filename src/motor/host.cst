// A page's scripts, from text to running: JS to Caustic text (jsc.cst), the compiler to
// a .csl, the loader into this process, then the script calls back through a table of
// these functions, which do what it asks to the document.
use "embed.cst" as embed;
use "pack.cst" as pack;
use "image.cst" as image;
use "std/io.cst" as io;
use "std/env.cst" as env;
use "../dom/dom.cst" as dom;
use "../css/sheet.cst" as sheet;
use "../css/style.cst" as style;
use "../base/arena.cst" as arena;
use "std/mem.cst" as mem;
use "../dom/tags.cst" as tg;
use "../page/forms.cst" as forms;
use "../html/tree.cst" as tree;
use "jsc.cst" as jsc;
use "../loader/net.cst" as net;

let is *dom.Document as cur_doc with mut = cast(*dom.Document, 0);
let is i64 as dirty with mut = 0;
let is [48]i64 as table with mut;
let is i64 as table_ready with mut = 0;
let is i64 as runs with mut = 0;
// The timers of the script that ran last, for its page to keep.
let is i64 as last_next with mut = 0;
let is i64 as last_tick with mut = 0;
let is i64 as last_done with mut = 0;
let is i64 as last_msg with mut = 0;
let is i64 as last_script with mut = 0;

fn _now_us() as i64 {
    let is [2]i64 as ts;
    syscall(228, 1, &ts);
    return ts[0] * 1000000 + ts[1] / 1000;
}
fn _eq(a as *u8, an as i64, b as *u8, bn as i64) as i64 {
    if (an != bn) { return 0; }
    let is i64 as i with mut = 0;
    while (i < an) { if (cast(i64, a[i]) != cast(i64, b[i])) { return 0; } i = i + 1; }
    return 1;
}
fn _next(root as *dom.Node, n as *dom.Node) as *dom.Node {
    if (n.first != null) { return n.first; }
    let is *dom.Node as x with mut = n;
    while (x != root && x != null) {
        if (x.next != null) { return x.next; }
        x = x.parent;
    }
    return cast(*dom.Node, 0);
}

// One compound selector: tag, #id, .class, [attr] and [attr="value"], in any mix.
fn _has_word(v as *u8, vn as i64, w as *u8, wn as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < vn) {
        while (i < vn && cast(i64, v[i]) <= 32) { i = i + 1; }
        let is i64 as st = i;
        while (i < vn && cast(i64, v[i]) > 32) { i = i + 1; }
        if (_eq(cast(*u8, cast(i64, v) + st), i - st, w, wn) == 1) { return 1; }
    }
    return 0;
}
fn _name_char(c as i64) as i64 {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 95) { return 1; }
    return 0;
}
// What a script asks for is parsed and matched by what styles the page, so every selector the
// page's sheets may use it may use too. The same text comes again and again: the last one is kept.
let is arena.Arena as _sel_a with mut;
let is *u8 as _sel_text with mut = cast(*u8, 0);
let is i64 as _sel_n with mut = 0 - 1;
let is *sheet.Selector as _sel with mut = cast(*sheet.Selector, 0);
fn _parsed(s as i64, sl as i64) as *sheet.Selector {
    if (sl == _sel_n && mem.memcmp(_sel_text, cast(*u8, s), sl) == 0) { return _sel; }
    arena.free(&_sel_a);
    _sel_text = arena.copy(&_sel_a, cast(*u8, s), sl);
    _sel_n = sl;
    _sel = sheet.parse_selector(&_sel_a, _sel_text, sl);
    return _sel;
}
// 0 for nothing, 0 - 1 for a selector that is not one.
fn h_query(root as i64, s as i64, sl as i64) as i64 {
    let is *sheet.Selector as sel = _parsed(s, sl);
    if (sel == null) { return 0 - 1; }
    let is *dom.Node as r = cast(*dom.Node, root);
    style.scope_node = r;
    let is *dom.Node as x with mut = _next(r, r);
    while (x != null) {
        if (x.kind == dom.ELEMENT && style.selector_matches(x, sel) == 1) { return cast(i64, x); }
        x = _next(r, x);
    }
    return 0;
}
// An id is not a selector: it can hold anything, a colon or a dot.
fn h_by_id(root as i64, s as i64, sl as i64) as i64 {
    let is *dom.Node as r = cast(*dom.Node, root);
    let is *dom.Node as x with mut = _next(r, r);
    while (x != null) {
        if (x.kind == dom.ELEMENT) {
            let is *dom.Attr as a = dom.find_attr(x, "id", 2);
            if (a != null && a.value_len == sl && mem.memcmp(a.value, cast(*u8, s), sl) == 0) { return cast(i64, x); }
        }
        x = _next(r, x);
    }
    return 0;
}
fn h_query_all(root as i64, s as i64, sl as i64, out as i64, cap as i64) as i64 {
    let is *sheet.Selector as sel = _parsed(s, sl);
    if (sel == null) { return 0 - 1; }
    let is *dom.Node as r = cast(*dom.Node, root);
    style.scope_node = r;
    let is *dom.Node as x with mut = _next(r, r);
    let is i64 as n with mut = 0;
    while (x != null && n < cap) {
        if (x.kind == dom.ELEMENT && style.selector_matches(x, sel) == 1) { *cast(*i64, out + n * 8) = cast(i64, x); n = n + 1; }
        x = _next(r, x);
    }
    return n;
}
fn _clear(n as *dom.Node) as void {
    while (n.first != null) { dom.remove(n.first); }
}
// Scripts that came in as HTML text are not run, as the standard has it.
fn _no_run(root as *dom.Node) as void {
    let is *dom.Node as x with mut = root.first;
    while (x != null) {
        if (x.kind == dom.ELEMENT && x.tag == tg.SCRIPT) { x.flags = x.flags | 1048576; }
        x = _next(root, x);
    }
}
fn h_set_html(node as i64, s as i64, sl as i64) as i64 {
    let is *dom.Document as d = cur_doc;
    let is *u8 as head = "<!doctype html><html><body>";
    let is i64 as hn with mut = 0;
    while (cast(i64, head[hn]) != 0) { hn = hn + 1; }
    let is *u8 as b = dom.alloc(d, hn + sl + 1);
    let is i64 as i with mut = 0;
    while (i < hn) { b[i] = head[i]; i = i + 1; }
    i = 0;
    while (i < sl) { b[hn + i] = *cast(*u8, s + i); i = i + 1; }
    // The fragment is parsed as a page of its own in the same memory, so its nodes last as
    // long as the document does. A fragment parser would know its context; this does not.
    let is *dom.Node as saved = d.node;
    let is i64 as saved_mode = d.mode;
    d.node = dom._node(d, dom.DOCUMENT);
    tree.parse(d, b, hn + sl);
    let is *dom.Node as frag = d.node;
    d.node = saved;
    d.mode = saved_mode;
    let is *dom.Node as x with mut = _next(frag, frag);
    while (x != null && !(x.kind == dom.ELEMENT && x.tag == tg.BODY)) { x = _next(frag, x); }
    let is *dom.Node as target = cast(*dom.Node, node);
    _clear(target);
    if (x != null) { dom.move_children(x, target); }
    dirty = 1;
    _no_run(cast(*dom.Node, node));
    return 0;
}
fn _set_data(n as *dom.Node, s as i64, sl as i64) as void {
    let is *u8 as b = dom.alloc(cur_doc, sl + 1);
    let is i64 as i with mut = 0;
    while (i < sl) { b[i] = *cast(*u8, s + i); i = i + 1; }
    n.text = b;
    n.text_len = sl;
    n.text_cap = sl;
}
fn h_set_data(node as i64, s as i64, sl as i64) as i64 {
    _set_data(cast(*dom.Node, node), s, sl);
    dirty = 1;
    return 0;
}
fn h_set_text(node as i64, s as i64, sl as i64) as i64 {
    let is *dom.Node as n = cast(*dom.Node, node);
    if (n.kind == dom.TEXT || n.kind == dom.COMMENT) { return h_set_data(node, s, sl); }
    _clear(n);
    if (sl > 0) { dom.append(n, dom.text(cur_doc, cast(*u8, s), sl)); }
    dirty = 1;
    if (n.tag == tg.SCRIPT) { sheets_touched = 1; }
    return 0;
}
fn h_get_text(node as i64, out as i64) as i64 {
    let is *dom.Node as r = cast(*dom.Node, node);
    if (r.kind == dom.COMMENT || r.kind == dom.TEXT) {
        *cast(*i64, out) = cast(i64, r.text);
        return r.text_len;
    }
    let is i64 as total with mut = 0;
    let is *dom.Node as x with mut = r;
    while (x != null) { if (x.kind == dom.TEXT) { total = total + x.text_len; } x = _next(r, x); }
    let is *u8 as b = dom.alloc(cur_doc, total + 1);
    let is i64 as at with mut = 0;
    x = r;
    while (x != null) {
        if (x.kind == dom.TEXT) {
            let is i64 as i with mut = 0;
            while (i < x.text_len) { b[at + i] = x.text[i]; i = i + 1; }
            at = at + x.text_len;
        }
        x = _next(r, x);
    }
    *cast(*i64, out) = cast(i64, b);
    return total;
}
// An HTML element's attribute names are in lower case, however a script writes them.
let is [256]u8 as _attr_lc with mut;
fn _attr_name(n as *dom.Node, name as i64, nl as i64) as *u8 {
    if (n.ns != dom.NS_HTML || nl > 255) { return cast(*u8, name); }
    let is i64 as i with mut = 0;
    while (i < nl) {
        let is u8 as c = *cast(*u8, name + i);
        if (c >= 65 && c <= 90) { _attr_lc[i] = cast(u8, cast(i64, c) + 32); } else { _attr_lc[i] = c; }
        i = i + 1;
    }
    _attr_lc[nl] = cast(u8, 0);
    return cast(*u8, &_attr_lc);
}
fn h_get_attr(node as i64, name as i64, nl as i64, out as i64) as i64 {
    let is *dom.Node as n = cast(*dom.Node, node);
    if (n.kind != dom.ELEMENT) { return -1; }
    let is *dom.Attr as a = dom.find_attr(n, _attr_name(n, name, nl), nl);
    if (a == null) { return -1; }
    *cast(*i64, out) = cast(i64, a.value);
    return a.value_len;
}
// A textarea's value is its text, not an attribute. -1 for anything else.
fn h_area(node as i64, op as i64, v as i64, n as i64, out as i64) as i64 {
    let is *dom.Node as x = cast(*dom.Node, node);
    if (x.kind != dom.ELEMENT || x.tag != tg.TEXTAREA) { return -1; }
    if (op == 1) {
        forms.set_value(cur_doc, x, cast(*u8, v), n);
        dirty = 1;
        return 0;
    }
    let is i64 as got with mut = 0;
    *cast(*i64, out) = cast(i64, forms.value_of(cur_doc, x, &got));
    return got;
}
fn h_set_attr(node as i64, name as i64, nl as i64, v as i64, vl as i64) as i64 {
    dom.set_attr(cur_doc, cast(*dom.Node, node), _attr_name(cast(*dom.Node, node), name, nl), nl, cast(*u8, v), vl);
    dirty = 1;
    if (cast(*dom.Node, node).tag == tg.SCRIPT) { sheets_touched = 1; }
    if (cast(*dom.Node, node).tag == tg.IMG && (nl == 3 || nl == 6)) { h_img(node, 0); }
    return 0;
}
fn h_del_attr(node as i64, name as i64, nl as i64) as i64 {
    dom.remove_attr(cast(*dom.Node, node), _attr_name(cast(*dom.Node, node), name, nl), nl);
    dirty = 1;
    return 0;
}
fn _element(ns as i64, s as i64, sl as i64) as i64 {
    let is *u8 as nm = dom.alloc(cur_doc, sl + 1);
    let is i64 as i with mut = 0;
    while (i < sl) {
        let is i64 as c with mut = cast(i64, *cast(*u8, s + i));
        if (ns == dom.NS_HTML && c >= 65 && c <= 90) { c = c + 32; }
        nm[i] = cast(u8, c);
        i = i + 1;
    }
    tg.ensure();
    return cast(i64, dom.element(cur_doc, ns, tg.lookup(nm, sl), nm, sl));
}
fn h_create(s as i64, sl as i64) as i64 {
    let is i64 as made = _element(dom.NS_HTML, s, sl);
    let is *dom.Node as e = cast(*dom.Node, made);
    if (_eq(e.name, e.name_len, "style", 5) == 1 || _eq(e.name, e.name_len, "link", 4) == 1) { sheets_touched = 1; }
    return made;
}
fn h_create_ns(ns as i64, s as i64, sl as i64) as i64 { return _element(ns, s, sl); }
fn h_text_node(s as i64, sl as i64) as i64 { return cast(i64, dom.text(cur_doc, cast(*u8, s), sl)); }
fn h_comment(s as i64, sl as i64) as i64 { return cast(i64, dom.comment(cur_doc, cast(*u8, s), sl)); }
fn h_fragment() as i64 { return cast(i64, dom.fragment(cur_doc, cast(*dom.Node, 0))); }
fn h_insert(p as i64, c as i64, ref as i64) as i64 {
    let is *dom.Node as par = cast(*dom.Node, p);
    let is *dom.Node as ch = cast(*dom.Node, c);
    let is *dom.Node as rf = cast(*dom.Node, ref);
    if (c == ref) { return c; }
    dirty = 1;
    sheets_touched = 1;
    if (ch.kind == dom.FRAGMENT) {
        // What a fragment holds moves; the fragment stays behind, empty.
        while (ch.first != null) {
            let is *dom.Node as x = ch.first;
            dom.remove(x);
            if (ref == 0) { dom.append(par, x); } else { dom.insert_before(par, x, rf); }
        }
        return c;
    }
    if (ch.parent != null) { dom.remove(ch); }
    if (ref == 0) { dom.append(par, ch); } else { dom.insert_before(par, ch, rf); }
    return c;
}
fn h_append(p as i64, c as i64) as i64 { return h_insert(p, c, 0); }
fn h_tag(node as i64, out as i64) as i64 {
    let is *dom.Node as n = cast(*dom.Node, node);
    if (n.kind != dom.ELEMENT) { *cast(*i64, out) = cast(i64, "#node"); return 5; }
    *cast(*i64, out) = cast(i64, n.name);
    return n.name_len;
}
fn h_root() as i64 { return cast(i64, cur_doc.node); }
fn h_parent(node as i64) as i64 { return cast(i64, cast(*dom.Node, node).parent); }
fn h_remove(node as i64) as i64 {
    let is *dom.Node as n = cast(*dom.Node, node);
    if (n.parent != null) { dom.remove(n); dirty = 1; }
    return 0;
}
fn h_link(node as i64, which as i64) as i64 {
    let is *dom.Node as n = cast(*dom.Node, node);
    if (which == 0) { return cast(i64, n.first); }
    if (which == 1) { return cast(i64, n.last); }
    if (which == 2) { return cast(i64, n.next); }
    return cast(i64, n.prev);
}
fn h_kind(node as i64) as i64 {
    let is i64 as k = cast(*dom.Node, node).kind;
    if (k == dom.ELEMENT) { return 1; }
    if (k == dom.TEXT) { return 3; }
    if (k == dom.COMMENT) { return 8; }
    if (k == dom.DOCUMENT) { return 9; }
    if (k == dom.DOCTYPE) { return 10; }
    return 11;
}
fn h_ns(node as i64) as i64 { return cast(*dom.Node, node).ns; }
fn _clone(n as *dom.Node, deep as i64) as *dom.Node {
    let is *dom.Node as c with mut = cast(*dom.Node, 0);
    if (n.kind == dom.ELEMENT) { c = dom.clone(cur_doc, n); }
    else if (n.kind == dom.TEXT) { c = dom.text(cur_doc, n.text, n.text_len); }
    else if (n.kind == dom.COMMENT) { c = dom.comment(cur_doc, n.text, n.text_len); }
    else { c = dom.fragment(cur_doc, cast(*dom.Node, 0)); }
    if (deep == 1) {
        let is *dom.Node as x with mut = n.first;
        while (x != null) { dom.append(c, _clone(x, 1)); x = x.next; }
    }
    return c;
}
fn h_clone(node as i64, deep as i64) as i64 { return cast(i64, _clone(cast(*dom.Node, node), deep)); }
// innerHTML: the children as text, with what would break it escaped.
let is *u8 as ser_b with mut = cast(*u8, 0);
let is i64 as ser_n with mut = 0;
let is i64 as ser_cap with mut = 0;
fn _ser_byte(c as i64) as void {
    if (ser_n + 1 >= ser_cap) {
        let is i64 as nc with mut = ser_cap * 2;
        if (nc < 4096) { nc = 4096; }
        let is *u8 as nb = dom.alloc(cur_doc, nc);
        let is i64 as i with mut = 0;
        while (i < ser_n) { nb[i] = ser_b[i]; i = i + 1; }
        ser_b = nb;
        ser_cap = nc;
    }
    ser_b[ser_n] = cast(u8, c);
    ser_n = ser_n + 1;
}
fn _ser_s(s as *u8) as void { let is i64 as i with mut = 0; while (cast(i64, s[i]) != 0) { _ser_byte(cast(i64, s[i])); i = i + 1; } }
fn _ser_esc(s as *u8, n as i64, attr as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as c = cast(i64, s[i]);
        if (c == 38) { _ser_s("&amp;"); }
        else if (c == 60 && attr == 0) { _ser_s("&lt;"); }
        else if (c == 62 && attr == 0) { _ser_s("&gt;"); }
        else if (c == 34 && attr == 1) { _ser_s("&quot;"); }
        else { _ser_byte(c); }
        i = i + 1;
    }
}
fn _is_void(n as *dom.Node) as i64 {
    let is *u8 as nm = n.name;
    let is i64 as l = n.name_len;
    if (_eq(nm, l, "br", 2) == 1 || _eq(nm, l, "hr", 2) == 1 || _eq(nm, l, "img", 3) == 1 || _eq(nm, l, "input", 5) == 1 || _eq(nm, l, "meta", 4) == 1 || _eq(nm, l, "link", 4) == 1) { return 1; }
    if (_eq(nm, l, "area", 4) == 1 || _eq(nm, l, "base", 4) == 1 || _eq(nm, l, "col", 3) == 1 || _eq(nm, l, "embed", 5) == 1 || _eq(nm, l, "source", 6) == 1 || _eq(nm, l, "track", 5) == 1 || _eq(nm, l, "wbr", 3) == 1) { return 1; }
    return 0;
}
fn _raw_text(n as *dom.Node) as i64 {
    let is *u8 as nm = n.name;
    let is i64 as l = n.name_len;
    if (_eq(nm, l, "script", 6) == 1 || _eq(nm, l, "style", 5) == 1 || _eq(nm, l, "xmp", 3) == 1 || _eq(nm, l, "iframe", 6) == 1 || _eq(nm, l, "noscript", 8) == 1) { return 1; }
    return 0;
}
fn _ser(n as *dom.Node, parent_raw as i64) as void {
    if (n.kind == dom.TEXT) {
        if (parent_raw == 1) { let is i64 as i with mut = 0; while (i < n.text_len) { _ser_byte(cast(i64, n.text[i])); i = i + 1; } }
        else { _ser_esc(n.text, n.text_len, 0); }
        return;
    }
    if (n.kind == dom.COMMENT) {
        _ser_s("<!--");
        let is i64 as i with mut = 0;
        while (i < n.text_len) { _ser_byte(cast(i64, n.text[i])); i = i + 1; }
        _ser_s("-->");
        return;
    }
    if (n.kind == dom.ELEMENT) {
        _ser_byte(60);
        let is i64 as i with mut = 0;
        while (i < n.name_len) { _ser_byte(cast(i64, n.name[i])); i = i + 1; }
        i = 0;
        while (i < n.nattr) {
            let is *dom.Attr as a = dom.attr_at(n, i);
            _ser_byte(32);
            let is i64 as j with mut = 0;
            while (j < a.name_len) { _ser_byte(cast(i64, a.name[j])); j = j + 1; }
            _ser_s("=\"");
            _ser_esc(a.value, a.value_len, 1);
            _ser_byte(34);
            i = i + 1;
        }
        _ser_byte(62);
        if (_is_void(n) == 1) { return; }
        let is i64 as raw = _raw_text(n);
        let is *dom.Node as x with mut = n.first;
        while (x != null) { _ser(x, raw); x = x.next; }
        _ser_s("</");
        i = 0;
        while (i < n.name_len) { _ser_byte(cast(i64, n.name[i])); i = i + 1; }
        _ser_byte(62);
        return;
    }
    let is *dom.Node as x with mut = n.first;
    while (x != null) { _ser(x, 0); x = x.next; }
}
fn h_get_html(node as i64, out as i64) as i64 {
    let is *dom.Node as n = cast(*dom.Node, node);
    ser_n = 0;
    ser_cap = 0;
    ser_b = cast(*u8, 0);
    let is i64 as raw with mut = 0;
    if (n.kind == dom.ELEMENT) { raw = _raw_text(n); }
    let is *dom.Node as x with mut = n.first;
    while (x != null) { _ser(x, raw); x = x.next; }
    *cast(*i64, out) = cast(i64, ser_b);
    return ser_n;
}
// Set by whoever owns the document: the address, the title, how big the view is.
let is *u8 as page_url with mut = "";
let is i64 as page_url_n with mut = 0;
let is i64 as view_w with mut = 1280;
let is i64 as view_h with mut = 800;
let is *u8 as rect_fn with mut = cast(*u8, 0);
let is *u8 as computed_fn with mut = cast(*u8, 0);
let is *u8 as img_fn with mut = cast(*u8, 0);
fn h_img(node as i64, op as i64) as i64 {
    if (op >= 4 && cast(*dom.Node, node).tag != tg.IMG) { return -1; }
    if (cast(i64, img_fn) == 0) { return 0; }
    return call(img_fn, owner, node, op);
}
let is *u8 as fetch_fn with mut = cast(*u8, 0);
let is *u8 as owner with mut = cast(*u8, 0);
// A <style> or <link> a script made, for the page to look for.
let is i64 as sheets_touched with mut = 0;
fn h_url(which as i64, out as i64) as i64 {
    if (which == 3) {
        let is *u8 as lg = net.language();
        *cast(*i64, out) = cast(i64, lg);
        let is i64 as ln with mut = 0;
        while (lg[ln] != 0) { ln = ln + 1; }
        return ln;
    }
    if (which == 2) {
        *cast(*i64, out) = cast(i64, net.USER_AGENT);
        let is i64 as un with mut = 0;
        while (net.USER_AGENT[un] != 0) { un = un + 1; }
        return un;
    }
    if (which == 0) { *cast(*i64, out) = cast(i64, page_url); return page_url_n; }
    *cast(*i64, out) = cast(i64, "");
    let is *dom.Node as x with mut = _next(cur_doc.node, cur_doc.node);
    while (x != null) {
        if (x.kind == dom.ELEMENT && _eq(x.name, x.name_len, "title", 5) == 1) { return h_get_text(cast(i64, x), out); }
        x = _next(cur_doc.node, x);
    }
    return 0;
}
fn h_viewport(which as i64) as i64 { if (which == 0) { return view_w; } return view_h; }
fn h_rect(node as i64, which as i64) as i64 {
    if (cast(i64, rect_fn) == 0) { return 0; }
    return call(rect_fn, owner, node, which);
}
fn h_computed(node as i64, which as i64, out as i64) as i64 {
    if (cast(i64, computed_fn) == 0) { return 0; }
    return call(computed_fn, owner, node, which, out);
}
// document.cookie. The page's address, terminated, for the jar.
let is [4096]u8 as cookie_url with mut;
let is [8192]u8 as cookie_text with mut;
fn _cookie_url() as *u8 {
    let is i64 as n with mut = page_url_n;
    if (n > 4095) { n = 4095; }
    let is i64 as i with mut = 0;
    while (i < n) { cookie_url[i] = page_url[i]; i = i + 1; }
    cookie_url[n] = 0;
    return cast(*u8, &cookie_url);
}
fn h_cookie(op as i64, a as i64, n as i64) as i64 {
    if (op == 0) {
        *cast(*i64, a) = cast(i64, &cookie_text);
        return net.script_cookies(_cookie_url(), cast(*u8, &cookie_text), 8192);
    }
    if (n > 8191) { return 0; }
    let is i64 as i with mut = 0;
    let is *u8 as t = cast(*u8, a);
