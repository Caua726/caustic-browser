    return 0;
}
// Where a script asked to go, for the browser to do once the script is done.
let is [4096]u8 as nav_url with mut;
let is i64 as nav_wanted with mut = 0;
let is i64 as nav_replace with mut = 0;
let is *u8 as nav_owner with mut = cast(*u8, 0);
// form.submit(): for the browser, which knows how a form is sent, once the script is done.
let is *dom.Node as submit_form with mut = cast(*dom.Node, 0);
let is *u8 as submit_owner with mut = cast(*u8, 0);
fn h_submit(node as i64) as i64 {
    submit_form = cast(*dom.Node, node);
    submit_owner = owner;
    return 1;
}
fn h_attr(node as i64, i as i64, out as *i64) as i64 {
    let is *dom.Node as n = cast(*dom.Node, node);
    if (i >= n.nattr) { return 0; }
    let is *dom.Attr as a = cast(*dom.Attr, cast(i64, n.attrs) + i * sizeof(dom.Attr));
    out[0] = cast(i64, a.name); out[1] = a.name_len; out[2] = cast(i64, a.value); out[3] = a.value_len;
