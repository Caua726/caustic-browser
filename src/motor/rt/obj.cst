    }
    let is *Acc as a = cast(*Acc, alloc(sizeof(Acc)));
    a.kind = K_ACC; a.shape = 1; a.getter = g; a.setter = s;
    if (i >= 0) {
        ob.slots[i] = cast(i64, a);
