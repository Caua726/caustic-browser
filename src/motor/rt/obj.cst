fn rt_set(ov as i64, key as i64, v as i64, ic as *i64) as void {
    if ((ov & PTR_MASK) == 0) {
        let is *Obj as o = cast(*Obj, ov);
        if (cast(i64, o.shape) == ic[0]) {
            let is i64 as t = ic[2];
