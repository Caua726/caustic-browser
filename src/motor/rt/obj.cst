}
fn obj_new() as i64 { return obj_with(P_OBJECT, root_object); }
fn fn_new(code as *u8, env as *i64) as i64 {
    let is *Obj as o = cast(*Obj, alloc(sizeof(Obj)));
    o.kind = K_FN; o.shape = root_for(P_FN); o.proto = P_FN; o.cap = 0;
    o.slots = cast(*i64, 0);
