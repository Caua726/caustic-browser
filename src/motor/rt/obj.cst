}
fn rt_need_obj(v as i64) as void {
    if (v == UNDEF || v == NULLV) { rt_error("TypeError", "Cannot destructure undefined or null"); }
}
fn rt_nullish(v as i64) as i32 { if (v == UNDEF || v == NULLV) { return 1; } return 0; }
fn rt_obj_spread(r as i64, v as i64) as void {
    if (v == UNDEF || v == NULLV) { return; }
    let is *Arr as ks = cast(*Arr, own_keys(v, 1, 0));
