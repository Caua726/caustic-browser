    if (sh.flags == 0 && sh.count == 0) { return 0; }
    let is *Shape as w = shape_node(sh, key);
    if (cast(i64, w) != 0) { return w.flags; }
    return 0;
}
// Transitions out of a shape with many: looked up here. A parent still holds its children,
// which is what keeps them alive.
let is i64 as tr_tab with mut = 0;
let is i64 as tr_size with mut = 0;
let is i64 as tr_used with mut = 0;
fn tr_hash(sh as *Shape, key as i64, flags as i64) as i64 {
    let is i64 as x = (cast(i64, sh) >> 4) * 31 + (key >> 4) * 17 + flags;
    return (x ^ (x >> 17)) & (tr_size - 1);
}
fn tr_put(k as *Shape) as void {
    if ((tr_used + 1) * 2 > tr_size) {
        let is i64 as old = tr_tab;
        let is i64 as olds = tr_size;
        if (tr_size == 0) { tr_size = 65536; } else { tr_size = tr_size * 2; }
        tr_tab = os_map(tr_size * 8);
        let is i64 as i with mut = 0;
        while (i < olds) {
            let is i64 as e = *cast(*i64, old + i * 8);
            if (e != 0) {
                let is *Shape as es = cast(*Shape, e);
                let is i64 as h with mut = tr_hash(es.parent, es.key, es.flags);
                while (*cast(*i64, tr_tab + h * 8) != 0) { h = (h + 1) & (tr_size - 1); }
                *cast(*i64, tr_tab + h * 8) = e;
            }
            i = i + 1;
        }
        if (old != 0) { syscall(11, old, olds * 8); }
    }
    let is i64 as h with mut = tr_hash(k.parent, k.key, k.flags);
    while (*cast(*i64, tr_tab + h * 8) != 0) { h = (h + 1) & (tr_size - 1); }
    *cast(*i64, tr_tab + h * 8) = cast(i64, k);
    tr_used = tr_used + 1;
}
fn shape_next(sh as *Shape, key as i64, flags as i64) as *Shape {
    if (sh.nkids >= 8) {
        let is i64 as h with mut = tr_hash(sh, key, flags);
        while (1 == 1) {
            let is i64 as e = *cast(*i64, tr_tab + h * 8);
            if (e == 0) { break; }
            let is *Shape as es = cast(*Shape, e);
            if (es.parent == sh && es.key == key && es.flags == flags) { return es; }
            h = (h + 1) & (tr_size - 1);
        }
    } else {
        let is *Shape as k with mut = sh.kids;
        while (cast(i64, k) != 0) {
            if (k.key == key && k.flags == flags) { return k; }
            k = k.sib;
        }
    }
    let is *Shape as n = shape_new(sh, key, flags);
    n.sib = sh.kids;
    sh.kids = n;
    sh.nkids = sh.nkids + 1;
    if (sh.nkids == 8) {
        // The ones it already had move over.
        let is *Shape as k with mut = sh.kids;
        while (cast(i64, k) != 0) { tr_put(k); k = k.sib; }
    } else if (sh.nkids > 8) { tr_put(n); }
