    stack_limit = saved - 12288;
    let is i64 as ctor = rt_global_or_undef(lit("RangeError"));
    rt_argc = 1;
    let is i64 as err = rt_new(ctor, lit("Maximum call stack size exceeded"), UNDEF, UNDEF, UNDEF);
    stack_limit = saved;
    ex.throw(err);
    return 0;
