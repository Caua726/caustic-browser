        if (ov == UNDEF || ov == NULLV) { rt_error_key("TypeError", "Cannot set properties of undefined or null, setting ", key); }
        return;
    }
    let is i64 as k = kind_of(ov);
    if (has_shape(k) == 0) { return; }
