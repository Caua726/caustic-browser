}
fn rt_def_accessor(o as i64, kv as i64, g as i64, s as i64, enumerable as i64) as void {
    let is i64 as key = key_of(kv);
    let is *Obj as ob = cast(*Obj, o);
    let is i64 as i = shape_find(ob.shape, key);
    let is i64 as fl with mut = P_NONENUM;
    if (enumerable == 1) { fl = 0; }
    if (i >= 0) {
        let is *Acc as old = acc_of(ob.slots[i]);
        if (cast(i64, old) != 0) {
            if (g != UNDEF) { old.getter = g; }
