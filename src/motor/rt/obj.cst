    if (i >= 0) {
        let is *Acc as ac = acc_of(o.slots[i]);
        if (cast(i64, ac) != 0) {
            if (ac.setter != UNDEF) { rt_fcall(ac.setter, ov, 1, v, UNDEF, UNDEF, UNDEF); }
            return;
        }
