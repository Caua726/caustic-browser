    if ((v & PTR_MASK) == 0 && kind_of(v) == K_ACC) { return cast(*Acc, v); }
    return cast(*Acc, 0);
}
fn obj_add_flags(o as *Obj, key as i64, v as i64, flags as i64) as void {
    let is *Shape as n = shape_next(o.shape, key, flags);
    if (n.idx >= o.cap) {
        let is i64 as nc with mut = o.cap * 2;
        if (nc < 4) { nc = 4; }
