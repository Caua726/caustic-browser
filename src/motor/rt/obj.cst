}
fn rt_fcall(f as i64, t as i64, n as i64, a0 as i64, a1 as i64, a2 as i64, a3 as i64) as i64 {
    rt_argc = n;
    return rt_call(f, t, a0, a1, a2, a3);
}
fn arr_at(a as *Arr, i as i64) as i64 { if (i < a.len) { return a.data[i]; } return UNDEF; }
fn spread_args(av as i64) as void {
