fn obj_with(proto as i64, sh as *Shape) as i64 {
    let is *Obj as o = cast(*Obj, alloc(sizeof(Obj) + INLINE_SLOTS * 8));
    o.kind = K_OBJ; o.shape = sh; o.proto = proto; o.cap = INLINE_SLOTS;
    o.slots = cast(*i64, cast(i64, o) + sizeof(Obj));
    o.kid_root = cast(*Shape, 0); o.code = cast(*u8, 0); o.env = cast(*i64, 0); o.frozen = 0;
