fn rt_set_proto(ov as i64, p as i64) as void {
    if (is_obj(ov) == 0 || (is_obj(p) == 0 && p != NULLV)) { return; }
    let is *Obj as o = cast(*Obj, ov);
    o.proto = p;
    shape_rebuild(o, 0, 0, 0, 0);
}
fn own_has(ov as i64, key as i64) as i32 {
    if (is_ptr(ov) == 0) { return 0; }
    let is i64 as k = kind_of(ov);
