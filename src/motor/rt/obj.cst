    a.len = a.len + 1;
}
fn has_shape(k as i64) as i32 {
    if (k == K_OBJ || k == K_FN || k == K_ARR || k == K_HOST || k == K_STYLE || k == K_REGEX || k == K_PROXY || k == K_TYPED) { return 1; }
    return 0;
}
