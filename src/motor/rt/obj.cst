// ── Calls ──
let is i64 as rt_argc with mut = 0;
let is i64 as rt_callee with mut = 0;
let is [4096]i64 as rt_x with mut;
let is i64 as rt_jump with mut = 0;
let is i64 as rt_jump_cont with mut = 0;
let is i64 as stack_limit with mut = 0;
let is i64 as rt_nt with mut = 10;
let is i64 as rt_nt_this with mut = 0;
fn not_fn() as i64 {
    if (rt_call_key != 0 && is_ptr(rt_call_key) == 1 && kind_of(rt_call_key) == K_STR) { return rt_error_key("TypeError", "not a function: ", rt_call_key); }
    if (cast(i64, rt_call_name) != 0) { return rt_error_key("TypeError", "not a function: ", lit(rt_call_name)); }
    return rt_error("TypeError", "not a function");
}
fn too_deep() as i64 {
    // The error is made by running JS, which needs some of the stack that just ran out.
