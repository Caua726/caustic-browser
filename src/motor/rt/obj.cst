}
fn arr_push(av as i64, v as i64) as void {
    let is *Arr as a = cast(*Arr, av);
    if (a.len == a.acap) {
        let is i64 as nc = a.acap * 2;
        let is *i64 as nd = cast(*i64, alloc(nc * 8));
        let is i64 as i with mut = 0;
        while (i < a.len) { nd[i] = a.data[i]; i = i + 1; }
        a.data = nd; a.acap = nc;
    }
