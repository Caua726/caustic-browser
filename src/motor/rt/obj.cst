        let is i64 as i = cast(i64, d);
        if (cast(f64, i) == d && i >= 0) {
            let is i64 as kd = kind_of(ov);
            if (kd == K_ARR || kd == K_TYPED) {
                let is *Arr as a = cast(*Arr, ov);
                if (i < a.len) { return a.data[i]; }
                return UNDEF;
