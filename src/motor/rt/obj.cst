        if (key == S_length) {
            let is *Arr as a = cast(*Arr, ov);
            let is i64 as nl = cast(i64, to_num_f(v));
            while (a.len < nl) { arr_push(ov, UNDEF); }
            a.len = nl;
            return;
        }
