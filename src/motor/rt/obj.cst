        return 0;
    }
    if (has_shape(k) == 0) { return 0; }
    if (k == K_PROXY) { return own_has(cast(*Obj, ov).env[0], key); }
    if (k == K_ARR || k == K_TYPED) {
        if (key == S_length) { return 1; }
        let is i64 as ai = str_index_of_key(key);
        if (ai >= 0) { if (ai < cast(*Arr, ov).len) { return 1; } return 0; }
    }
    if (k == K_FN && key == S_prototype) { get_slow(ov, S_prototype, NOIC()); }
