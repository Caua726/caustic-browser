}
fn obj_add(o as *Obj, key as i64, v as i64) as void { obj_add_flags(o, key, v, 0); }
// The same properties under new shapes, without `skip` and with `key` flagged: nothing
// cached against the old shape can then answer for this object.
fn shape_rebuild(o as *Obj, skip as i64, key as i64, flags as i64, fresh_root as i64) as void {
    let is i64 as n = o.shape.count;
    let is *i64 as keys = cast(*i64, alloc((n + 1) * 8));
    let is *i64 as fl = cast(*i64, alloc((n + 1) * 8));
    let is *Shape as w with mut = o.shape;
    while (cast(i64, w.parent) != 0) { keys[w.idx] = w.key; fl[w.idx] = w.flags; w = w.parent; }
    let is *Shape as sh with mut = root_for(o.proto);
    if (fresh_root == 1) { sh = shape_new(cast(*Shape, 0), 0, 0); }
    let is *i64 as ns = cast(*i64, alloc((n + 1) * 8));
    let is i64 as out with mut = 0;
