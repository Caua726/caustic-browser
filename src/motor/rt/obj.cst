// ── Numbers as text: the shortest digits that read back the same (Burger & Dybvig) ──
struct Big { n as i64; w as [48]i64; }
fn big_set(b as *Big, v as i64) as void {
    b.n = 0;
    let is i64 as x with mut = v;
    while (x > 0) { b.w[b.n] = x & 4294967295; b.n = b.n + 1; x = (x >> 32) & 4294967295; }
}
fn big_copy(d as *Big, s as *Big) as void { d.n = s.n; let is i64 as i with mut = 0; while (i < s.n) { d.w[i] = s.w[i]; i = i + 1; } }
fn big_mul(b as *Big, m as i64) as void {
    let is i64 as carry with mut = 0;
    let is i64 as i with mut = 0;
    while (i < b.n) { let is i64 as t = b.w[i] * m + carry; b.w[i] = t & 4294967295; carry = (t >> 32) & 4294967295; i = i + 1; }
    if (carry != 0) { b.w[b.n] = carry; b.n = b.n + 1; }
}
fn big_shl(b as *Big, n as i64) as void {
    let is i64 as k with mut = n;
    while (k >= 24) { big_mul(b, 16777216); k = k - 24; }
    if (k > 0) { big_mul(b, 1 << k); }
}
fn big_cmp(a as *Big, b as *Big) as i64 {
    if (a.n != b.n) { return a.n - b.n; }
    let is i64 as i with mut = a.n - 1;
    while (i >= 0) { if (a.w[i] != b.w[i]) { return a.w[i] - b.w[i]; } i = i - 1; }
    return 0;
}
fn big_add(d as *Big, a as *Big, b as *Big) as void {
    let is i64 as carry with mut = 0;
    let is i64 as i with mut = 0;
    let is i64 as m with mut = a.n;
    if (b.n > m) { m = b.n; }
    while (i < m) {
        let is i64 as t with mut = carry;
        if (i < a.n) { t = t + a.w[i]; }
        if (i < b.n) { t = t + b.w[i]; }
        d.w[i] = t & 4294967295;
        carry = (t >> 32) & 4294967295;
        i = i + 1;
    }
    if (carry != 0) { d.w[i] = carry; i = i + 1; }
    d.n = i;
}
fn big_sub(a as *Big, b as *Big) as void {
    let is i64 as borrow with mut = 0;
    let is i64 as i with mut = 0;
    while (i < a.n) {
        let is i64 as t with mut = a.w[i] - borrow;
        if (i < b.n) { t = t - b.w[i]; }
        if (t < 0) { t = t + 4294967296; borrow = 1; } else { borrow = 0; }
        a.w[i] = t;
        i = i + 1;
    }
    while (a.n > 0 && a.w[a.n - 1] == 0) { a.n = a.n - 1; }
}
let is [32]u8 as sd with mut;
let is i64 as sd_n with mut = 0;
fn shortest(x as f64) as i64 {
    // Digits to sd, and where the decimal point goes after the first k of them.
    let is i64 as bits = *cast(*i64, &x);
    let is i64 as be = (bits >> 52) & 2047;
    let is i64 as fr = bits & 4503599627370495;
    let is i64 as f with mut = fr;
    let is i64 as e with mut = -1074;
    if (be != 0) { f = fr + 4503599627370496; e = be - 1075; }
    let is Big as r with mut;
    let is Big as s with mut;
    let is Big as mp with mut;
    let is Big as mm with mut;
    let is i64 as even = cast(i64, (f & 1) == 0);
    big_set(&r, f); big_set(&s, 1); big_set(&mp, 1); big_set(&mm, 1);
    if (e >= 0) {
        big_shl(&r, e + 1); big_shl(&mp, e); big_shl(&mm, e); big_shl(&s, 1);
    } else {
        big_shl(&r, 1); big_shl(&s, 1 - e);
    }
    if (fr == 0 && be > 1) { big_shl(&mp, 1); big_shl(&r, 1); big_shl(&s, 1); }
    let is i64 as k with mut = 0;
    let is Big as t with mut;
    while (1 == 1) {
        big_add(&t, &r, &mp);
        let is i64 as c = big_cmp(&t, &s);
        if (c > 0 || (even == 1 && c == 0)) { big_mul(&s, 10); k = k + 1; } else { break; }
    }
    while (1 == 1) {
        big_add(&t, &r, &mp);
        big_mul(&t, 10);
        let is i64 as c = big_cmp(&t, &s);
        if (c < 0 || (even == 0 && c == 0)) { big_mul(&r, 10); big_mul(&mp, 10); big_mul(&mm, 10); k = k - 1; } else { break; }
    }
    sd_n = 0;
    while (sd_n < 30) {
        big_mul(&r, 10); big_mul(&mp, 10); big_mul(&mm, 10);
        let is i64 as dg with mut = 0;
        while (big_cmp(&r, &s) >= 0) { big_sub(&r, &s); dg = dg + 1; }
        let is i64 as c1 = big_cmp(&r, &mm);
        big_add(&t, &r, &mp);
        let is i64 as c2 = big_cmp(&t, &s);
        let is i64 as low = cast(i64, c1 < 0 || (even == 1 && c1 == 0));
        let is i64 as high = cast(i64, c2 > 0 || (even == 1 && c2 == 0));
        if (low == 0 && high == 0) { sd[sd_n] = cast(u8, 48 + dg); sd_n = sd_n + 1; continue; }
        if (low == 1 && high == 1) {
            big_shl(&r, 1);
            if (big_cmp(&r, &s) >= 0) { dg = dg + 1; }
        } else if (high == 1) { dg = dg + 1; }
        sd[sd_n] = cast(u8, 48 + dg);
        sd_n = sd_n + 1;
        break;
    }
    return k;
}
let is [512]u8 as numb with mut;
fn dbl_str(x as f64) as i64 {
    if (x != x) { return lit("NaN"); }
    if (x > 1.7976931348623157e308) { return lit("Infinity"); }
    if (x < -1.7976931348623157e308) { return lit("-Infinity"); }
    if (x == 0.0) { return lit("0"); }
    let is f64 as a with mut = x;
    let is i64 as p with mut = 0;
    if (a < 0.0) { a = 0.0 - a; numb[p] = cast(u8, 45); p = p + 1; }
    let is i64 as k = shortest(a);
    let is i64 as i with mut = 0;
    if (k >= 1 && k <= 21) {
        while (i < sd_n || i < k) {
            if (i == k) { numb[p] = cast(u8, 46); p = p + 1; }
            if (i < sd_n) { numb[p] = sd[i]; } else { numb[p] = cast(u8, 48); }
            p = p + 1;
            i = i + 1;
        }
    } else if (k <= 0 && k > -6) {
        numb[p] = cast(u8, 48); p = p + 1;
        numb[p] = cast(u8, 46); p = p + 1;
        let is i64 as z with mut = k;
        while (z < 0) { numb[p] = cast(u8, 48); p = p + 1; z = z + 1; }
        while (i < sd_n) { numb[p] = sd[i]; p = p + 1; i = i + 1; }
    } else {
        numb[p] = sd[0]; p = p + 1;
        if (sd_n > 1) {
            numb[p] = cast(u8, 46); p = p + 1;
            i = 1;
            while (i < sd_n) { numb[p] = sd[i]; p = p + 1; i = i + 1; }
        }
        numb[p] = cast(u8, 101); p = p + 1;
        let is i64 as ex0 = k - 1;
        if (ex0 < 0) { numb[p] = cast(u8, 45); } else { numb[p] = cast(u8, 43); }
        p = p + 1;
        let is i64 as ea with mut = ex0;
        if (ea < 0) { ea = 0 - ea; }
        let is [8]u8 as eb;
        let is i64 as q with mut = 0;
        if (ea == 0) { eb[0] = cast(u8, 48); q = 1; }
        while (ea > 0) { eb[q] = cast(u8, 48 + ea % 10); ea = ea / 10; q = q + 1; }
        while (q > 0) { q = q - 1; numb[p] = eb[q]; p = p + 1; }
    }
    return str_new(cast(i64, &numb), p);
}

// ── Shapes ──
let is i64 as SC_SZ with imut = 16384;
let is [49152]i64 as scache with mut;
let is *Shape as root_object with mut = cast(*Shape, 0);
fn NOIC() as *i64 { return cast(*i64, 0); }
fn shape_new(parent as *Shape, key as i64, flags as i64) as *Shape {
    let is *Shape as s = cast(*Shape, alloc(sizeof(Shape)));
    s.parent = parent; s.key = key; s.kids = cast(*Shape, 0); s.sib = cast(*Shape, 0); s.flags = flags;
    if (cast(i64, parent) == 0) { s.idx = -1; s.count = 0; }
    else { s.idx = parent.count; s.count = parent.count + 1; }
    return s;
}
// A big object's shape chain is long, so every 32nd shape keeps a table of a stretch of it:
// as many keys as its count's lowest set bit, and a jump past them, as in a Fenwick tree.
// A lookup walks at most 32 steps and then a logarithmic number of tables.
fn shape_index(w as *Shape) as void {
    let is i64 as span = w.count & (0 - w.count);
    let is i64 as cap with mut = 16;
    while (cap < span * 2) { cap = cap * 2; }
    let is *i64 as t = cast(*i64, alloc(cap * 8));
    let is *Shape as x with mut = w;
    let is i64 as k with mut = 0;
    while (k < span) {
        let is i64 as h with mut = (x.key >> 4) & (cap - 1);
        while (t[h] != 0) { h = (h + 1) & (cap - 1); }
        t[h] = cast(i64, x);
        x = x.parent;
        k = k + 1;
    }
    w.ix = t;
    w.ixmask = cap - 1;
    w.jump = x;
}
fn shape_node(sh as *Shape, key as i64) as *Shape {
    let is *Shape as w with mut = sh;
    while (cast(i64, w.parent) != 0) {
        if ((w.count & 31) == 0) {
            if (cast(i64, w.ix) == 0) { shape_index(w); }
            let is *i64 as t = w.ix;
            let is i64 as m = w.ixmask;
            let is i64 as h with mut = (key >> 4) & m;
            while (t[h] != 0) {
                let is *Shape as e = cast(*Shape, t[h]);
                if (e.key == key) { return e; }
                h = (h + 1) & m;
            }
            w = w.jump;
        } else {
            if (w.key == key) { return w; }
            w = w.parent;
        }
    }
    return cast(*Shape, 0);
}
fn shape_find(sh as *Shape, key as i64) as i64 {
    let is i64 as h = (((cast(i64, sh) >> 4) ^ (key >> 4)) & (SC_SZ - 1)) * 3;
    if (scache[h] == cast(i64, sh) && scache[h + 1] == key) { return scache[h + 2]; }
    let is *Shape as w = shape_node(sh, key);
    let is i64 as r with mut = -1;
    if (cast(i64, w) != 0) { r = w.idx; }
    scache[h] = cast(i64, sh); scache[h + 1] = key; scache[h + 2] = r;
    return r;
}
