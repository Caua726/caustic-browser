    if (is_ptr(f) == 0 || kind_of(f) != K_FN) { return rt_error("TypeError", "not a constructor"); }
    let is i64 as n = rt_argc;
    let is i64 as pr = get_slow(f, S_prototype, NOIC());
    let is i64 as t = obj_with(pr, root_for(pr));
    rt_nt = f;
    rt_nt_this = t;
    rt_argc = n;
    let is i64 as r = rt_call(f, t, a0, a1, a2, a3);
    if (is_obj(r) == 1) { return r; }
    return t;
}
fn rt_new_apply(f as i64, av as i64) as i64 {
    let is *Arr as a = cast(*Arr, av);
    spread_args(av);
    return rt_new(f, arr_at(a, 0), arr_at(a, 1), arr_at(a, 2), arr_at(a, 3));
}
fn rt_xget(k as i64, argc as i64) as i64 { if (k + 4 < argc) { return rt_x[k]; } return UNDEF; }
fn arg_get(i as i64, argc as i64, p0 as i64, p1 as i64, p2 as i64, p3 as i64) as i64 {
    if (i >= argc) { return UNDEF; }
    if (i == 0) { return p0; }
    if (i == 1) { return p1; }
    if (i == 2) { return p2; }
    if (i == 3) { return p3; }
    return rt_x[i - 4];
}
fn rt_rest(from as i64, argc as i64, p0 as i64, p1 as i64, p2 as i64, p3 as i64) as i64 {
    let is i64 as r = arr_new(argc);
    let is i64 as i with mut = from;
    while (i < argc) { arr_push(r, arg_get(i, argc, p0, p1, p2, p3)); i = i + 1; }
    return r;
}
fn rt_arguments(argc as i64, p0 as i64, p1 as i64, p2 as i64, p3 as i64) as i64 { return rt_rest(0, argc, p0, p1, p2, p3); }
fn rt_env(up as *i64, n as i64) as *i64 {
    let is *i64 as s = cast(*i64, alloc((n + 1) * 8));
    s[0] = cast(i64, up);
    let is i64 as i with mut = 1;
    while (i <= n) { s[i] = UNDEF; i = i + 1; }
    return s;
}
fn rt_env_copy(s as *i64, n as i64) as *i64 {
    let is *i64 as d = cast(*i64, alloc((n + 1) * 8));
    let is i64 as i with mut = 0;
    while (i <= n) { d[i] = s[i]; i = i + 1; }
    return d;
}
fn rt_strs_init(out as *i64, n as i64, blob as *u8) as void {
    let is i64 as i with mut = 0;
    let is i64 as p with mut = 0;
    while (i < n) {
        let is i64 as l with mut = 0;
        while (cast(i64, blob[p]) != 58) { l = l * 10 + cast(i64, blob[p]) - 48; p = p + 1; }
        p = p + 1;
        out[i] = intern(str_raw(cast(i64, blob) + p, l));
        p = p + l;
        i = i + 1;
    }
}
// Classes.
fn n_default_ctor(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as n = rt_argc;
    let is i64 as args = rt_rest(0, n, a, b, c, d);
    if (e[0] != UNDEF) { rt_apply(e[0], t, args); }
    rt_run_fields(e[1], t);
    return UNDEF;
}
fn rt_default_ctor(parent as i64, fields as i64) as i64 {
    let is *i64 as env = cast(*i64, alloc(16));
    env[0] = parent; env[1] = fields;
    return fn_new(fn_ptr(n_default_ctor), env);
}
fn rt_run_fields(f as i64, t as i64) as void { if (f != UNDEF) { rt_fcall(f, t, 0, UNDEF, UNDEF, UNDEF, UNDEF); } }
fn rt_class_proto(f as i64, parent as i64) as i64 {
    let is i64 as p = get_slow(f, S_prototype, NOIC());
    if (parent == UNDEF) { return p; }
    if (parent == NULLV) { rt_set_proto(p, NULLV); return p; }
    rt_set_proto(p, get_slow(parent, S_prototype, NOIC()));
    rt_set_proto(f, parent);
    return p;
}
fn rt_super_base(parent as i64) as i64 {
    if (parent == UNDEF || parent == NULLV) { return P_OBJECT; }
    return get_slow(parent, S_prototype, NOIC());
}

// ── Conversions and operators ──
fn to_prim(v as i64, want_str as i64) as i64 {
    if (is_obj(v) == 0) { return v; }
    let is i64 as ex0 = get_slow(v, SYM_toPrimitive, NOIC());
    if (ex0 != UNDEF) {
        let is i64 as hint with mut = lit("number");
        if (want_str == 1) { hint = lit("string"); }
        if (want_str == 2) { hint = lit("default"); }
        return rt_fcall(ex0, v, 1, hint, UNDEF, UNDEF, UNDEF);
    }
    let is i64 as first with mut = S_valueOf;
    let is i64 as second with mut = S_toString;
    if (want_str == 1) { first = S_toString; second = S_valueOf; }
    let is i64 as f = get_slow(v, first, NOIC());
    if (is_ptr(f) == 1 && kind_of(f) == K_FN) {
        let is i64 as r = rt_fcall(f, v, 0, UNDEF, UNDEF, UNDEF, UNDEF);
        if (is_obj(r) == 0) { return r; }
    }
    let is i64 as g = get_slow(v, second, NOIC());
    if (is_ptr(g) == 1 && kind_of(g) == K_FN) {
        let is i64 as r = rt_fcall(g, v, 0, UNDEF, UNDEF, UNDEF, UNDEF);
        if (is_obj(r) == 0) { return r; }
    }
    return rt_error("TypeError", "Cannot convert object to primitive value");
}
fn to_str(v as i64) as i64 {
    if (is_int(v) == 1) { return int_str(int_of(v)); }
    if (is_num(v) == 1) { return dbl_str(unbox_d(v)); }
    if (v == UNDEF) { return lit("undefined"); }
    if (v == NULLV) { return lit("null"); }
    if (v == TRUEV) { return lit("true"); }
    if (v == FALSEV) { return lit("false"); }
    let is i64 as k = kind_of(v);
    if (k == K_STR) { return v; }
    if (k == K_SYM) { return rt_error("TypeError", "Cannot convert a Symbol to a string"); }
    return to_str(to_prim(v, 1));
}
fn is_space(c as i64) as i32 { if (c == 32 || (c >= 9 && c <= 13)) { return 1; } return 0; }
fn parse_num(s as *Str, strict as i64) as f64 {
    let is i64 as i with mut = 0;
    let is i64 as n with mut = s.len;
    while (i < n && is_space(cast(i64, s.bytes[i])) == 1) { i = i + 1; }
    if (strict == 1) { while (n > i && is_space(cast(i64, s.bytes[n - 1])) == 1) { n = n - 1; } }
    if (i == n) { if (strict == 1) { return 0.0; } return math.nan(); }
    let is f64 as sign with mut = 1.0;
    let is i64 as c0 = cast(i64, s.bytes[i]);
    if (c0 == 45) { sign = -1.0; i = i + 1; } else if (c0 == 43) { i = i + 1; }
    if (i + 1 < n && cast(i64, s.bytes[i]) == 48 && strict == 1) {
        let is i64 as x = cast(i64, s.bytes[i + 1]) | 32;
        if (x == 120 || x == 98 || x == 111) {
            let is f64 as base with mut = 16.0;
            if (x == 98) { base = 2.0; }
            if (x == 111) { base = 8.0; }
            let is f64 as r with mut = 0.0;
            i = i + 2;
            while (i < n) {
                let is i64 as c = cast(i64, s.bytes[i]);
                let is f64 as dv with mut = -1.0;
                if (c >= 48 && c <= 57) { dv = cast(f64, c - 48); }
                if ((c | 32) >= 97 && (c | 32) <= 102) { dv = cast(f64, (c | 32) - 87); }
                if (dv < 0.0 || dv >= base) { return math.nan(); }
                r = r * base + dv;
                i = i + 1;
            }
            return r;
        }
    }
    let is i64 as inf_at = i;
    if (n - i >= 8 && cast(i64, s.bytes[i]) == 73) { return sign * math.inf(); }
    let is f64 as v with mut = 0.0;
    let is i64 as seen with mut = 0;
    let is i64 as ex0 with mut = 0;
    while (i < n && cast(i64, s.bytes[i]) >= 48 && cast(i64, s.bytes[i]) <= 57) { v = v * 10.0 + cast(f64, cast(i64, s.bytes[i]) - 48); i = i + 1; seen = 1; }
    if (i < n && cast(i64, s.bytes[i]) == 46) {
        i = i + 1;
        while (i < n && cast(i64, s.bytes[i]) >= 48 && cast(i64, s.bytes[i]) <= 57) { v = v * 10.0 + cast(f64, cast(i64, s.bytes[i]) - 48); ex0 = ex0 - 1; i = i + 1; seen = 1; }
    }
    if (seen == 0) { return math.nan(); }
    if (i < n && (cast(i64, s.bytes[i]) | 32) == 101) {
        let is i64 as j with mut = i + 1;
        let is i64 as sg with mut = 1;
        if (j < n && cast(i64, s.bytes[j]) == 45) { sg = -1; j = j + 1; } else if (j < n && cast(i64, s.bytes[j]) == 43) { j = j + 1; }
        let is i64 as e2 with mut = 0;
        let is i64 as eseen with mut = 0;
        while (j < n && cast(i64, s.bytes[j]) >= 48 && cast(i64, s.bytes[j]) <= 57) { e2 = e2 * 10 + cast(i64, s.bytes[j]) - 48; j = j + 1; eseen = 1; }
        if (eseen == 1) { ex0 = ex0 + sg * e2; i = j; }
    }
    if (strict == 1 && i != n) { return math.nan(); }
    while (ex0 > 0) { v = v * 10.0; ex0 = ex0 - 1; }
    let is f64 as dv with mut = 1.0;
    while (ex0 < 0) { dv = dv * 10.0; ex0 = ex0 + 1; }
    return sign * (v / dv);
}
fn to_num_f(v as i64) as f64 {
    if (is_int(v) == 1) { return cast(f64, int_of(v)); }
    if (is_num(v) == 1) { return unbox_d(v); }
    if (v == TRUEV) { return 1.0; }
    if (v == FALSEV || v == NULLV) { return 0.0; }
    if (v == UNDEF) { return math.nan(); }
    let is i64 as k = kind_of(v);
    if (k == K_STR) { return parse_num(cast(*Str, v), 1); }
    if (k == K_SYM) { rt_error("TypeError", "Cannot convert a Symbol to a number"); return 0.0; }
    return to_num_f(to_prim(v, 0));
}
fn to_i32(v as i64) as i64 {
    if ((v >> 49) == -1) { return int_of(v); }
    let is f64 as d = to_num_f(v);
    if (d != d) { return 0; }
    if (d >= 9000000000000000000.0 || d <= -9000000000000000000.0) {
        // Past an i64: the bits modulo 2^32 from the double's own form.
        if (d > 1.7976931348623157e308 || d < -1.7976931348623157e308) { return 0; }
        let is f64 as m = math.fmod(d, 4294967296.0);
        return cast(i64, cast(i32, cast(i64, m)));
    }
    return cast(i64, cast(i32, cast(i64, d)));
}
fn rt_truthy(v as i64) as i32 {
    if (v == TRUEV) { return 1; }
    if (v == FALSEV || v == UNDEF || v == NULLV) { return 0; }
    if ((v >> 49) == -1) { if (int_of(v) != 0) { return 1; } return 0; }
    if ((v & NUM_TAG) != 0) {
        let is f64 as d = unbox_d(v);
        if (d != d || d == 0.0) { return 0; }
        return 1;
    }
    if (kind_of(v) == K_STR) { if (cast(*Str, v).len > 0) { return 1; } return 0; }
    return 1;
}
fn add_slow(a as i64, b as i64) as i64 {
    if ((a & NUM_TAG) != 0 && (b & NUM_TAG) != 0) { return box_d(to_num_f(a) + to_num_f(b)); }
    let is i64 as x = to_prim(a, 2);
    let is i64 as y = to_prim(b, 2);
    if ((is_ptr(x) == 1 && kind_of(x) == K_STR) || (is_ptr(y) == 1 && kind_of(y) == K_STR)) { return str_concat(to_str(x), to_str(y)); }
    return box_d(to_num_f(x) + to_num_f(y));
}
fn rt_add(a as i64, b as i64) as i64 {
    if (((a & b) >> 49) == -1) {
        let is i64 as r = int_of(a) + int_of(b);
        if (r == cast(i64, cast(i32, r))) { return box_i(r); }
        return box_d(cast(f64, r));
    }
    return add_slow(a, b);
}
fn sub_slow(a as i64, b as i64) as i64 { return box_d(to_num_f(a) - to_num_f(b)); }
fn rt_sub(a as i64, b as i64) as i64 {
    if (((a & b) >> 49) == -1) {
        let is i64 as r = int_of(a) - int_of(b);
        if (r == cast(i64, cast(i32, r))) { return box_i(r); }
        return box_d(cast(f64, r));
    }
    return sub_slow(a, b);
}
fn mul_slow(a as i64, b as i64) as i64 { return box_d(to_num_f(a) * to_num_f(b)); }
fn rt_mul(a as i64, b as i64) as i64 {
    if (((a & b) >> 49) == -1) {
        let is i64 as x = int_of(a);
        let is i64 as y = int_of(b);
        let is i64 as r = x * y;
        if (r == cast(i64, cast(i32, r)) && (r != 0 || (x >= 0 && y >= 0))) { return box_i(r); }
        if (r != cast(i64, cast(i32, r))) { return box_d(cast(f64, x) * cast(f64, y)); }
    }
    return mul_slow(a, b);
}
fn rt_div(a as i64, b as i64) as i64 { return box_num(to_num_f(a) / to_num_f(b)); }
fn rt_mod(a as i64, b as i64) as i64 {
    if (((a & b) >> 49) == -1) {
        let is i64 as x = int_of(a);
        let is i64 as y = int_of(b);
        if (x >= 0 && y > 0) { return box_i(x % y); }
    }
    let is f64 as fb = to_num_f(b);
    let is f64 as fa = to_num_f(a);
    if (fb == 0.0 || fa != fa || fb != fb || fa > 1.7976931348623157e308 || fa < -1.7976931348623157e308) { return box_d(math.nan()); }
    if (fb > 1.7976931348623157e308 || fb < -1.7976931348623157e308) { return box_d(fa); }
    return box_num(math.fmod(fa, fb));
}
fn rt_pow(a as i64, b as i64) as i64 { return box_num(pow_f(to_num_f(a), to_num_f(b))); }
fn pow_f(x as f64, y as f64) as f64 { return math.pow(x, y); }
fn rt_neg(a as i64) as i64 {
    if ((a >> 49) == -1 && int_of(a) != 0) { return box_num(0.0 - cast(f64, int_of(a))); }
    return box_d(-1.0 * to_num_f(a));
}
fn rt_pos(a as i64) as i64 { if ((a & NUM_TAG) != 0) { return a; } return box_num(to_num_f(a)); }
fn rt_band(a as i64, b as i64) as i64 { return box_i(to_i32(a) & to_i32(b)); }
fn rt_bor(a as i64, b as i64) as i64 { return box_i(to_i32(a) | to_i32(b)); }
fn rt_bxor(a as i64, b as i64) as i64 { return box_i(to_i32(a) ^ to_i32(b)); }
fn rt_bnot(a as i64) as i64 { return box_i(to_i32(a) ^ -1); }
fn rt_shl(a as i64, b as i64) as i64 { return box_i(cast(i64, cast(i32, (to_i32(a) & 4294967295) << (to_i32(b) & 31)))); }
fn rt_shr(a as i64, b as i64) as i64 { return box_i(to_i32(a) >> (to_i32(b) & 31)); }
fn rt_ushr(a as i64, b as i64) as i64 {
    let is i64 as r = (to_i32(a) & 4294967295) >> (to_i32(b) & 31);
    if (r <= 2147483647) { return box_i(r); }
    return box_d(cast(f64, r));
}
fn rt_seq(a as i64, b as i64) as i32 {
    if (((a & b) >> 49) == -1) { if (a == b) { return 1; } return 0; }
    if ((a & NUM_TAG) != 0 && (b & NUM_TAG) != 0) { if (to_num_f(a) == to_num_f(b)) { return 1; } return 0; }
    if (a == b) { return 1; }
    if (is_ptr(a) == 1 && is_ptr(b) == 1 && kind_of(a) == K_STR && kind_of(b) == K_STR) {
        return bytes_eq(cast(*Str, a), cast(*Str, b));
    }
    return 0;
}
fn rt_leq(a as i64, b as i64) as i32 {
    if ((a == UNDEF || a == NULLV) && (b == UNDEF || b == NULLV)) { return 1; }
    if (a == UNDEF || a == NULLV || b == UNDEF || b == NULLV) { return 0; }
    if (is_obj(a) == 1 && is_obj(b) == 1) { if (a == b) { return 1; } return 0; }
    if (is_obj(a) == 1) { return rt_leq(to_prim(a, 2), b); }
    if (is_obj(b) == 1) { return rt_leq(a, to_prim(b, 2)); }
    if (is_ptr(a) == 1 && is_ptr(b) == 1) { return rt_seq(a, b); }
    if ((a & NUM_TAG) != 0 && (b & NUM_TAG) != 0) { return rt_seq(a, b); }
    if (is_ptr(a) == 1 && kind_of(a) == K_SYM) { return 0; }
    if (is_ptr(b) == 1 && kind_of(b) == K_SYM) { return 0; }
    if (to_num_f(a) == to_num_f(b)) { return 1; }
    return 0;
}
fn str_cmp(av as i64, bv as i64) as i64 {
    let is *Str as a = cast(*Str, av);
    let is *Str as b = cast(*Str, bv);
    let is i64 as i with mut = 0;
    while (i < a.len && i < b.len) {
        let is i64 as d = cast(i64, a.bytes[i]) - cast(i64, b.bytes[i]);
        if (d != 0) { return d; }
        i = i + 1;
    }
    return a.len - b.len;
}
fn both_str(a as i64, b as i64) as i32 {
    if (is_ptr(a) == 1 && is_ptr(b) == 1 && kind_of(a) == K_STR && kind_of(b) == K_STR) { return 1; }
    return 0;
}
fn lt_slow(a0 as i64, b0 as i64) as i32 {
    let is i64 as a = to_prim(a0, 0);
    let is i64 as b = to_prim(b0, 0);
    if (both_str(a, b) == 1) { if (str_cmp(a, b) < 0) { return 1; } return 0; }
    if (to_num_f(a) < to_num_f(b)) { return 1; } return 0;
}
fn le_slow(a0 as i64, b0 as i64) as i32 {
    let is i64 as a = to_prim(a0, 0);
    let is i64 as b = to_prim(b0, 0);
    if (both_str(a, b) == 1) { if (str_cmp(a, b) <= 0) { return 1; } return 0; }
    if (to_num_f(a) <= to_num_f(b)) { return 1; } return 0;
}
fn rt_lt(a as i64, b as i64) as i32 {
    if (((a & b) >> 49) == -1) { if (int_of(a) < int_of(b)) { return 1; } return 0; }
    return lt_slow(a, b);
}
fn rt_le(a as i64, b as i64) as i32 {
    if (((a & b) >> 49) == -1) { if (int_of(a) <= int_of(b)) { return 1; } return 0; }
    return le_slow(a, b);
}
fn rt_gt(a as i64, b as i64) as i32 { return rt_lt(b, a); }
fn rt_ge(a as i64, b as i64) as i32 { return rt_le(b, a); }
fn rt_typeof(v as i64) as i64 {
    if (is_num(v) == 1) { return lit("number"); }
    if (v == UNDEF) { return lit("undefined"); }
    if (v == TRUEV || v == FALSEV) { return lit("boolean"); }
    if (v == NULLV) { return lit("object"); }
    let is i64 as k = kind_of(v);
    if (k == K_STR) { return lit("string"); }
    if (k == K_SYM) { return lit("symbol"); }
    if (k == K_FN) { return lit("function"); }
    if (k == K_PROXY && kind_of(cast(*Obj, v).env[0]) == K_FN) { return lit("function"); }
    return lit("object");
}

// ── Errors ──
let is i64 as G_global with mut = 10;
fn rt_error(kind_name as *u8, msg as *u8) as i64 {
    let is i64 as ctor = rt_global_or_undef(lit(kind_name));
    let is i64 as text = str_new(cast(i64, msg), cstrlen(msg));
    if (ctor != UNDEF) {
        rt_argc = 1;
        ex.throw(rt_new(ctor, text, UNDEF, UNDEF, UNDEF));
    }
    ex.throw(text);
    return 0;
}
fn rt_error_key(kind_name as *u8, msg as *u8, key as i64) as i64 {
    let is i64 as ctor = rt_global_or_undef(lit(kind_name));
    let is i64 as text with mut = str_new(cast(i64, msg), cstrlen(msg));
    if (kind_of(key) == K_STR) { text = str_concat(text, key); }
    if (ctor != UNDEF) {
        rt_argc = 1;
        ex.throw(rt_new(ctor, text, UNDEF, UNDEF, UNDEF));
    }
    ex.throw(text);
    return 0;
}
fn rt_global_or_undef(key as i64) as i64 {
    if (is_ptr(G_global) == 0) { return UNDEF; }
    let is *Obj as g = cast(*Obj, G_global);
    let is i64 as i = shape_find(g.shape, key);
    if (i >= 0) {
        let is *Acc as ac = acc_of(g.slots[i]);
        if (cast(i64, ac) != 0) { return get_slow(G_global, key, NOIC()); }
        return g.slots[i];
    }
    return UNDEF;
}
fn rt_global(key as i64) as i64 {
    let is *Obj as g = cast(*Obj, G_global);
    if (shape_find(g.shape, key) >= 0) { return get_slow(G_global, key, NOIC()); }
    let is i64 as text = str_concat(key, lit(" is not defined"));
    let is i64 as ctor = rt_global_or_undef(lit("ReferenceError"));
    if (ctor != UNDEF) { rt_argc = 1; ex.throw(rt_new(ctor, text, UNDEF, UNDEF, UNDEF)); }
    ex.throw(text);
    return 0;
}
fn rt_global_decl(key as i64) as void {
    let is *Obj as g = cast(*Obj, G_global);
    if (shape_find(g.shape, key) < 0) { set_slow(G_global, key, UNDEF, NOIC()); }
}
fn rt_global_set(key as i64, v as i64) as void { set_slow(G_global, key, v, NOIC()); }
fn print_value(v as i64) as void {
    if (is_num(v) == 1 && (v >> 49) != -1 && v == box_d(-1.0 * 0.0)) { out_c("-0"); return; }
    let is ex.Frame as f;
    let is i64 as code = ex.begin(&f);
    if (code != 0) { out_c("[value that could not be printed]"); return; }
    ex.enter(&f);
    let is *Str as s = cast(*Str, to_str(v));
    ex.leave(&f);
    let is i64 as j with mut = 0;
    while (j < s.len) { out_byte(cast(i64, s.bytes[j])); j = j + 1; }
}
// window.onerror first, as a page expects, unless it is the one that threw.
let is i64 as in_onerror with mut = 0;
fn report_uncaught(v as i64) as void {
    if (in_onerror == 0 && is_ptr(G_global) == 1) {
        let is i64 as h = rt_global_or_undef(lit("onerror"));
        if (is_ptr(h) == 1 && kind_of(h) == K_FN) {
            in_onerror = 1;
            let is ex.Frame as f;
            let is i64 as code = ex.begin(&f);
            if (code == 0) {
                ex.enter(&f);
                let is i64 as msg with mut = v;
                let is ex.Frame as g;
                if (ex.begin(&g) == 0) { ex.enter(&g); msg = str_concat(lit("Uncaught "), to_str(v)); ex.leave(&g); }
                rt_x[0] = v;
                rt_argc = 5;
                let is i64 as said = rt_call(h, G_global, msg, lit(""), box_i(0), box_i(0));
                ex.leave(&f);
                in_onerror = 0;
                if (said == TRUEV) { return; }
            }
            in_onerror = 0;
        }
    }
    flush();
    out_c("Uncaught ");
    print_value(v);
    out_byte(10);
    flush();
}

// ── Iteration ──
fn rt_iter(v as i64) as i64 {
    let is *Cursor as c = cast(*Cursor, alloc(sizeof(Cursor)));
    c.kind = K_CURSOR; c.shape = 1; c.subject = v; c.idx = 0; c.mode = 0; c.next_fn = 0;
    if (is_ptr(v) == 1) {
        let is i64 as k = kind_of(v);
        if (k == K_ARR || k == K_TYPED) {
            // The plain case, unless someone replaced how arrays iterate.
            return cast(i64, c);
        }
        if (k == K_STR) { c.mode = 1; return cast(i64, c); }
    }
    if (v == UNDEF || v == NULLV) { return rt_error("TypeError", "undefined or null is not iterable"); }
    let is i64 as f = get_slow(v, SYM_iterator, NOIC());
    if (is_ptr(f) == 0 || kind_of(f) != K_FN) { return rt_error("TypeError", "value is not iterable"); }
    c.mode = 2;
    c.subject = rt_fcall(f, v, 0, UNDEF, UNDEF, UNDEF, UNDEF);
    c.next_fn = get_slow(c.subject, S_next, NOIC());
    return cast(i64, c);
}
// The next value, or 0 at the end.
fn rt_iter_next(cv as i64) as i64 {
    let is *Cursor as c = cast(*Cursor, cv);
    if (c.mode == 0) {
        let is *Arr as a = cast(*Arr, c.subject);
        if (c.idx >= a.len) { return 0; }
        let is i64 as v = a.data[c.idx];
        c.idx = c.idx + 1;
        return v;
    }
    if (c.mode == 1) {
        let is *Str as s = cast(*Str, c.subject);
        if (c.idx >= s.len) { return 0; }
        let is i64 as b0 = cast(i64, s.bytes[c.idx]);
        let is i64 as n with mut = 1;
        if (b0 >= 240) { n = 4; } else if (b0 >= 224) { n = 3; } else if (b0 >= 192) { n = 2; }
        if (c.idx + n > s.len) { n = s.len - c.idx; }
        let is i64 as r = str_raw(cast(i64, s.bytes) + c.idx, n);
        c.idx = c.idx + n;
        return r;
    }
    let is i64 as r = rt_fcall(c.next_fn, c.subject, 0, UNDEF, UNDEF, UNDEF, UNDEF);
    if (rt_truthy(get_slow(r, S_done, NOIC())) == 1) { return 0; }
    return get_slow(r, S_value, NOIC());
}
fn rt_iter_to_array(v as i64) as i64 {
    if (is_ptr(v) == 1 && kind_of(v) == K_ARR) { return v; }
    let is i64 as r = arr_new(8);
    rt_arr_spread(r, v);
    return r;
}
fn rt_arr_spread(r as i64, v as i64) as void {
    let is i64 as it = rt_iter(v);
    while (1 == 1) {
        let is i64 as x = rt_iter_next(it);
        if (x == 0) { return; }
        arr_push(r, x);
    }
}
fn rt_arr_from(av as i64, i0 as i64) as i64 {
    let is *Arr as a = cast(*Arr, av);
    let is i64 as r = arr_new(4);
    let is i64 as i with mut = i0;
    while (i < a.len) { arr_push(r, a.data[i]); i = i + 1; }
    return r;
}

// ── Generators: each body on a stack of its own ──
let is i64 as CO_STACK with imut = 262144;
struct Co {
    sp as i64;          // where to resume it
    caller_sp as i64;   // where it resumes whoever asked
    stack as i64;
    code as *u8;
    env as *i64;
    this_v as i64;
    args as i64;
    state as i64;       // 0 fresh, 1 suspended, 2 running, 3 done
    sent as i64;
    sent_mode as i64;   // 0 next, 1 throw, 2 return
    out as i64;         // what it handed back
    threw as i64;
    head as i64;
    saved_limit as i64;
    prev_co as *Co;
    all_next as *Co;
}
let is *Co as co_list with mut = cast(*Co, 0);
let is *Co as co_cur with mut = cast(*Co, 0);
let is i64 as co_free with mut = 0;
let is i64 as CO_RETURN with mut = 0;
fn co_switch(save_to as *i64, to as i64) as void with naked {
    asm("push rbx\npush rbp\npush r12\npush r13\npush r14\npush r15\nmov [rdi], rsp\nmov rsp, rsi\npop r15\npop r14\npop r13\npop r12\npop rbp\npop rbx\nret\n");
}
fn co_entry() as void {
    let is *Co as c with mut = co_cur;
    let is ex.Frame as f;
    let is i64 as code = ex.begin(&f);
    if (code != 0) {
        // Past the top of the body: the asker gets it.
        c = co_cur;
        if (code == CO_RETURN) { c.out = c.sent; c.threw = 0; }
        else { c.out = code; c.threw = 1; }
    } else {
        ex.enter(&f);
        let is *Arr as a = cast(*Arr, c.args);
        spread_args(c.args);
        let is i64 as r = call(c.code, c.env, c.this_v, arr_at(a, 0), arr_at(a, 1), arr_at(a, 2), arr_at(a, 3));
        ex.leave(&f);
        c = co_cur;
        c.out = r;
        c.threw = 0;
    }
    c.state = 3;
    co_switch(&c.sp, c.caller_sp);
}
fn co_resume(c as *Co, v as i64, mode as i64) as i64 {
    if (c.state == 2) { return rt_error("TypeError", "Generator is already running"); }
    if (c.state == 3) {
        if (mode == 1) { ex.throw(v); }
        if (mode == 2) { return iter_result(v, 1); }
        return iter_result(UNDEF, 1);
    }
    if (c.state == 0 && mode != 0) {
        c.state = 3;
        if (mode == 1) { ex.throw(v); }
        return iter_result(v, 1);
    }
    if (c.state == 0) {
        let is i64 as st with mut = co_free;
        if (st != 0) { co_free = *cast(*i64, st); }
        else { st = os_map(CO_STACK); }
        c.stack = st;
        c.all_next = co_list;
        co_list = c;
        let is i64 as top = st + CO_STACK - 64;
        let is *i64 as s = cast(*i64, top);
        // Six registers popped, then a ret into the entry with the stack as a call leaves it.
        s[0] = 0; s[1] = 0; s[2] = 0; s[3] = 0; s[4] = 0; s[5] = 0;
        s[6] = cast(i64, fn_ptr(co_entry));
        s[7] = 0;
        c.sp = top;
    }
    c.sent = v;
    c.sent_mode = mode;
    c.state = 2;
    let is *Co as prev = co_cur;
    c.prev_co = prev;
    let is i64 as head_saved = cast(i64, ex._head);
    let is i64 as limit_saved = stack_limit;
    co_cur = c;
    ex._head = cast(*ex.Frame, c.head);
    stack_limit = c.stack + 32768;
    co_switch(&c.caller_sp, c.sp);
    c.head = cast(i64, ex._head);
    ex._head = cast(*ex.Frame, head_saved);
    stack_limit = limit_saved;
    co_cur = prev;
    if (c.state == 3) {
        *cast(*i64, c.stack) = co_free;
        co_free = c.stack;
        if (c.threw == 1) { ex.throw(c.out); }
        return iter_result(c.out, 1);
    }
    c.state = 1;
    return iter_result(c.out, 0);
}
fn iter_result(v as i64, done as i64) as i64 {
    let is i64 as r = obj_new();
    obj_add(cast(*Obj, r), S_value, v);
    obj_add(cast(*Obj, r), S_done, box_b(cast(i32, done)));
    return r;
}
fn rt_yield(v as i64) as i64 {
    let is *Co as c with mut = co_cur;
    if (cast(i64, c) == 0) { return rt_error("SyntaxError", "yield outside a generator"); }
    c.out = v;
    c.state = 1;
    co_switch(&c.sp, c.caller_sp);
    c = co_cur;
    if (c.sent_mode == 1) { ex.throw(c.sent); }
    if (c.sent_mode == 2) { ex.throw(CO_RETURN); }
    return c.sent;
}
fn rt_yield_all(v as i64) as i64 {
    let is i64 as it = rt_iter(v);
    while (1 == 1) {
        let is i64 as x = rt_iter_next(it);
        if (x == 0) { return UNDEF; }
        rt_yield(x);
    }
    return UNDEF;
}
fn co_of(t as i64) as *Co {
    if (is_ptr(t) == 0 || kind_of(t) != K_OBJ || cast(i64, cast(*Obj, t).code) != 1) {
        rt_error("TypeError", "not a generator");
    }
    return cast(*Co, cast(*Obj, t).env);
}
fn n_gen_next(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return co_resume(co_of(t), a, 0); }
fn n_gen_throw(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return co_resume(co_of(t), a, 1); }
fn n_gen_return(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return co_resume(co_of(t), a, 2); }
fn n_self(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return t; }
fn rt_coroutine(code as *u8, env as *i64, this_v as i64, p0 as i64, p1 as i64, p2 as i64, p3 as i64, is_async as i64) as i64 {
    let is i64 as args = rt_rest(0, rt_argc, p0, p1, p2, p3);
    let is *Co as c = cast(*Co, alloc(sizeof(Co)));
    c.sp = 0; c.caller_sp = 0; c.stack = 0; c.code = code; c.env = env; c.this_v = this_v; c.args = args; c.state = 0;
    c.sent = UNDEF; c.sent_mode = 0; c.out = UNDEF; c.threw = 0; c.head = 0; c.saved_limit = 0;
    let is i64 as g = obj_with(P_GEN, root_for(P_GEN));
    let is *Obj as o = cast(*Obj, g);
    o.code = cast(*u8, 1);
    o.env = cast(*i64, c);
    if (is_async == 2) {
        let is i64 as adriver = rt_global_or_undef(lit("__asyncGen"));
        return rt_fcall(adriver, UNDEF, 1, g, UNDEF, UNDEF, UNDEF);
    }
    if (is_async == 1) {
        let is i64 as driver = rt_global_or_undef(lit("__async"));
        return rt_fcall(driver, UNDEF, 1, g, UNDEF, UNDEF, UNDEF);
    }
    return g;
}
