}
fn root_for(proto as i64) as *Shape {
    if (is_ptr(proto) == 0) {
        if (cast(i64, root_null) == 0) { root_null = shape_new(cast(*Shape, 0), 0, 0); }
        return root_null;
    }
    let is *Obj as p = cast(*Obj, proto);
    if (cast(i64, p.kid_root) == 0) { p.kid_root = shape_new(cast(*Shape, 0), 0, 0); }
    return p.kid_root;
}
