}
fn arr_new(cap0 as i64) as i64 {
    let is i64 as c with mut = cap0;
    if (c < 4) { c = 4; }
    let is *Arr as a = cast(*Arr, alloc(sizeof(Arr)));
    a.kind = K_ARR; a.shape = root_for(P_ARRAY); a.proto = P_ARRAY; a.cap = 0; a.slots = cast(*i64, 0);
    a.kid_root = cast(*Shape, 0); a.code = cast(*u8, 0); a.env = cast(*i64, 0); a.frozen = 0;
