fn proto_start(v as i64, k as i64) as i64 {
    if (k == K_STR) { return P_STRING; }
    if (k == K_SYM) { return P_SYMBOL; }
    return UNDEF;
}
fn str_index_of_key(key as i64) as i64 {
    // A canonical array index in a key string, or -1.
    if (kind_of(key) != K_STR) { return -1; }
    let is *Str as s = cast(*Str, key);
    if (s.len == 0 || s.len > 10) { return -1; }
    if (s.len > 1 && cast(i64, s.bytes[0]) == 48) { return -1; }
    let is i64 as r with mut = 0;
    let is i64 as i with mut = 0;
    while (i < s.len) {
        let is i64 as c = cast(i64, s.bytes[i]);
        if (c < 48 || c > 57) { return -1; }
        r = r * 10 + c - 48;
        i = i + 1;
    }
    return r;
}
fn get_slow(ov as i64, key as i64, ic as *i64) as i64 {
    let is i64 as start with mut = UNDEF;
    if (is_ptr(ov) == 0) {
        if (ov == UNDEF || ov == NULLV) {
            return rt_error_key("TypeError", "Cannot read properties of undefined or null, reading ", key);
        }
        if ((ov & NUM_TAG) != 0) { start = P_NUMBER; } else { start = P_BOOLEAN; }
    } else {
        let is i64 as k = kind_of(ov);
        if (k == K_STR) {
            if (key == S_length) { return box_i(s_ulen(cast(*Str, ov))); }
            let is i64 as si = str_index_of_key(key);
            if (si >= 0) { return rt_geti(ov, box_i(si)); }
            start = P_STRING;
        } else if (k == K_SYM) {
            start = P_SYMBOL;
        } else {
            if (k == K_PROXY) { return proxy_get(ov, key); }
            if (k == K_ARR || k == K_TYPED) {
                if (key == S_length) { return box_i(cast(*Arr, ov).len); }
                let is i64 as ai = str_index_of_key(key);
                if (ai >= 0) { return rt_geti(ov, box_i(ai)); }
            }
            if (k == K_HOST) { let is i64 as hv = host_get(ov, key); if (hv != 0) { return hv; } }
            if (k == K_STYLE) { let is i64 as sv = style_get(ov, key); if (sv != 0) { return sv; } }
            if (key == S_proto) { return cast(*Obj, ov).proto; }
            let is *Obj as o = cast(*Obj, ov);
            let is i64 as i = shape_find(o.shape, key);
            if (i >= 0) {
                let is i64 as val = o.slots[i];
                let is *Acc as ac = acc_of(val);
                if (cast(i64, ac) != 0) {
                    if (ac.getter == UNDEF) { return UNDEF; }
                    return rt_fcall(ac.getter, ov, 0, UNDEF, UNDEF, UNDEF, UNDEF);
