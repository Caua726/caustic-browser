// Own keys: integer-like first in order, then the rest as they were added.
fn own_keys(ov as i64, only_enum as i64, syms as i64) as i64 {
    let is i64 as r = arr_new(8);
    if (is_ptr(ov) == 0) { return r; }
    let is i64 as k = kind_of(ov);
    if (k == K_STR) {
        let is i64 as i with mut = 0;
        while (i < s_ulen(cast(*Str, ov))) { arr_push(r, intern(int_str(i))); i = i + 1; }
        return r;
    }
    if (has_shape(k) == 0) { return r; }
    if (k == K_PROXY) { return proxy_keys(ov, only_enum, syms); }
    if (k == K_ARR || k == K_TYPED) {
        let is i64 as i with mut = 0;
        while (i < cast(*Arr, ov).len) { arr_push(r, intern(int_str(i))); i = i + 1; }
    }
    let is *Obj as o = cast(*Obj, ov);
    let is i64 as n = o.shape.count;
    let is *i64 as ks = cast(*i64, alloc((n + 1) * 8));
    let is *i64 as fs = cast(*i64, alloc((n + 1) * 8));
    let is *Shape as w with mut = o.shape;
    while (cast(i64, w.parent) != 0) { ks[w.idx] = w.key; fs[w.idx] = w.flags; w = w.parent; }
    let is i64 as pass with mut = 0;
    while (pass < 2) {
        let is i64 as i with mut = 0;
        let is i64 as lastnum with mut = -1;
        while (i < n) {
            let is i64 as kk = ks[i];
            let is i64 as issym = cast(i64, kind_of(kk) == K_SYM);
            if (issym == syms && !(only_enum == 1 && (fs[i] & P_NONENUM) != 0)) {
                let is i64 as idx with mut = -1;
                if (issym == 0) { idx = str_index_of_key(kk); }
                if (issym == 0 && cast(*Str, kk).len > 6 && cast(i64, cast(*Str, kk).bytes[0]) == 35 && cast(i64, cast(*Str, kk).bytes[1]) == 112 && cast(i64, cast(*Str, kk).bytes[5]) == 58) { idx = -2; }
                if ((pass == 0 && idx >= 0) || (pass == 1 && idx == -1)) { arr_push(r, kk); }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    // Integer keys came in insertion order; a short insertion sort puts them right.
    let is *Arr as ra = cast(*Arr, r);
    let is i64 as a0 with mut = 1;
    while (a0 < ra.len) {
        let is i64 as x = ra.data[a0];
        let is i64 as xi with mut = -1;
        if (kind_of(x) == K_STR) { xi = str_index_of_key(x); }
        if (xi >= 0) {
            let is i64 as j with mut = a0 - 1;
            while (j >= 0) {
                let is i64 as y = ra.data[j];
                if (kind_of(y) != K_STR) { break; }
                let is i64 as yi = str_index_of_key(y);
                if (yi < 0 || yi <= xi) { break; }
                ra.data[j + 1] = y;
                j = j - 1;
            }
            ra.data[j + 1] = x;
        }
        a0 = a0 + 1;
    }
    return r;
}
fn rt_forin_keys(ov as i64) as i64 {
    let is i64 as r = arr_new(8);
    let is i64 as w with mut = ov;
    if (is_ptr(w) == 0) { return r; }
    if (kind_of(w) == K_STR) { return own_keys(w, 1, 0); }
    let is i64 as first with mut = 1;
    while (is_obj(w) == 1) {
        let is *Arr as ks = cast(*Arr, own_keys(w, 1, 0));
        let is i64 as i with mut = 0;
        while (i < ks.len) {
            let is i64 as kk = ks.data[i];
            let is i64 as dup with mut = 0;
            if (first == 0) {
                let is *Arr as ra = cast(*Arr, r);
                let is i64 as j with mut = 0;
                while (j < ra.len) { if (ra.data[j] == kk) { dup = 1; break; } j = j + 1; }
            }
            if (dup == 0) { arr_push(r, kk); }
            i = i + 1;
        }
        w = cast(*Obj, w).proto;
        first = 0;
    }
