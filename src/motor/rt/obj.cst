                obj_add_flags(o, S_prototype, pr, P_NONENUM);
                return pr;
            }
            start = o.proto;
        }
    }
    let is i64 as pv with mut = start;
    let is i64 as depth with mut = 1;
    while (is_ptr(pv) == 1) {
        let is *Obj as h = cast(*Obj, pv);
        let is i64 as hi = shape_find(h.shape, key);
        if (hi >= 0) {
            let is i64 as val = h.slots[hi];
            let is *Acc as ac = acc_of(val);
            if (cast(i64, ac) != 0) {
                if (ac.getter == UNDEF) { return UNDEF; }
                return rt_fcall(ac.getter, ov, 0, UNDEF, UNDEF, UNDEF, UNDEF);
