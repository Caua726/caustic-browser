    let is i64 as i with mut = 0;
    while (i < len * 3) { saved[i] = r.code[at0 * 3 + i]; i = i + 1; }
    r.n = at0;
    let is i64 as k with mut = 0;
    while (k < min) {
        i = 0;
        while (i < len) { rx_emit(saved[i * 3], saved[i * 3 + 1], saved[i * 3 + 2]); i = i + 1; }
        k = k + 1;
