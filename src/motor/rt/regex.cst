            else { ch = rx_escape_char(); }
        } else {
            ch = cp_at(rxp, rxi, rxn);
            rxi = rxi + cplen(cast(i64, rxp[rxi]));
        }
        if (rxi + 1 < rxn && cast(i64, rxp[rxi]) == 45 && cast(i64, rxp[rxi + 1]) != 93) {
