// ── Regular expressions: a backtracking machine over bytes ──
let is i64 as RX_CHAR with imut = 1;
let is i64 as RX_ANY with imut = 2;
let is i64 as RX_ANYNL with imut = 3;
let is i64 as RX_CLASS with imut = 4;
let is i64 as RX_SPLIT with imut = 5;
let is i64 as RX_JMP with imut = 6;
let is i64 as RX_SAVE with imut = 7;
let is i64 as RX_BOL with imut = 8;
let is i64 as RX_EOL with imut = 9;
let is i64 as RX_WORDB with imut = 10;
let is i64 as RX_NWORDB with imut = 11;
let is i64 as RX_BACKREF with imut = 12;
let is i64 as RX_LOOK with imut = 13;
let is i64 as RX_MATCH with imut = 14;
let is i64 as RX_MARK with imut = 15;
let is i64 as RX_CHECK with imut = 16;
struct Rx {
    code as *i64; n as i64; cap as i64;
    ngroups as i64;
    nmarks as i64;
    icase as i64; multi as i64; dotall as i64; global as i64; sticky as i64;
    names as i64;           // an array of [name, group]
    src as i64; flags as i64;
}
let is *u8 as rxp with mut = cast(*u8, 0);
let is i64 as rxn with mut = 0;
let is i64 as rxi with mut = 0;
let is *Rx as rxc with mut = cast(*Rx, 0);
fn rx_emit(a as i64, b as i64, c as i64) as i64 {
    let is *Rx as r = rxc;
    if ((r.n + 1) * 3 > r.cap) {
        let is i64 as nc with mut = r.cap * 2;
        if (nc < 96) { nc = 96; }
        let is *i64 as d = cast(*i64, alloc(nc * 8));
        let is i64 as i with mut = 0;
        while (i < r.n * 3) { d[i] = r.code[i]; i = i + 1; }
        r.code = d; r.cap = nc;
    }
    let is i64 as at0 = r.n;
    r.code[at0 * 3] = a; r.code[at0 * 3 + 1] = b; r.code[at0 * 3 + 2] = c;
    r.n = at0 + 1;
    return at0;
}
fn rx_set(i as i64, b as i64, c as i64) as void { rxc.code[i * 3 + 1] = b; rxc.code[i * 3 + 2] = c; }
fn rx_err(msg as *u8) as i64 { return rt_error("SyntaxError", msg); }
struct RxCls { bits as *u8; neg as i64; hi_all as i64; nr as i64; cap as i64; r as *i64; }
fn cls_new() as *RxCls {
    let is *RxCls as k = cast(*RxCls, alloc(sizeof(RxCls)));
    k.bits = cast(*u8, alloc(16));
    let is i64 as i with mut = 0;
    while (i < 16) { k.bits[i] = cast(u8, 0); i = i + 1; }
