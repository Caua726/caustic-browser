        hit = cls_has(k, c);
    } else {
        let is i64 as len with mut = cplen(c);
        if (sp + len > n) { len = 1; }
        *w = len;
        if (k.hi_all == 1) { hit = 1; }
        else {
            let is i64 as cp = cp_at(s, sp, n);
            let is i64 as i with mut = 0;
            while (i < k.nr) {
                if (cp >= k.r[i * 2] && cp <= k.r[i * 2 + 1]) { hit = 1; break; }
                i = i + 1;
            }
