}
fn cls_set(k as *RxCls, v as i64) as void { k.bits[v >> 3] = cast(u8, cast(i64, k.bits[v >> 3]) | (1 << (v & 7))); }
fn cls_has(k as *RxCls, v as i64) as i64 { return (cast(i64, k.bits[v >> 3]) >> (v & 7)) & 1; }
fn cls_range(k as *RxCls, a as i64, b as i64) as void {
    let is i64 as x0 with mut = a;
    while (x0 <= b && x0 < 128) { cls_set(k, x0); x0 = x0 + 1; }
    if (b < 128) { return; }
    if (k.nr == k.cap) {
        let is i64 as nc with mut = k.cap * 2;
        if (nc < 8) { nc = 8; }
        let is *i64 as nr0 = cast(*i64, alloc(nc * 16));
        let is i64 as i with mut = 0;
        while (i < k.nr * 2) { nr0[i] = k.r[i]; i = i + 1; }
        k.r = nr0;
        k.cap = nc;
    }
    k.r[k.nr * 2] = x0;
    k.r[k.nr * 2 + 1] = b;
    k.nr = k.nr + 1;
}
fn cls_escape(k as *RxCls, e as i64) as i32 {
    // \d \w \s and their opposites into a class.
    let is i64 as lower = e | 32;
    if (lower != 100 && lower != 119 && lower != 115) { return 0; }
    let is [16]u8 as t;
    let is i64 as i with mut = 0;
    while (i < 16) { t[i] = cast(u8, 0); i = i + 1; }
    let is *RxCls as tk0 = cls_new();
    if (lower == 100) { cls_range(tk0, 48, 57); }
    else if (lower == 119) { cls_range(tk0, 48, 57); cls_range(tk0, 65, 90); cls_range(tk0, 97, 122); cls_set(tk0, 95); }
    else {
        cls_range(tk0, 9, 13); cls_set(tk0, 32);
        cls_range(k, 160, 160); cls_range(k, 8192, 8202); cls_range(k, 8232, 8233); cls_range(k, 65279, 65279);
    }
    i = 0;
    while (i < 16) {
        let is i64 as v with mut = cast(i64, tk0.bits[i]);
        if (e < 97) { v = v ^ 255; }
