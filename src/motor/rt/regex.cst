}
// A few stacks kept between runs: a regular expression is tried at every position.
let is [4]i64 as rx_pool with mut;
let is [4]i64 as rx_pool_cap with mut;
let is i64 as rx_pool_n with mut = 0;
fn rx_run(r as *Rx, pc0 as i64, s as *u8, n as i64, sp0 as i64, caps as *i64, marks as *i64) as i64 {
