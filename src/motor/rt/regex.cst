    else if (c == 63) { min = 0; max = 1; rxi = rxi + 1; }
    else if (c == 123) {
        let is i64 as j with mut = rxi + 1;
        let is i64 as a0 with mut = 0;
        let is i64 as seen with mut = 0;
        while (j < rxn && cast(i64, rxp[j]) >= 48 && cast(i64, rxp[j]) <= 57) { a0 = a0 * 10 + cast(i64, rxp[j]) - 48; j = j + 1; seen = 1; }
        if (seen == 0) { return; }
