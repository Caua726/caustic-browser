        stcap = rx_pool_cap[rx_pool_n];
    } else { st = cast(*i64, os_map(stcap * 16)); }
    let is i64 as top with mut = 0;
    let is i64 as pc with mut = pc0;
    let is i64 as sp with mut = sp0;
    let is i64 as res with mut = -1;
    while (1 == 1) {
        let is i64 as op = r.code[pc * 3];
        let is i64 as a = r.code[pc * 3 + 1];
        let is i64 as b = r.code[pc * 3 + 2];
        let is i64 as ok with mut = 1;
