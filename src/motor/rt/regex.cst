    }
    if (k.neg == 1) { return 1 - hit; }
    return hit;
}
fn rx_shift_in(at0 as i64) as void {
    // Room for one instruction at at0; jumps inside what moves are relative, so they hold.
    let is *Rx as r = rxc;
