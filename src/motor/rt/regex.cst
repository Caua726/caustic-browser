    return v;
}
fn rx_escape_char() as i64 {
    // The character an escape stands for; rxi is on the character after the backslash.
    let is i64 as c = cast(i64, rxp[rxi]);
    if (c >= 128) { let is i64 as cp = cp_at(rxp, rxi, rxn); rxi = rxi + cplen(c); return cp; }
    rxi = rxi + 1;
    if (c == 110) { return 10; }
    if (c == 116) { return 9; }
    if (c == 114) { return 13; }
    if (c == 102) { return 12; }
    if (c == 118) { return 11; }
    if (c == 48) { return 0; }
    if (c == 120) { return rx_hex(2, c); }
    if (c == 117) {
        if (rxi < rxn && cast(i64, rxp[rxi]) == 123) {
            rxi = rxi + 1;
            let is i64 as big with mut = 0;
            while (rxi < rxn && cast(i64, rxp[rxi]) != 125) {
                let is i64 as h = cast(i64, rxp[rxi]);
                let is i64 as dv with mut = 0;
                if (h >= 48 && h <= 57) { dv = h - 48; } else { dv = (h | 32) - 87; }
                big = big * 16 + dv;
                rxi = rxi + 1;
            }
            rxi = rxi + 1;
            return big;
        }
        let is i64 as v = rx_hex(4, c);
