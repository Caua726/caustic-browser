            let is i64 as k = cast(i64, rxp[rxi + 1]);
            if (k == 58) { rxi = rxi + 2; rx_alt(); rxi = rxi + 1; return; }
            if (k == 61 || k == 33) {
                rxi = rxi + 2;
                let is i64 as l = rx_emit(RX_LOOK, cast(i64, k == 33), 0);
                rx_alt();
                rxi = rxi + 1;
                rx_emit(RX_MATCH, 0, 0);
                rx_set(l, cast(i64, k == 33), rxc.n - l - 1);
                return;
            }
            if (k == 60 && rxi + 2 < rxn && cast(i64, rxp[rxi + 2]) != 61 && cast(i64, rxp[rxi + 2]) != 33) {
                let is i64 as st = rxi + 2;
                let is i64 as e0 with mut = st;
                while (e0 < rxn && cast(i64, rxp[e0]) != 62) { e0 = e0 + 1; }
                rxc.ngroups = rxc.ngroups + 1;
                let is i64 as g = rxc.ngroups;
                let is i64 as pair = arr_new(2);
                arr_push(pair, str_new(cast(i64, rxp) + st, e0 - st));
                arr_push(pair, box_i(g));
                if (rxc.names == UNDEF) { rxc.names = arr_new(2); }
                arr_push(rxc.names, pair);
                rxi = e0 + 1;
