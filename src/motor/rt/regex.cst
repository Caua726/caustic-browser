    let is i64 as i with mut = 0;
    while (i < n) { rx_emit(RX_CHAR, cast(i64, b[i]), 0); i = i + 1; }
}
fn rx_class() as void {
    let is *RxCls as k = cls_new();
    if (rxi < rxn && cast(i64, rxp[rxi]) == 94) { k.neg = 1; rxi = rxi + 1; }
    while (rxi < rxn && cast(i64, rxp[rxi]) != 93) {
        let is i64 as ch with mut = cast(i64, rxp[rxi]);
