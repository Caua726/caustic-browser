}
fn fold(c as i64) as i64 { if (c >= 65 && c <= 90) { return c + 32; } return c; }
// Backtracking with an explicit stack of (pc, sp) choices and undo records.
let is i64 as RXS_MAX with imut = 4194304;
fn rx_grow(st as *i64, stcap as i64, top as i64) as *i64 {
    if (stcap >= RXS_MAX) { syscall(11, st, stcap * 16); rx_err("regular expression stack overflow"); }
    let is *i64 as ns = cast(*i64, os_map(stcap * 32));
