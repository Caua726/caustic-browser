        rx_alt();
        rxi = rxi + 1;
        rx_emit(RX_SAVE, g * 2 + 1, 0);
        return;
    }
    rxi = rxi + 1;
    if (c == 46) { if (rxc.dotall == 1) { rx_emit(RX_ANYNL, 0, 0); } else { rx_emit(RX_ANY, 0, 0); } return; }
