        let is i64 as mk = r.nmarks;
        r.nmarks = r.nmarks + 1;
        let is i64 as sp0 = rx_emit(RX_SPLIT, 0, 0);
        rx_emit(RX_MARK, mk, 0);
        i = 0;
        while (i < len) { rx_emit(saved[i * 3], saved[i * 3 + 1], saved[i * 3 + 2]); i = i + 1; }
