}
fn rx_hex(count as i64, c as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < count && rxi < rxn) {
        let is i64 as h = cast(i64, rxp[rxi]);
        let is i64 as dv with mut = -1;
        if (h >= 48 && h <= 57) { dv = h - 48; }
