    while (i < o.len) {
        let is i64 as c = cast(i64, o.bytes[i]);
        if (c >= lo && c <= hi) { o.bytes[i] = cast(u8, c + delta); }
        else if (c == 195 && i + 1 < o.len) {
            // Latin-1 letters: the same two bytes with a different second one.
            let is i64 as c2 = cast(i64, o.bytes[i + 1]);
            if (delta > 0 && c2 >= 128 && c2 <= 158 && c2 != 151) { o.bytes[i + 1] = cast(u8, c2 + 32); }
            if (delta < 0 && c2 >= 160 && c2 <= 190 && c2 != 183) { o.bytes[i + 1] = cast(u8, c2 - 32); }
            i = i + 1;
        }
        i = i + 1;
    }
    return r;
}
fn n_lower(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return map_case(str_this(t), 65, 90, 32); }
fn n_upper(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return map_case(str_this(t), 97, 122, -32); }
fn trim_ws(s as *Str, l as i64, r as i64) as i64 {
    let is i64 as i with mut = 0;
    let is i64 as j with mut = s.len;
    if (l == 1) { while (i < j && is_space(cast(i64, s.bytes[i])) == 1) { i = i + 1; } }
    if (r == 1) { while (j > i && is_space(cast(i64, s.bytes[j - 1])) == 1) { j = j - 1; } }
    return sub_str(s, i, j);
}
fn n_trim(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return trim_ws(str_this(t), 1, 1); }
fn n_trim_start(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return trim_ws(str_this(t), 1, 0); }
fn n_trim_end(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return trim_ws(str_this(t), 0, 1); }
fn n_repeat(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
