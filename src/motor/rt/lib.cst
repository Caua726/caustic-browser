}
let is i64 as rng with mut = 88172645463325252;
fn n_random(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    rng = rng ^ (rng << 13);
    rng = rng ^ ((rng >> 7) & 144115188075855871);
    rng = rng ^ (rng << 17);
    return box_d(cast(f64, rng & 4503599627370495) / 4503599627370496.0);
}
fn n_min(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as n = rt_argc;
    if (n == 0) { return box_d(math.inf()); }
    let is f64 as r with mut = to_num_f(arg_get(0, n, a, b, c, d));
    let is i64 as i with mut = 1;
    while (i < n) {
        let is f64 as x = to_num_f(arg_get(i, n, a, b, c, d));
        if (x != x) { return box_d(x); }
        if (x < r) { r = x; }
        i = i + 1;
    }
    return box_num(r);
}
fn n_max(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
