    }
    let is i64 as src = rt_global_or_undef(lit("Array"));
    let is i64 as list = rt_fcall(get_slow(src, lit("from"), NOIC()), src, 1, a, UNDEF, UNDEF, UNDEF);
    let is *Arr as la = cast(*Arr, list);
