}
fn n_str_concat(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as n = rt_argc;
    let is i64 as args = rt_rest(0, n, a, b, c, d);
    let is i64 as out with mut = cast(i64, str_this(t));
    let is i64 as i with mut = 0;
