// Tasks: microtasks run when the stack is empty, timers when the browser says it is time.
let is i64 as micro with mut = 10;
let is i64 as micro_at with mut = 0;
let is i64 as timers with mut = 10;
let is i64 as next_timer with mut = 1;
struct Timer { id as i64; when as f64; every as f64; f as i64; args as i64; live as i64; }
fn n_queue_micro(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { arr_push(micro, a); return UNDEF; }
fn run_micro() as void {
    let is *Arr as q = cast(*Arr, micro);
    while (micro_at < q.len) {
        let is i64 as f = q.data[micro_at];
        micro_at = micro_at + 1;
