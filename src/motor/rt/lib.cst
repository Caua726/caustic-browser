    while (i < n - 1) {
        let is i64 as v with mut = UNDEF;
        if (i == 0) { v = a; } else if (i == 1) { v = b; } else if (i == 2) { v = c; } else if (i == 3) { v = d; } else { v = rt_xget(i - 4, n); }
        if (i > 0) { params = str_concat(params, lit(",")); }
        params = str_concat(params, to_str(v));
        i = i + 1;
    }
    let is i64 as body with mut = lit("");
    if (n > 0) {
        let is i64 as v with mut = UNDEF;
        i = n - 1;
        if (i == 0) { v = a; } else if (i == 1) { v = b; } else if (i == 2) { v = c; } else if (i == 3) { v = d; } else { v = rt_xget(i - 4, n); }
        body = to_str(v);
    }
    let is i64 as text with mut = str_concat(lit("(function anonymous("), params);
