        let is i64 as x = r.data[i];
        if (x != UNDEF && x != NULLV) { out = str_concat(out, to_str(x)); }
        i = i + 1;
    }
    return out;
}
fn n_arr_tostring(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return n_join(e, t, UNDEF, UNDEF, UNDEF, UNDEF); }
fn n_is_array(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (is_ptr(a) == 1 && kind_of(a) == K_PROXY) { return n_is_array(e, t, cast(*Obj, a).env[0], b, c, d); }
    return box_b(cast(i32, is_ptr(a) == 1 && kind_of(a) == K_ARR));
}
fn n_array(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as n = rt_argc;
