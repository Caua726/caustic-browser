        if (j == w.len) { s.cu = 0; s.cb = 0; return box_i(b2u(s, i)); }
        i = i - 1;
    }
    return box_i(-1);
}
fn n_includes(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Str as s = str_this(t);
    return box_b(cast(i32, find_bytes(s, str_of(a), u2b(s, clamp_index(b, s_ulen(s), 0))) >= 0));
}
fn n_starts_with(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
