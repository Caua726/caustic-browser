fn find_bytes(s as *Str, w as *Str, from as i64) as i64 {
    let is i64 as i with mut = from;
    while (i + w.len <= s.len) {
        let is i64 as j with mut = 0;
        while (j < w.len && cast(i64, s.bytes[i + j]) == cast(i64, w.bytes[j])) { j = j + 1; }
        if (j == w.len) { return i; }
        i = i + 1;
    }
    return -1;
}
fn n_str_index_of(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Str as s = str_this(t);
    let is i64 as r = find_bytes(s, str_of(a), u2b(s, clamp_index(b, s_ulen(s), 0)));
