fn n_clear_timer(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (is_num(a) == 0) { return UNDEF; }
    let is i64 as id = cast(i64, to_num_f(a));
    let is *Arr as q = cast(*Arr, timers);
    let is i64 as i with mut = 0;
    while (i < q.len) {
        let is *Timer as x = cast(*Timer, q.data[i]);
        if (x.id == id) { x.live = 0; }
        i = i + 1;
    }
    return UNDEF;
}
fn n_raf(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as args = arr_new(1);
    arr_push(args, box_d(clock_ms(1) - t_origin + 16.0));
    return box_i(add_timer(a, 16.0, -1.0, args));
}
// How long until a timer is due, in ms, or -1 when none is waiting.
fn js_next_timer() as i64 {
    let is *Arr as q = cast(*Arr, timers);
    let is f64 as best with mut = -1.0;
    let is i64 as w with mut = 0;
    let is i64 as i with mut = 0;
    while (i < q.len) {
        let is *Timer as x = cast(*Timer, q.data[i]);
        if (x.live == 1) {
            q.data[w] = q.data[i];
            w = w + 1;
            if (best < 0.0 || x.when < best) { best = x.when; }
        }
        i = i + 1;
    }
    q.len = w;
    if (best < 0.0) { return -1; }
    let is f64 as left = best - clock_ms(1);
    if (left <= 0.0) { return 0; }
    return cast(i64, left) + 1;
}
// Every timer due now, in the order they were set, each with the microtasks it leaves.
fn js_tick() as i64 {
    let is i64 as anchor = 0;
    gc_stack_top = cast(i64, &anchor) + 1024;
    let is f64 as now = clock_ms(1);
    let is *Arr as q = cast(*Arr, timers);
    let is i64 as n = q.len;
    let is i64 as ran with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is *Timer as x = cast(*Timer, q.data[i]);
        if (x.live == 1 && x.when <= now) {
            if (x.every >= 0.0) { x.when = now + x.every; } else { x.live = 0; }
            let is ex.Frame as fr;
            let is i64 as code = ex.begin(&fr);
            if (code != 0) { report_uncaught(code); }
            else {
                ex.enter(&fr);
                rt_apply(x.f, UNDEF, x.args);
                ex.leave(&fr);
            }
            run_micro();
            ran = ran + 1;
        }
        i = i + 1;
    }
    flush();
    return ran;
}

// The table behind Map and Set: any value as a key, by identity, and text by its content.
// Nothing moves, so an object's address is its identity.
struct HTab { keys as *i64; vals as *i64; cap as i64; used as i64; }
let is i64 as H_TOMB with imut = 18;
fn h_norm(k as i64) as i64 {
    if (is_num(k) == 1) {
        let is f64 as x = to_num_f(k);
        if (x != x) { return box_d(math.nan()); }
        if (x == 0.0) { return box_i(0); }
        return box_num(x);
    }
    if (is_ptr(k) == 1 && kind_of(k) == K_STR) { return intern(k); }
    return k;
}
fn h_slot(h as *HTab, k as i64) as i64 {
    let is i64 as m = h.cap - 1;
    let is i64 as x = k * 11400714819323198485;
    let is i64 as i with mut = (x ^ (x >> 29)) & m;
    let is i64 as first_del with mut = -1;
    while (1 == 1) {
        let is i64 as e = h.keys[i];
        if (e == 0) { if (first_del >= 0) { return first_del; } return i; }
        if (e == k) { return i; }
        if (e == H_TOMB && first_del < 0) { first_del = i; }
        i = (i + 1) & m;
    }
    return 0;
}
fn n_hnew(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *HTab as h = cast(*HTab, alloc(sizeof(HTab)));
    h.cap = 16;
    h.keys = cast(*i64, alloc(128));
    h.vals = cast(*i64, alloc(128));
    h.used = 0;
    let is i64 as box = obj_new();
    cast(*Obj, box).env = cast(*i64, h);
    return box;
}
fn n_hget(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *HTab as h = cast(*HTab, cast(*Obj, a).env);
    let is i64 as k = h_norm(b);
    let is i64 as i = h_slot(h, k);
    if (h.keys[i] == k) { return h.vals[i]; }
    return UNDEF;
}
fn n_hset(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *HTab as h = cast(*HTab, cast(*Obj, a).env);
    if ((h.used + 1) * 2 > h.cap) {
        let is i64 as oc = h.cap;
        let is *i64 as ok = h.keys;
        let is *i64 as ov = h.vals;
        h.cap = oc * 2;
        h.keys = cast(*i64, alloc(h.cap * 8));
        h.vals = cast(*i64, alloc(h.cap * 8));
        h.used = 0;
        let is i64 as q with mut = 0;
        while (q < oc) {
            if (ok[q] != 0 && ok[q] != H_TOMB) {
                let is i64 as j = h_slot(h, ok[q]);
                h.keys[j] = ok[q];
                h.vals[j] = ov[q];
                h.used = h.used + 1;
            }
            q = q + 1;
        }
    }
    let is i64 as k = h_norm(b);
    let is i64 as i = h_slot(h, k);
    if (h.keys[i] == 0) { h.used = h.used + 1; }
    h.keys[i] = k;
    h.vals[i] = c;
    return UNDEF;
}
fn n_hdel(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *HTab as h = cast(*HTab, cast(*Obj, a).env);
    let is i64 as k = h_norm(b);
    let is i64 as i = h_slot(h, k);
    if (h.keys[i] != k) { return FALSEV; }
    h.keys[i] = H_TOMB;
    h.vals[i] = UNDEF;
    return TRUEV;
}
