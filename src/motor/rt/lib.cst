    ar.kind = K_TYPED;
    ar.proto = pr;
    ar.shape = root_for(pr);
    ar.env = cast(*i64, kind);
    if (is_num(a) == 1) {
        let is i64 as n = cast(i64, to_num_f(a));
        let is i64 as i with mut = 0;
        while (i < n) { arr_push(r, box_i(0)); i = i + 1; }
