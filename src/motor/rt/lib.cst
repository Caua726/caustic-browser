    let is i64 as i with mut = 0;
    while (i < n) { arr_push(r, cast(*Arr, args).data[i]); i = i + 1; }
    return r;
}

// Strings. Text is bytes here: indexes count bytes, so UTF-8 past ASCII counts differently
// from what the language promises.
fn str_this(t as i64) as *Str {
    if (is_ptr(t) == 1 && kind_of(t) == K_STR) { return cast(*Str, t); }
    if (t == UNDEF || t == NULLV) { rt_error("TypeError", "string method on undefined or null"); }
    return str_of(t);
}
fn sub_str(s as *Str, i as i64, j as i64) as i64 {
    if (j <= i) { return lit(""); }
    return str_raw(cast(i64, s.bytes) + i, j - i);
}
fn idx_of(a as i64) as i64 {
    if (a == UNDEF) { return 0; }
    let is f64 as x = to_num_f(a);
    if (x != x) { return 0; }
    if (x > 9000000000000.0 || x < -9000000000000.0) { return -1; }
    return cast(i64, x);
}
fn n_char_code_at(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as u = unit_at(str_this(t), idx_of(a));
    if (u < 0) { return box_d(math.nan()); }
    return box_i(u);
}
fn n_code_point_at(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Str as s = str_this(t);
    let is i64 as i = idx_of(a);
    let is i64 as u = unit_at(s, i);
    if (u < 0) { return UNDEF; }
    if (u >= 55296 && u < 56320 && s_ulen(s) != s.len && s.cu == i) { return box_i(cp_at(s.bytes, s.cb, s.len)); }
    return box_i(u);
}
fn n_char_at(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as r = geti_slow(cast(i64, str_this(t)), box_i(idx_of(a)));
    if (r == UNDEF) { return lit(""); }
    return r;
}
fn from_units(n as i64, a as i64, b as i64, c as i64, d as i64, mask as i64) as i64 {
    let is i64 as args = rt_rest(0, n, a, b, c, d);
    let is i64 as out with mut = lit("");
    let is i64 as i with mut = 0;
    while (i < n) {
