fn n_substring(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Str as s = str_this(t);
    let is i64 as ul = s_ulen(s);
    let is i64 as i = clamp_index(a, ul, 0);
    let is i64 as j = clamp_index(b, ul, ul);
