}
fn n_str_value(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return cast(i64, str_this(t)); }
fn n_string(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (rt_argc == 0) { return lit(""); }
    if (is_ptr(a) == 1 && kind_of(a) == K_SYM) { return str_concat(str_concat(lit("Symbol("), to_str(cast(*Sym, a).desc)), lit(")")); }
    return to_str(a);
}

// Numbers.
fn n_number(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (rt_argc == 0) { return box_i(0); }
    return box_num(to_num_f(a));
}
fn n_boolean(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return box_b(rt_truthy(a)); }
fn n_is_nan(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { let is f64 as x = to_num_f(a); return box_b(cast(i32, x != x)); }
fn finite_f(x as f64) as i32 { if (x == x && x <= 1.7976931348623157e308 && x >= -1.7976931348623157e308) { return 1; } return 0; }
fn n_is_finite(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return box_b(finite_f(to_num_f(a))); }
fn n_num_is_nan(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { if (is_num(a) == 0) { return FALSEV; } return n_is_nan(e, t, a, b, c, d); }
fn n_num_is_finite(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { if (is_num(a) == 0) { return FALSEV; } return n_is_finite(e, t, a, b, c, d); }
fn n_num_is_int(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (is_num(a) == 0) { return FALSEV; }
    let is f64 as x = to_num_f(a);
    if (finite_f(x) == 0) { return FALSEV; }
    return box_b(cast(i32, math.floor(x) == x));
}
fn n_parse_float(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return box_num(parse_num(str_of(a), 0)); }
fn n_parse_int(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Str as s = str_of(a);
    let is i64 as radix with mut = to_i32(b);
    let is i64 as i with mut = 0;
    while (i < s.len && is_space(cast(i64, s.bytes[i])) == 1) { i = i + 1; }
    let is f64 as sign with mut = 1.0;
    if (i < s.len && cast(i64, s.bytes[i]) == 45) { sign = -1.0; i = i + 1; }
    else if (i < s.len && cast(i64, s.bytes[i]) == 43) { i = i + 1; }
    if ((radix == 0 || radix == 16) && i + 1 < s.len && cast(i64, s.bytes[i]) == 48 && (cast(i64, s.bytes[i + 1]) | 32) == 120) { i = i + 2; radix = 16; }
    if (radix == 0) { radix = 10; }
    if (radix < 2 || radix > 36) { return box_d(math.nan()); }
    let is f64 as r with mut = 0.0;
    let is i64 as seen with mut = 0;
    while (i < s.len) {
        let is i64 as c0 = cast(i64, s.bytes[i]);
        let is i64 as dv with mut = 99;
        if (c0 >= 48 && c0 <= 57) { dv = c0 - 48; }
        else if ((c0 | 32) >= 97 && (c0 | 32) <= 122) { dv = (c0 | 32) - 87; }
        if (dv >= radix) { break; }
        r = r * cast(f64, radix) + cast(f64, dv);
        seen = 1;
        i = i + 1;
    }
    if (seen == 0) { return box_d(math.nan()); }
    return box_num(sign * r);
}
fn n_num_tostring(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as radix with mut = 10;
    if (a != UNDEF) { radix = to_i32(a); }
    if (radix == 10) { return to_str(t); }
    let is f64 as x0 = to_num_f(t);
    let is f64 as x with mut = x0;
    if (x < 0.0) { x = 0.0 - x; }
    let is f64 as ip = math.floor(x);
    let is f64 as fr with mut = x - ip;
    let is [128]u8 as b0;
    let is i64 as p with mut = 64;
    let is f64 as w with mut = ip;
    if (w == 0.0) { p = p - 1; b0[p] = cast(u8, 48); }
    while (w > 0.0 && p > 0) {
        let is i64 as dg = cast(i64, math.fmod(w, cast(f64, radix)));
        p = p - 1;
        if (dg < 10) { b0[p] = cast(u8, 48 + dg); } else { b0[p] = cast(u8, 87 + dg); }
        w = math.floor(w / cast(f64, radix));
    }
    if (x0 < 0.0) { p = p - 1; b0[p] = cast(u8, 45); }
    let is i64 as q with mut = 64;
    if (fr > 0.0) {
        b0[q] = cast(u8, 46); q = q + 1;
        let is i64 as lim with mut = 0;
        while (fr > 0.0 && lim < 52 && q < 127) {
            fr = fr * cast(f64, radix);
            let is i64 as dg = cast(i64, fr);
            if (dg < 10) { b0[q] = cast(u8, 48 + dg); } else { b0[q] = cast(u8, 87 + dg); }
            q = q + 1;
            fr = fr - cast(f64, dg);
            lim = lim + 1;
        }
    }
    return str_new(cast(i64, &b0) + p, q - p);
}
fn n_to_fixed(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as nd with mut = 0;
    if (a != UNDEF) { nd = to_i32(a); }
    let is f64 as x = to_num_f(t);
    if (finite_f(x) == 0 || x >= 1e21 || x <= -1e21) { return to_str(t); }
    let is f64 as ab with mut = x;
    if (ab < 0.0) { ab = 0.0 - ab; }
    let is f64 as sc with mut = 1.0;
    let is i64 as k with mut = 0;
    while (k < nd) { sc = sc * 10.0; k = k + 1; }
    let is f64 as sv = math.floor(ab * sc + 0.5);
    let is i64 as dig = to_str(box_num(sv));
    let is *Str as ds = cast(*Str, dig);
    let is i64 as neg = cast(i64, x < 0.0 && sv != 0.0);
    let is i64 as out with mut = lit("");
    if (neg == 1) { out = lit("-"); }
    if (nd == 0) { return str_concat(out, dig); }
    let is i64 as pad with mut = nd + 1 - ds.len;
    let is i64 as digits with mut = dig;
    while (pad > 0) { digits = str_concat(lit("0"), digits); pad = pad - 1; }
    let is *Str as dd = cast(*Str, digits);
    let is i64 as intl = dd.len - nd;
    out = str_concat(out, sub_str(dd, 0, intl));
    out = str_concat(out, lit("."));
    return str_concat(out, sub_str(dd, intl, dd.len));
}
fn n_value_self(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return t; }
fn n_bool_tostring(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return to_str(t); }

// Symbols.
let is i64 as sym_reg with mut = 10;
fn sym_new(desc as i64) as i64 {
    let is *Sym as s = cast(*Sym, alloc(sizeof(Sym)));
    s.kind = K_SYM; s.shape = 1; s.desc = desc;
    return cast(i64, s);
}
fn n_symbol(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (a == UNDEF) { return sym_new(lit("")); }
    return sym_new(to_str(a));
}
fn n_symbol_for(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as key = intern(to_str(a));
    let is *Obj as r = cast(*Obj, sym_reg);
    let is i64 as i = shape_find(r.shape, key);
    if (i >= 0) { return r.slots[i]; }
    let is i64 as s = sym_new(key);
    obj_add(r, key, s);
    return s;
}
fn n_symbol_tostring(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    return str_concat(str_concat(lit("Symbol("), to_str(cast(*Sym, t).desc)), lit(")"));
}
fn n_symbol_desc(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return cast(*Sym, t).desc; }

// Object.
fn n_object(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (is_obj(a) == 1) { return a; }
    return obj_new();
}
fn n_keys(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (a == UNDEF || a == NULLV) { return rt_error("TypeError", "Cannot convert undefined or null to object"); }
    return own_keys(a, 1, 0);
}
fn n_names(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return own_keys(a, 0, 0); }
fn n_own_symbols(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return own_keys(a, 0, 1); }
fn n_values(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Arr as ks = cast(*Arr, own_keys(a, 1, 0));
    let is i64 as r = arr_new(ks.len);
    let is i64 as i with mut = 0;
    while (i < ks.len) { arr_push(r, get_slow(a, ks.data[i], NOIC())); i = i + 1; }
    return r;
}
fn n_entries(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Arr as ks = cast(*Arr, own_keys(a, 1, 0));
    let is i64 as r = arr_new(ks.len);
    let is i64 as i with mut = 0;
    while (i < ks.len) {
        let is i64 as p = arr_new(2);
        arr_push(p, ks.data[i]);
        arr_push(p, get_slow(a, ks.data[i], NOIC()));
        arr_push(r, p);
        i = i + 1;
    }
    return r;
}
fn n_assign(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as n = rt_argc;
    let is i64 as args = rt_rest(0, n, a, b, c, d);
    let is i64 as i with mut = 1;
    while (i < n) {
        let is i64 as src = cast(*Arr, args).data[i];
        if (src != UNDEF && src != NULLV) {
            let is *Arr as ks = cast(*Arr, own_keys(src, 1, 0));
            let is i64 as j with mut = 0;
            while (j < ks.len) { rt_seti(a, ks.data[j], get_slow(src, ks.data[j], NOIC())); j = j + 1; }
            let is *Arr as sy = cast(*Arr, own_keys(src, 1, 1));
            j = 0;
            while (j < sy.len) { set_slow(a, sy.data[j], get_slow(src, sy.data[j], NOIC()), NOIC()); j = j + 1; }
        }
        i = i + 1;
    }
    return a;
}
fn n_create(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (is_obj(a) == 0 && a != NULLV) { return rt_error("TypeError", "Object prototype may only be an Object or null"); }
    let is i64 as o = obj_with(a, root_for(a));
    if (b != UNDEF) { define_props(o, b); }
    return o;
}
fn n_get_proto(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (is_ptr(a) == 1) {
        if (kind_of(a) == K_STR) { return P_STRING; }
        if (kind_of(a) == K_SYM) { return P_SYMBOL; }
        return cast(*Obj, a).proto;
    }
    if ((a & NUM_TAG) != 0) { return P_NUMBER; }
    if (a == TRUEV || a == FALSEV) { return P_BOOLEAN; }
    return rt_error("TypeError", "Cannot convert undefined or null to object");
}
fn n_set_proto(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { rt_set_proto(a, b); return a; }
fn define_one(o as i64, kv as i64, desc as i64) as void {
    if (is_obj(o) == 0) { rt_error("TypeError", "defineProperty on a non-object"); return; }
    let is i64 as key = key_of(kv);
    let is *Obj as ob = cast(*Obj, o);
    let is i64 as g = get_slow(desc, S_get, NOIC());
    let is i64 as s = get_slow(desc, S_set, NOIC());
    let is i64 as ev = get_slow(desc, S_enumerable, NOIC());
    let is i64 as have = shape_find(ob.shape, key);
    // What the descriptor does not say stays as it was, or is off on a new property.
    let is i64 as flags with mut = P_NONENUM | P_RO | P_NOCONF;
    if (have >= 0) { flags = shape_flags(ob.shape, key); }
    let is i64 as wv = get_slow(desc, S_writable, NOIC());
    let is i64 as cv = get_slow(desc, S_configurable, NOIC());
    if (ev != UNDEF) { flags = flags & (~P_NONENUM); if (rt_truthy(ev) == 0) { flags = flags | P_NONENUM; } }
    if (wv != UNDEF) { flags = flags & (~P_RO); if (rt_truthy(wv) == 0) { flags = flags | P_RO; } }
    if (cv != UNDEF) { flags = flags & (~P_NOCONF); if (rt_truthy(cv) == 0) { flags = flags | P_NOCONF; } }
    if (g != UNDEF || s != UNDEF) {
        rt_def_accessor(o, key, g, s, cast(i64, (flags & P_NONENUM) == 0));
        return;
    }
    let is i64 as v = get_slow(desc, S_value, NOIC());
    if (have >= 0) {
        let is i64 as is_acc = cast(i64, cast(i64, acc_of(ob.slots[have])) != 0);
        if (own_has(desc, S_value) == 1 || is_acc == 1) { ob.slots[have] = v; }
        if (shape_flags(ob.shape, key) != flags) { shape_rebuild(ob, 0, key, flags, 0); }
        return;
    }
    if (kind_of(o) == K_ARR && kind_of(key) == K_STR && str_index_of_key(key) >= 0) { rt_seti(o, box_i(str_index_of_key(key)), v); return; }
    obj_add_flags(ob, key, v, flags);
}
fn define_props(o as i64, descs as i64) as void {
    let is *Arr as ks = cast(*Arr, own_keys(descs, 1, 0));
    let is i64 as i with mut = 0;
    while (i < ks.len) { define_one(o, ks.data[i], get_slow(descs, ks.data[i], NOIC())); i = i + 1; }
}
fn n_define_property(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { define_one(a, b, c); return a; }
fn n_define_properties(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { define_props(a, b); return a; }
fn n_get_own_desc(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as key = key_of(b);
    if (own_has(a, key) == 0) { return UNDEF; }
    let is i64 as r = obj_new();
    if (is_obj(a) == 1 && shape_find(cast(*Obj, a).shape, key) >= 0) {
        let is *Obj as ob = cast(*Obj, a);
        let is i64 as val = ob.slots[shape_find(ob.shape, key)];
        let is *Acc as ac = acc_of(val);
        if (cast(i64, ac) != 0) {
            rt_seti(r, S_get, ac.getter);
            rt_seti(r, S_set, ac.setter);
        } else {
            rt_seti(r, S_value, val);
            rt_seti(r, S_writable, box_b(cast(i32, ob.frozen == 0 && (shape_flags(ob.shape, key) & P_RO) == 0)));
        }
        rt_seti(r, S_enumerable, box_b(cast(i32, (shape_flags(ob.shape, key) & P_NONENUM) == 0)));
        rt_seti(r, S_configurable, box_b(cast(i32, ob.frozen == 0 && (shape_flags(ob.shape, key) & P_NOCONF) == 0)));
        return r;
    }
    rt_seti(r, S_value, get_slow(a, key, NOIC()));
    rt_seti(r, S_writable, TRUEV);
    rt_seti(r, S_enumerable, box_b(cast(i32, key != S_length)));
    rt_seti(r, S_configurable, box_b(cast(i32, key != S_length)));
    return r;
}
fn n_freeze(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (is_obj(a) == 1) {
        let is *Obj as o = cast(*Obj, a);
        if (o.frozen == 0) {
            // A shape of its own, or a write the cache remembers would still go through.
            shape_rebuild(o, 0, 0, 0, 1);
            o.frozen = 1;
        }
    }
    return a;
}
