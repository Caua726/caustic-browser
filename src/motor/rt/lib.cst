    if (n == 0) { return box_d(math.neg_inf()); }
    let is f64 as r with mut = to_num_f(arg_get(0, n, a, b, c, d));
    let is i64 as i with mut = 1;
    while (i < n) {
        let is f64 as x = to_num_f(arg_get(i, n, a, b, c, d));
        if (x != x) { return box_d(x); }
        if (x > r) { r = x; }
        i = i + 1;
    }
    return box_num(r);
}
fn n_imul(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return box_i(cast(i64, cast(i32, to_i32(a) * to_i32(b)))); }

// Arrays.
fn arr_real(t as i64) as i64 { return cast(i64, is_ptr(t) == 1 && (kind_of(t) == K_ARR || kind_of(t) == K_TYPED)); }
// Array methods work on anything with a length: arguments, a NodeList, a string. Such a thing
// is read into an array first, and the methods that change it write it back with like_back.
fn arr_like(t as i64) as i64 {
    if (t == UNDEF || t == NULLV) { rt_error("TypeError", "Array.prototype method called on null or undefined"); }
    let is f64 as lf = to_num_f(rt_geti(t, S_length));
    let is i64 as n with mut = 0;
    if (lf > 0.0) { n = cast(i64, lf); }
    if (n > 67108864) { rt_error("RangeError", "Invalid array length"); }
    let is i64 as o = arr_new(n);
    let is i64 as i with mut = 0;
    while (i < n) { arr_push(o, rt_geti(t, box_i(i))); i = i + 1; }
    return o;
}
fn like_back(t as i64, o as i64, was as i64) as void {
    let is *Arr as r = cast(*Arr, o);
    let is i64 as i with mut = 0;
    while (i < r.len) { rt_seti(t, box_i(i), r.data[i]); i = i + 1; }
    while (i < was) { rt_delete(t, box_i(i)); i = i + 1; }
    rt_seti(t, S_length, box_i(r.len));
}
fn arr_this(t as i64) as *Arr {
    if (arr_real(t) == 1) { return cast(*Arr, t); }
    return cast(*Arr, arr_like(t));
}
fn n_push(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (arr_real(t) == 0) {
        let is i64 as argc = rt_argc;
        let is i64 as tmp = arr_like(t);
        let is i64 as was = cast(*Arr, tmp).len;
        rt_argc = argc;
        let is i64 as res = n_push(e, tmp, a, b, c, d);
        like_back(t, tmp, was);
        return res;
    }
    let is i64 as n = rt_argc;
    arr_this(t);
    if (n > 4) {
        let is i64 as args = rt_rest(0, n, a, b, c, d);
        let is i64 as i with mut = 0;
        while (i < n) { arr_push(t, cast(*Arr, args).data[i]); i = i + 1; }
        return box_i(cast(*Arr, t).len);
    }
    if (n >= 1) { arr_push(t, a); }
    if (n >= 2) { arr_push(t, b); }
    if (n >= 3) { arr_push(t, c); }
    if (n >= 4) { arr_push(t, d); }
    return box_i(cast(*Arr, t).len);
}
fn n_pop(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (arr_real(t) == 0) {
        let is i64 as argc = rt_argc;
        let is i64 as tmp = arr_like(t);
        let is i64 as was = cast(*Arr, tmp).len;
        rt_argc = argc;
        let is i64 as res = n_pop(e, tmp, a, b, c, d);
        like_back(t, tmp, was);
        return res;
    }
    let is *Arr as r = arr_this(t);
    if (r.len == 0) { return UNDEF; }
    r.len = r.len - 1;
    return r.data[r.len];
}
fn n_shift(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (arr_real(t) == 0) {
        let is i64 as argc = rt_argc;
        let is i64 as tmp = arr_like(t);
        let is i64 as was = cast(*Arr, tmp).len;
        rt_argc = argc;
        let is i64 as res = n_shift(e, tmp, a, b, c, d);
        like_back(t, tmp, was);
        return res;
    }
    let is *Arr as r = arr_this(t);
    if (r.len == 0) { return UNDEF; }
    let is i64 as v = r.data[0];
    let is i64 as i with mut = 1;
    while (i < r.len) { r.data[i - 1] = r.data[i]; i = i + 1; }
    r.len = r.len - 1;
    return v;
}
fn n_unshift(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (arr_real(t) == 0) {
        let is i64 as argc = rt_argc;
        let is i64 as tmp = arr_like(t);
        let is i64 as was = cast(*Arr, tmp).len;
        rt_argc = argc;
        let is i64 as res = n_unshift(e, tmp, a, b, c, d);
        like_back(t, tmp, was);
        return res;
    }
    let is i64 as n = rt_argc;
    let is i64 as args = rt_rest(0, n, a, b, c, d);
    let is *Arr as r = arr_this(t);
    let is i64 as i with mut = 0;
    while (i < n) { arr_push(t, UNDEF); i = i + 1; }
    i = r.len - 1;
    while (i >= n) { r.data[i] = r.data[i - n]; i = i - 1; }
    i = 0;
    while (i < n) { r.data[i] = cast(*Arr, args).data[i]; i = i + 1; }
    return box_i(r.len);
}
fn rel_index(v as i64, n as i64, dflt as i64) as i64 {
    if (v == UNDEF) { return dflt; }
    let is f64 as d = to_num_f(v);
    if (d != d) { return 0; }
    let is i64 as i with mut = 0;
    if (d > 9000000000000.0) { i = n; }
    else if (d < -9000000000000.0) { i = 0 - n; }
    else { i = cast(i64, d); }
    if (i < 0) { i = i + n; if (i < 0) { i = 0; } }
    if (i > n) { i = n; }
    return i;
}
fn n_arr_slice(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Arr as r = arr_this(t);
    let is i64 as i with mut = rel_index(a, r.len, 0);
    let is i64 as j = rel_index(b, r.len, r.len);
    let is i64 as o = arr_new(j - i);
    while (i < j) { arr_push(o, r.data[i]); i = i + 1; }
    return o;
}
fn n_splice(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    if (arr_real(t) == 0) {
        let is i64 as argc = rt_argc;
        let is i64 as tmp = arr_like(t);
        let is i64 as was = cast(*Arr, tmp).len;
        rt_argc = argc;
        let is i64 as res = n_splice(e, tmp, a, b, c, d);
        like_back(t, tmp, was);
        return res;
    }
    let is i64 as n = rt_argc;
    let is i64 as args = rt_rest(0, n, a, b, c, d);
    let is *Arr as r = arr_this(t);
    let is i64 as st = rel_index(a, r.len, 0);
    let is i64 as cnt with mut = r.len - st;
    if (n >= 2) {
        let is f64 as dc = to_num_f(b);
        cnt = 0;
        if (dc > 0.0) { if (dc > cast(f64, r.len - st)) { cnt = r.len - st; } else { cnt = cast(i64, dc); } }
    }
    if (n == 0) { cnt = 0; }
    let is i64 as out = arr_new(cnt);
    let is i64 as i with mut = 0;
    while (i < cnt) { arr_push(out, r.data[st + i]); i = i + 1; }
    let is i64 as ins with mut = n - 2;
    if (ins < 0) { ins = 0; }
    let is i64 as old = r.len;
    let is i64 as delta = ins - cnt;
    if (delta > 0) {
        i = 0;
        while (i < delta) { arr_push(t, UNDEF); i = i + 1; }
        i = old - 1;
        while (i >= st + cnt) { r.data[i + delta] = r.data[i]; i = i - 1; }
    } else if (delta < 0) {
        i = st + cnt;
        while (i < old) { r.data[i + delta] = r.data[i]; i = i + 1; }
        r.len = old + delta;
    }
    i = 0;
    while (i < ins) { r.data[st + i] = cast(*Arr, args).data[i + 2]; i = i + 1; }
    return out;
}
fn n_concat(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as n = rt_argc;
    let is i64 as args = rt_rest(0, n, a, b, c, d);
    let is i64 as o = arr_new(8);
    let is *Arr as r = arr_this(t);
    let is i64 as i with mut = 0;
    while (i < r.len) { arr_push(o, r.data[i]); i = i + 1; }
    i = 0;
    while (i < n) {
        let is i64 as x = cast(*Arr, args).data[i];
        if (is_ptr(x) == 1 && kind_of(x) == K_ARR) {
            let is *Arr as ax = cast(*Arr, x);
            let is i64 as j with mut = 0;
            while (j < ax.len) { arr_push(o, ax.data[j]); j = j + 1; }
        } else { arr_push(o, x); }
        i = i + 1;
    }
    return o;
}
fn n_index_of(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Arr as r = arr_this(t);
    let is i64 as i with mut = rel_index(b, r.len, 0);
    while (i < r.len) { if (rt_seq(r.data[i], a) == 1) { return box_i(i); } i = i + 1; }
    return box_i(-1);
}
fn n_join(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is *Arr as r = arr_this(t);
    let is i64 as sep with mut = lit(",");
