fn n_exp(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return box_d(math.exp(to_num_f(a))); }
fn n_pow(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return rt_pow(a, b); }
fn n_clz32(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
