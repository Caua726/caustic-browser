// Time.
fn clock_ms(which as i64) as f64 {
    let is [2]i64 as ts;
    syscall(228, which, &ts);
    return cast(f64, ts[0]) * 1000.0 + cast(f64, ts[1]) / 1000000.0;
}
fn n_now(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return box_d(math.floor(clock_ms(0))); }
let is f64 as t_origin with mut = 0.0;
