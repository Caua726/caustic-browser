// Names and lengths of functions, in a table the generated code fills the first time anyone asks.
let is i64 as nm_tab with mut = 0;
let is i64 as NM_SZ with imut = 262144;
fn rt_nm(code as *u8, name as i64, plen as i64) as void {
    let is i64 as k = cast(i64, code);
    let is i64 as i with mut = ((k >> 4) * 2654435761) & (NM_SZ - 1);
    while (*cast(*i64, nm_tab + i * 24) != 0) { i = (i + 1) & (NM_SZ - 1); }
    *cast(*i64, nm_tab + i * 24) = k;
    *cast(*i64, nm_tab + i * 24 + 8) = name;
    *cast(*i64, nm_tab + i * 24 + 16) = plen;
}
fn nm_find(t as i64) as i64 {
    if (is_ptr(t) == 0 || kind_of(t) != K_FN) { return 0; }
    if (nm_tab == 0) {
        nm_tab = os_map(NM_SZ * 24);
        js_names();
        let is i64 as ei with mut = 0;
        while (ei < ev_n) { call(cast(*u8, ev_names[ei])); ei = ei + 1; }
    }
    let is i64 as k = cast(i64, cast(*Obj, t).code);
    let is i64 as i with mut = ((k >> 4) * 2654435761) & (NM_SZ - 1);
    while (1 == 1) {
        let is i64 as x = *cast(*i64, nm_tab + i * 24);
        if (x == 0) { return 0; }
        if (x == k) { return nm_tab + i * 24; }
        i = (i + 1) & (NM_SZ - 1);
    }
    return 0;
}
