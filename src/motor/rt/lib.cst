fn clamp_index(v as i64, n as i64, dflt as i64) as i64 {
    if (v == UNDEF) { return dflt; }
    let is f64 as d = to_num_f(v);
    if (d != d || d < 0.0) { return 0; }
    if (d > cast(f64, n)) { return n; }
    return cast(i64, d);
