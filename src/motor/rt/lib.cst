fn str_of(v as i64) as *Str { return cast(*Str, to_str(v)); }
fn n_log(env as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as n = rt_argc;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (i > 0) { out_byte(32); }
        print_value(arg_get(i, n, a, b, c, d));
        i = i + 1;
    }
    out_byte(10);
    flush();
    return UNDEF;
}
fn n_sqrt(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return box_num(__builtin_sqrt(to_num_f(a))); }
fn n_floor(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { if ((a >> 49) == -1) { return a; } return box_num(math.floor(to_num_f(a))); }
