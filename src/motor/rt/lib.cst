// Typed arrays: an array that keeps every element in its type's range. Views of one buffer
// do not share memory here.
fn typed_coerce(kind as i64, v as i64) as i64 {
    let is f64 as x = to_num_f(v);
    if (kind == 9) { return box_num(x); }
    if (kind == 8) { return box_num(cast(f64, cast(f32, x))); }
    if (kind == 3) {
        if (x != x || x <= 0.0) { return box_i(0); }
        if (x >= 255.0) { return box_i(255); }
        return box_i(cast(i64, math.floor(x + 0.5)));
    }
    let is i64 as w = to_i32(box_num(x));
    if (kind == 1) { return box_i(((w & 255) ^ 128) - 128); }
    if (kind == 2) { return box_i(w & 255); }
    if (kind == 4) { return box_i(((w & 65535) ^ 32768) - 32768); }
    if (kind == 5) { return box_i(w & 65535); }
    if (kind == 6) { return box_i(w); }
    return box_num(cast(f64, w & 4294967295));
}
fn n_typed(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
