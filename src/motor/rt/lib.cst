        if (nm_tab != 0) { call(cast(*u8, info[5])); }
    }
    let is i64 as was = rt_ev_value;
    rt_ev_value = UNDEF;
    call(top);
    let is i64 as out = rt_ev_value;
    rt_ev_value = was;
    return out;
