fn n_round(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { if ((a >> 49) == -1) { return a; } return box_num(math.floor(to_num_f(a) + 0.5)); }
fn n_trunc(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
