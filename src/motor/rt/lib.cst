// eval and new Function: text is translated and compiled by the browser, linked to this runtime,
// and run here. It sees the global scope only, as an indirect eval does, wherever it is called.
fn eval_text(text as *Str) as i64 {
    let is [10]i64 as info;
    info[0] = cast(i64, text.bytes); info[1] = text.len; info[2] = cast(i64, fn_ptr(eval_text));
    info[3] = 0; info[4] = 0; info[5] = 0; info[6] = 0; info[7] = 0;
    if (call(hc(H_EVAL), cast(i64, &info)) == 0) {
        if (info[3] != 0) { return rt_error("SyntaxError", cast(*u8, info[3])); }
        return rt_error("EvalError", "the compiler refused the text");
    }
    let is *u8 as top = cast(*u8, info[6]);
