// Prototype JS runtime. Values are NaN-boxed i64. No GC: a bump allocator never frees.
use "std/math.cst" as math;
use "std/exceptions.cst" as ex;

struct Shape { parent as *Shape; key as i64; idx as i64; count as i64; kids as *Shape; sib as *Shape; flags as i64; nkids as i64; ix as *i64; ixmask as i64; jump as *Shape; }
struct Obj { kind as i64; shape as *Shape; slots as *i64; proto as i64; cap as i64; kid_root as *Shape; code as *u8; env as *i64; frozen as i64; }
struct Str { kind as i64; shape as i64; len as i64; bytes as *u8; canon as i64; hash as i64; ulen1 as i64; cu as i64; cb as i64; }
struct Arr { kind as i64; shape as *Shape; slots as *i64; proto as i64; cap as i64; kid_root as *Shape; code as *u8; env as *i64; frozen as i64; len as i64; acap as i64; data as *i64; }
struct Acc { kind as i64; shape as i64; getter as i64; setter as i64; }
struct Sym { kind as i64; shape as i64; desc as i64; }
struct Cursor { kind as i64; shape as i64; subject as i64; idx as i64; mode as i64; next_fn as i64; }

let is i64 as K_OBJ with imut = 1;
let is i64 as K_FN  with imut = 2;
let is i64 as K_STR with imut = 3;
let is i64 as K_ARR with imut = 4;
let is i64 as K_HOST with imut = 5;
let is i64 as K_ACC with imut = 6;
let is i64 as K_SYM with imut = 7;
let is i64 as K_CURSOR with imut = 8;
let is i64 as K_STYLE with imut = 9;
let is i64 as K_REGEX with imut = 10;
let is i64 as K_PROXY with imut = 11;
let is i64 as K_TYPED with imut = 12;
let is i64 as P_NONENUM with imut = 1;
let is i64 as P_RO with imut = 2;
let is i64 as P_NOCONF with imut = 4;

let is i64 as NUM_TAG with imut = -562949953421312;
let is i64 as DBL_OFF with imut = 562949953421312;
let is i64 as PTR_MASK with imut = -562949953421297;
let is i64 as NULLV with imut = 2;
let is i64 as FALSEV with imut = 6;
let is i64 as TRUEV with imut = 7;
let is i64 as UNDEF with imut = 10;
// What eval added to this runtime, and the value of the one running.
let is i64 as EV_MAX with imut = 4096;
let is [4096]i64 as ev_roots with mut;
let is [4096]i64 as ev_names with mut;
let is i64 as ev_n with mut = 0;
let is i64 as rt_ev_value with mut = 10;
let is *u8 as rt_call_name with mut = cast(*u8, 0);
let is i64 as rt_call_key with mut = 0;

fn copy_bytes(d as i64, s as i64, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { *cast(*u8, d + i) = *cast(*u8, s + i); i = i + 1; }
}

// ── Boxing ──
fn f64_box_raw(x as f64) as i64 { return *cast(*i64, &x) + DBL_OFF; }
fn box_d(x as f64) as i64 {
    if (x != x) { return 9221120237041090560 + DBL_OFF; }
    return f64_box_raw(x);
}
fn unbox_d(v as i64) as f64 {
    let is i64 as b = v - DBL_OFF;
    return *cast(*f64, &b);
}
fn is_int(v as i64) as i32 { if ((v >> 49) == -1) { return 1; } return 0; }
fn is_num(v as i64) as i32 { if ((v & NUM_TAG) != 0) { return 1; } return 0; }
fn is_ptr(v as i64) as i32 { if ((v & PTR_MASK) == 0) { return 1; } return 0; }
fn box_i(x as i64) as i64 { return NUM_TAG + (x & 4294967295); }
fn int_of(v as i64) as i64 { return cast(i64, cast(i32, v)); }
fn box_b(c as i32) as i64 { if (c != 0) { return TRUEV; } return FALSEV; }
fn kind_of(v as i64) as i64 { return cast(*Obj, v).kind; }
fn box_num(x as f64) as i64 {
    if (x >= -2147483648.0 && x <= 2147483647.0) {
        let is i64 as i = cast(i64, x);
        if (cast(f64, i) == x && (i != 0 || *cast(*i64, &x) == 0)) { return box_i(i); }
    }
    return box_d(x);
}

// ── Output ──
let is [65536]u8 as obuf with mut;
let is i64 as olen with mut = 0;
fn flush() as void { if (olen > 0) { syscall(1, 1, &obuf, olen); olen = 0; } }
fn out_byte(c as i64) as void { if (olen >= 65536) { flush(); } obuf[olen] = cast(u8, c); olen = olen + 1; }
fn cstrlen(s as *u8) as i64 { let is i64 as n with mut = 0; while (cast(i64, s[n]) != 0) { n = n + 1; } return n; }
fn out_c(s as *u8) as void { let is i64 as i with mut = 0; while (cast(i64, s[i]) != 0) { out_byte(cast(i64, s[i])); i = i + 1; } }
fn die(msg as *u8) as i64 { return rt_error("Error", msg); }

// ── Strings ──
let is i64 as INTERN_SZ with imut = 1048576;
let is i64 as itab with mut = 0;
fn str_raw(bytes as i64, n as i64) as i64 {
    let is *Str as s = cast(*Str, alloc(sizeof(Str)));
    s.kind = K_STR; s.shape = 1; s.len = n; s.bytes = cast(*u8, bytes); s.canon = 0; s.hash = 0;
    return cast(i64, s);
}
fn str_new(src as i64, n as i64) as i64 {
    let is i64 as b = byte_alloc(n);
    copy_bytes(b, src, n);
    return str_raw(b, n);
}
fn str_hash(s as *Str) as i64 {
    if (s.hash != 0) { return s.hash; }
    let is i64 as h with mut = 2166136261;
    let is i64 as i with mut = 0;
    while (i < s.len) { h = ((h ^ cast(i64, s.bytes[i])) * 16777619) & 4294967295; i = i + 1; }
    if (h == 0) { h = 1; }
    s.hash = h;
    return h;
}
fn bytes_eq(a as *Str, b as *Str) as i32 {
    if (a.len != b.len) { return 0; }
    let is i64 as i with mut = 0;
    while (i < a.len) { if (cast(i64, a.bytes[i]) != cast(i64, b.bytes[i])) { return 0; } i = i + 1; }
    return 1;
}
fn intern(v as i64) as i64 {
    let is *Str as s = cast(*Str, v);
    if (s.canon != 0) { return s.canon; }
    let is i64 as i with mut = str_hash(s) & (INTERN_SZ - 1);
    while (1 == 1) {
        let is i64 as e = *cast(*i64, itab + i * 8);
        if (e == 0) { *cast(*i64, itab + i * 8) = v; s.canon = v; return v; }
        if (bytes_eq(cast(*Str, e), s) == 1) { s.canon = e; return e; }
        i = (i + 1) & (INTERN_SZ - 1);
    }
    return 0;
}
fn lit(s as *u8) as i64 { return intern(str_new(cast(i64, s), cstrlen(s))); }
// Text is kept as UTF-8. The language counts in UTF-16 units, so a string knows how many
// it has (plus one; zero is not counted yet) and where the last index it was asked for lies.
fn cplen(c as i64) as i64 {
    if (c < 192) { return 1; }
    if (c < 224) { return 2; }
    if (c < 240) { return 3; }
    return 4;
}
fn s_ulen(s as *Str) as i64 {
    if (s.ulen1 == 0) {
        let is i64 as n with mut = 0;
        let is i64 as i with mut = 0;
        while (i < s.len) {
            let is i64 as c = cast(i64, s.bytes[i]);
            if (c < 128) { n = n + 1; i = i + 1; }
            else {
                if (c >= 240) { n = n + 1; }
                n = n + 1;
                i = i + cplen(c);
            }
        }
        s.ulen1 = n + 1;
    }
    return s.ulen1 - 1;
}
// The byte where a unit starts. Inside an astral character, that character's start.
fn u2b(s as *Str, ui as i64) as i64 {
    let is i64 as ul = s_ulen(s);
    if (ul == s.len) { return ui; }
    if (ui <= 0) { s.cu = 0; s.cb = 0; return 0; }
    if (ui >= ul) { return s.len; }
    let is i64 as u with mut = 0;
    let is i64 as b with mut = 0;
    if (s.cu <= ui) { u = s.cu; b = s.cb; }
    while (u < ui) {
        let is i64 as c = cast(i64, s.bytes[b]);
        let is i64 as w with mut = 1;
        if (c >= 240) { w = 2; }
        if (u + w > ui) { break; }
        u = u + w;
        b = b + cplen(c);
    }
    s.cu = u;
    s.cb = b;
    return b;
}
fn b2u(s as *Str, bi as i64) as i64 {
    if (s_ulen(s) == s.len) { return bi; }
    let is i64 as u with mut = 0;
    let is i64 as b with mut = 0;
    if (s.cb <= bi) { u = s.cu; b = s.cb; }
    while (b < bi) {
        let is i64 as c = cast(i64, s.bytes[b]);
        if (c >= 240) { u = u + 1; }
        u = u + 1;
        b = b + cplen(c);
    }
    s.cu = u;
    s.cb = b;
    return u;
}
fn cp_at(s as *u8, b as i64, n as i64) as i64 {
    let is i64 as c = cast(i64, s[b]);
    if (c < 192 || b + cplen(c) > n) { return c; }
    if (c < 224) { return ((c & 31) << 6) | (cast(i64, s[b + 1]) & 63); }
    if (c < 240) { return ((c & 15) << 12) | ((cast(i64, s[b + 1]) & 63) << 6) | (cast(i64, s[b + 2]) & 63); }
    return ((c & 7) << 18) | ((cast(i64, s[b + 1]) & 63) << 12) | ((cast(i64, s[b + 2]) & 63) << 6) | (cast(i64, s[b + 3]) & 63);
}
fn cp_put(to as *u8, u as i64) as i64 {
    if (u < 128) { to[0] = cast(u8, u); return 1; }
    if (u < 2048) { to[0] = cast(u8, 192 | (u >> 6)); to[1] = cast(u8, 128 | (u & 63)); return 2; }
    if (u < 65536) { to[0] = cast(u8, 224 | (u >> 12)); to[1] = cast(u8, 128 | ((u >> 6) & 63)); to[2] = cast(u8, 128 | (u & 63)); return 3; }
    to[0] = cast(u8, 240 | (u >> 18)); to[1] = cast(u8, 128 | ((u >> 12) & 63)); to[2] = cast(u8, 128 | ((u >> 6) & 63)); to[3] = cast(u8, 128 | (u & 63));
    return 4;
}
// The unit at an index, or -1 past the end.
fn unit_at(s as *Str, i as i64) as i64 {
    if (i < 0 || i >= s_ulen(s)) { return -1; }
    if (s.ulen1 - 1 == s.len) { return cast(i64, s.bytes[i]); }
    let is i64 as b = u2b(s, i);
    let is i64 as cp = cp_at(s.bytes, b, s.len);
    if (cp < 65536) { return cp; }
    if (s.cu == i) { return 55296 + ((cp - 65536) >> 10); }
    return 56320 + ((cp - 65536) & 1023);
}
fn str_concat(av as i64, bv as i64) as i64 {
    let is *Str as a = cast(*Str, av);
    let is *Str as b = cast(*Str, bv);
    if (b.len == 0) { return av; }
    if (a.len == 0) { return bv; }
    // Two halves of one character, cut apart by indexing, join back into it.
    if (cast(i64, b.bytes[0]) == 237 && b.len >= 3 && a.len >= 3 && cast(i64, a.bytes[a.len - 3]) == 237) {
        let is i64 as hi = cp_at(a.bytes, a.len - 3, a.len);
        let is i64 as lo = cp_at(b.bytes, 0, b.len);
        if (hi >= 55296 && hi < 56320 && lo >= 56320 && lo < 57344) {
            let is [4]u8 as m;
            cp_put(cast(*u8, &m), 65536 + ((hi - 55296) << 10) + (lo - 56320));
            let is i64 as left = str_concat(str_raw(cast(i64, a.bytes), a.len - 3), str_new(cast(i64, &m), 4));
            return str_concat(left, str_raw(cast(i64, b.bytes) + 3, b.len - 3));
        }
    }
    let is i64 as n = a.len + b.len;
    let is i64 as ab = cast(i64, a.bytes);
    // Already side by side in the arena: nothing to copy.
    if (ab + a.len == cast(i64, b.bytes)) { return str_raw(ab, n); }
    // The prefix is immutable, so a string at the top of the arena can grow in place.
    if (ab + a.len == byte_p && byte_p + b.len <= byte_end && byte_p != 0) {
        copy_bytes(byte_p, cast(i64, b.bytes), b.len);
        byte_p = byte_p + b.len;
        return str_raw(ab, n);
    }
    let is i64 as d = byte_alloc(n);
    copy_bytes(d, ab, a.len);
    copy_bytes(d + a.len, cast(i64, b.bytes), b.len);
    return str_raw(d, n);
}
let is [64]u8 as nbuf with mut;
fn int_str(x as i64) as i64 {
    let is i64 as v with mut = x;
    if (v < 0) { v = 0 - v; }
    let is i64 as p with mut = 63;
    if (v == 0) { nbuf[p] = cast(u8, 48); p = p - 1; }
    while (v > 0) { nbuf[p] = cast(u8, 48 + v % 10); v = v / 10; p = p - 1; }
    if (x < 0) { nbuf[p] = cast(u8, 45); p = p - 1; }
    return str_new(cast(i64, &nbuf) + p + 1, 63 - p);
}
