fn event_stays(ty as i64) as i64 {
    let is i64 as k = intern(ty);
    let is i64 as i with mut = 0;
    while (i < 7) {
        if (stays_key[i] == k) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn event_new(ty as i64, target as i64) as i64 {
    let is i64 as ev = obj_with(P_EVENT, root_for(P_EVENT));
    let is *Obj as o = cast(*Obj, ev);
    obj_add(o, S_type, ty);
    obj_add(o, S_target, target);
    obj_add(o, S_currentTarget, NULLV);
    obj_add(o, S_phase, box_i(0));
    obj_add(o, S_bubbles, box_b(cast(i32, event_stays(ty) == 0)));
    obj_add(o, lit("cancelable"), box_b(cast(i32, event_stays(ty) == 0)));
    obj_add(o, S_prevented, FALSEV);
    obj_add(o, lit("isTrusted"), TRUEV);
    obj_add(o, lit("timeStamp"), box_d(clock_ms(1) - t_origin));
    return ev;
}
fn call_guarded(f as i64, w as i64, evt as i64) as void {
    let is ex.Frame as fr;
    let is i64 as code = ex.begin(&fr);
    if (code != 0) { report_uncaught(code); }
    else {
        ex.enter(&fr);
        rt_fcall(f, w, 1, evt, UNDEF, UNDEF, UNDEF);
        ex.leave(&fr);
    }
    run_micro();
}
fn listeners_run(w as i64, evt as i64, ty as i64, phase as i64, capture as i64) as i64 {
    let is *Obj as o = cast(*Obj, w);
    if (phase >= 2 && capture == 0) {
        // el.onclick and its kin, when something set one.
        let is i64 as hi = shape_find(o.shape, intern(str_concat(lit("on"), ty)));
        if (hi >= 0 && is_ptr(o.slots[hi]) == 1 && kind_of(o.slots[hi]) == K_FN) {
            set_slow(evt, S_currentTarget, w, NOIC());
            set_slow(evt, S_phase, box_i(phase), NOIC());
            call_guarded(o.slots[hi], w, evt);
        }
    }
    let is i64 as i = shape_find(o.shape, S_listeners);
    if (i < 0) { return 0; }
    let is *Arr as l = cast(*Arr, o.slots[i]);
    set_slow(evt, S_currentTarget, w, NOIC());
    set_slow(evt, S_phase, box_i(phase), NOIC());
    let is i64 as ran with mut = 0;
    let is i64 as j with mut = 0;
    let is i64 as n = l.len;
    while (j < n && j < l.len) {
        let is i64 as is_cap = cast(i64, l.data[j + 2] == TRUEV);
        if (l.data[j] == ty && is_cap == capture) {
            ran = 1;
            call_guarded(l.data[j + 1], w, evt);
            if (get_slow(evt, S_stop_now, NOIC()) == TRUEV) { break; }
        }
        j = j + 3;
    }
    return ran;
}
// Capture from the window down, the target, bubbling back up.
fn fire_event(target_w as i64, evt as i64) as i64 {
    let is i64 as ty = intern(to_str(get_slow(evt, S_type, NOIC())));
    set_slow(evt, S_target, target_w, NOIC());
    let is i64 as path = arr_new(16);
    let is i64 as node with mut = node_of(target_w);
    while (node != 0) { arr_push(path, wrap(node)); node = call(hc(H_PARENT), node); }
    // A picture's or a frame's load is not the window's, not even on the way down.
    if (ty != stays_key[0]) { arr_push(path, G_global); }
    let is *Arr as pa = cast(*Arr, path);
    let is i64 as bubbles = cast(i64, rt_truthy(get_slow(evt, S_bubbles, NOIC())));
    let is i64 as ran with mut = 0;
    let is i64 as i with mut = pa.len - 1;
    while (i > 0) {
        ran = ran | listeners_run(pa.data[i], evt, ty, 1, 1);
        if (get_slow(evt, S_stop, NOIC()) == TRUEV) { return ran; }
        i = i - 1;
    }
    ran = ran | listeners_run(pa.data[0], evt, ty, 2, 1);
    if (get_slow(evt, S_stop_now, NOIC()) != TRUEV) { ran = ran | listeners_run(pa.data[0], evt, ty, 2, 0); }
    if (bubbles == 0) { return ran; }
    i = 1;
    while (i < pa.len) {
        if (get_slow(evt, S_stop, NOIC()) == TRUEV) { return ran; }
        ran = ran | listeners_run(pa.data[i], evt, ty, 3, 0);
        i = i + 1;
    }
    return ran;
}
fn dom_init() as void {
    wrap_sz = 65536;
    wrap_tab = os_map(wrap_sz * 16);
    S_listeners = lit("__listeners"); S_stop = lit("__stop"); S_stop_now = lit("__stopNow"); S_prevented = lit("defaultPrevented");
    S_target = lit("target"); S_currentTarget = lit("currentTarget"); S_type = lit("type"); S_phase = lit("eventPhase"); S_bubbles = lit("bubbles");
    doc_state = lit("loading");
    K_width = lit("width"); K_height = lit("height");
    stays_key[0] = lit("load"); stays_key[1] = lit("error"); stays_key[2] = lit("focus"); stays_key[3] = lit("blur");
    stays_key[4] = lit("mouseenter"); stays_key[5] = lit("mouseleave"); stays_key[6] = lit("readystatechange");
    S_style_cache = lit("__style"); S_cssText = lit("cssText"); S_title = lit("title");
    an("id", "id"); an("className", "class"); an("rel", "rel"); an("href", "=href"); an("src", "=src"); an("srcdoc", "srcdoc"); an("type", "type");
    an("media", "media"); an("value", "value"); an("integrity", "integrity"); an("referrerPolicy", "referrerpolicy"); an("crossOrigin", "-crossorigin");
    an("alt", "alt"); an("title", "title"); an("name", "name"); an("placeholder", "placeholder"); an("htmlFor", "for");
    an("defaultValue", "value"); an("frameBorder", "frameborder"); an("scrolling", "scrolling"); an("allow", "allow"); an("sandbox", "sandbox"); an("allowFullscreen", "allowfullscreen"); an("lang", "lang"); an("dir", "dir"); an("action", "=action"); an("method", "method"); an("role", "role");
    an("tabIndex", "tabindex"); an("width", "width"); an("height", "height"); an("download", "download"); an("min", "min"); an("max", "max");
    an("disabled", "*disabled"); an("checked", "*checked"); an("selected", "*selected"); an("hidden", "*hidden"); an("readOnly", "*readonly");
    an("required", "*required"); an("multiple", "*multiple"); an("autofocus", "*autofocus"); an("open", "*open"); an("defaultChecked", "*checked");
    let is [40]*u8 as names;
    names[0] = "textContent"; names[1] = "innerHTML"; names[2] = "tagName"; names[3] = "nodeName"; names[4] = "localName"; names[5] = "relList";
    names[6] = "parentNode"; names[7] = "parentElement"; names[8] = "nodeType"; names[9] = "firstChild"; names[10] = "lastChild"; names[11] = "nextSibling";
    names[12] = "previousSibling"; names[13] = "firstElementChild"; names[14] = "lastElementChild"; names[15] = "nextElementSibling"; names[16] = "previousElementSibling";
    names[17] = "childNodes"; names[18] = "children"; names[19] = "ownerDocument"; names[20] = "namespaceURI"; names[21] = "style"; names[22] = "nodeValue"; names[23] = "data";
    names[24] = "isConnected"; names[25] = "classList"; names[26] = "defaultView"; names[27] = "body"; names[28] = "head"; names[29] = "documentElement"; names[30] = "readyState";
    names[31] = "activeElement"; names[32] = "location"; names[33] = "%unused"; names[34] = "URL"; names[35] = "cookie"; names[36] = "offsetWidth"; names[37] = "offsetHeight";
    names[38] = "%unused2"; names[39] = "%unused3";
    let is i64 as i with mut = 0;
    while (i < NK_MAX) { nk[i] = lit(names[i]); i = i + 1; }
    P_NODE = obj_new();
    def_n(P_NODE, "appendChild", fn_ptr(n_append)); def_n(P_NODE, "insertBefore", fn_ptr(n_insert_before)); def_n(P_NODE, "removeChild", fn_ptr(n_remove_child));
    def_n(P_NODE, "replaceChild", fn_ptr(n_replace_child)); def_n(P_NODE, "remove", fn_ptr(n_remove)); def_n(P_NODE, "contains", fn_ptr(n_contains));
    def_n(P_NODE, "cloneNode", fn_ptr(n_clone)); def_n(P_NODE, "addEventListener", fn_ptr(n_listen)); def_n(P_NODE, "removeEventListener", fn_ptr(n_unlisten));
    def_n(P_NODE, "dispatchEvent", fn_ptr(n_dispatch)); def_n(P_NODE, "querySelector", fn_ptr(n_query)); def_n(P_NODE, "querySelectorAll", fn_ptr(n_query_all));
    def_n(P_NODE, "getElementsByTagName", fn_ptr(n_by_tag)); def_n(P_NODE, "getElementsByClassName", fn_ptr(n_by_class));
    P_ELEMENT = obj_with(P_NODE, root_for(P_NODE));
    def_n(P_ELEMENT, "getAttribute", fn_ptr(n_get_attr)); def_n(P_ELEMENT, "hasAttribute", fn_ptr(n_has_attr)); def_n(P_ELEMENT, "setAttribute", fn_ptr(n_set_attr));
    def_n(P_ELEMENT, "setAttributeNS", fn_ptr(n_set_attr_ns)); def_n(P_ELEMENT, "removeAttribute", fn_ptr(n_del_attr)); def_n(P_ELEMENT, "removeAttributeNS", fn_ptr(n_del_attr_ns));
    def_n(P_ELEMENT, "focus", fn_ptr(n_focus)); def_n(P_ELEMENT, "blur", fn_ptr(n_blur)); def_n(P_ELEMENT, "click", fn_ptr(n_click));
    def_n(P_ELEMENT, "getBoundingClientRect", fn_ptr(n_rect));
    P_DOCUMENT = obj_with(P_NODE, root_for(P_NODE));
    def_n(P_DOCUMENT, "createElement", fn_ptr(n_create_el)); def_n(P_DOCUMENT, "createElementNS", fn_ptr(n_create_ns)); def_n(P_DOCUMENT, "createTextNode", fn_ptr(n_create_text));
    def_n(P_DOCUMENT, "createComment", fn_ptr(n_create_comment)); def_n(P_DOCUMENT, "createDocumentFragment", fn_ptr(n_create_fragment));
    def_n(P_DOCUMENT, "getElementById", fn_ptr(n_by_id));
    P_EVENT = obj_new();
    def_n(P_EVENT, "preventDefault", fn_ptr(n_prevent)); def_n(P_EVENT, "stopPropagation", fn_ptr(n_stop)); def_n(P_EVENT, "stopImmediatePropagation", fn_ptr(n_stop_now));
    def_n(P_EVENT, "initEvent", fn_ptr(n_noop));
    def_prop(P_EVENT, "ctrlKey", FALSEV); def_prop(P_EVENT, "shiftKey", FALSEV); def_prop(P_EVENT, "altKey", FALSEV); def_prop(P_EVENT, "metaKey", FALSEV);
    def_prop(P_EVENT, "clientX", box_i(0)); def_prop(P_EVENT, "clientY", box_i(0)); def_prop(P_EVENT, "pageX", box_i(0)); def_prop(P_EVENT, "pageY", box_i(0));
    def_prop(P_EVENT, "screenX", box_i(0)); def_prop(P_EVENT, "screenY", box_i(0)); def_prop(P_EVENT, "button", box_i(0)); def_prop(P_EVENT, "buttons", box_i(0));
    def_prop(P_EVENT, "detail", box_i(0)); def_prop(P_EVENT, "relatedTarget", NULLV); def_prop(P_EVENT, "key", lit("")); def_prop(P_EVENT, "code", lit(""));
    def_prop(P_EVENT, "which", box_i(0)); def_prop(P_EVENT, "keyCode", box_i(0)); def_prop(P_EVENT, "composed", TRUEV);
    def_n(P_EVENT, "composedPath", fn_ptr(n_event_path));
    P_COMPUTED = obj_new();
    def_n(P_COMPUTED, "getPropertyValue", fn_ptr(n_computed_prop));
    computed_key[0] = lit("display"); computed_key[1] = lit("position"); computed_key[2] = lit("visibility"); computed_key[3] = lit("width"); computed_key[4] = lit("height");
    computed_key[5] = lit("opacity"); computed_key[6] = lit("fontSize"); computed_key[7] = lit("color"); computed_key[8] = lit("backgroundColor");
    computed_key[9] = lit("marginTop");
    computed_key[10] = lit("marginRight");
    computed_key[11] = lit("marginBottom");
    computed_key[12] = lit("marginLeft");
    computed_key[13] = lit("paddingTop");
    computed_key[14] = lit("paddingRight");
    computed_key[15] = lit("paddingBottom");
    computed_key[16] = lit("paddingLeft");
    computed_key[17] = lit("borderTopWidth");
    computed_key[18] = lit("borderRightWidth");
    computed_key[19] = lit("borderBottomWidth");
    computed_key[20] = lit("borderLeftWidth");
    computed_key[21] = lit("top");
    computed_key[22] = lit("right");
    computed_key[23] = lit("bottom");
    computed_key[24] = lit("left");
    computed_key[25] = lit("overflowX");
    computed_key[26] = lit("overflowY");
    computed_key[27] = lit("boxSizing");
    computed_key[28] = lit("cssFloat");
    computed_key[29] = lit("zIndex");
    computed_key[30] = lit("fontWeight");
    computed_key[31] = lit("transitionDuration");
    computed_key[32] = lit("animationDuration");
    P_STYLE = obj_new();
    def_n(P_STYLE, "setProperty", fn_ptr(n_set_property)); def_n(P_STYLE, "getPropertyValue", fn_ptr(n_get_property)); def_n(P_STYLE, "removeProperty", fn_ptr(n_remove_property));
    V_relList = obj_new();
    def_n(V_relList, "supports", fn_ptr(n_supports));
    doc_node = call(hc(H_ROOT));
    let is i64 as g = G_global;
    // The names scripts test with instanceof and read prototypes from.
    def_prop(g, "Node", fn_with_proto(fn_ptr(n_noop), P_NODE));
    let is i64 as c_el = fn_with_proto(fn_ptr(n_noop), P_ELEMENT);
    def_prop(g, "Element", c_el); def_prop(g, "HTMLElement", c_el); def_prop(g, "SVGElement", c_el);
    def_prop(g, "Document", fn_with_proto(fn_ptr(n_noop), P_DOCUMENT));
    let is i64 as p_iframe = obj_new();
    def_prop(g, "HTMLIFrameElement", fn_with_proto(fn_ptr(n_noop), p_iframe));
    def_prop(g, "document", wrap(doc_node));
    def_n(g, "dispatchEvent", fn_ptr(n_dispatch_window)); def_n(g, "addEventListener", fn_ptr(n_listen)); def_n(g, "removeEventListener", fn_ptr(n_unlisten));
    def_n(g, "__fetchRaw", fn_ptr(n_fetch_raw));
    def_n(g, "__imgInfo", fn_ptr(n_img_info)); def_n(g, "getComputedStyle", fn_ptr(n_get_computed)); def_n(g, "matchMedia", fn_ptr(n_match_media)); def_n(g, "getSelection", fn_ptr(n_get_selection));
    let is i64 as ev_ctor = fn_with_proto(fn_ptr(n_event), P_EVENT);
    def_prop(g, "Event", ev_ctor);
    def_prop(g, "innerWidth", box_i(call(hc(H_VIEWPORT), 0)));
    def_prop(g, "innerHeight", box_i(call(hc(H_VIEWPORT), 1)));
    def_prop(g, "devicePixelRatio", box_i(1));
    let is i64 as nav = obj_new();
    if (cast(i64, host_t) != 0) { rt_seti(nav, lit("userAgent"), host_str(H_URL, 2)); }
    else { rt_seti(nav, lit("userAgent"), lit("CausticBrowser")); }
    if (cast(i64, host_t) != 0) { rt_seti(nav, lit("language"), host_str(H_URL, 3)); }
    else { rt_seti(nav, lit("language"), lit("en")); }
    rt_seti(nav, lit("platform"), lit("Linux"));
    def_prop(g, "navigator", nav);
    if (cast(i64, host_t) != 0) {
        def_n(g, "__navigate", fn_ptr(n_navigate));
        def_n(g, "__frame", fn_ptr(n_frame));
        def_n(g, "__curScript", fn_ptr(n_cur_script));
        def_n(g, "__runScriptSlot", fn_ptr(n_run_slot));
        def_n(g, "__attrs", fn_ptr(n_attrs));
        def_n(g, "__formSubmit", fn_ptr(n_form_submit));
        def_n(g, "__randomU32", fn_ptr(n_random_u32));
        def_n(g, "__framePost", fn_ptr(n_frame_post));
    }
    V_location = obj_new();
    rt_seti(V_location, lit("href"), host_str(H_URL, 0));
    def_prop(g, "location", V_location);
}

// ── What the browser calls ──
fn js_main(host as *i64) as i64 {
    host_t = host;
    let is i64 as anchor = 0;
    gc_stack_top = cast(i64, &anchor) + 1024;
    rt_init();
    js_strs();
    let is ex.Frame as f;
    let is i64 as code = ex.begin(&f);
    if (code != 0) { report_uncaught(code); run_micro(); flush(); return 1; }
    ex.enter(&f);
    js_top();
    ex.leave(&f);
    run_micro();
    if (cast(i64, host_t) != 0) {
        // The document is as parsed as it will get by the time scripts run here.
        let is i64 as dw = wrap(doc_node);
        doc_state = lit("interactive");
        fire_event(dw, event_new(lit("readystatechange"), dw));
        fire_event(dw, event_new(lit("DOMContentLoaded"), dw));
        run_micro();
    }
    flush();
    return 0;
}
// Everything the document asked for has come.
fn window_load() as void {
    let is i64 as dw = wrap(doc_node);
    doc_state = lit("complete");
    fire_event(dw, event_new(lit("readystatechange"), dw));
    let is i64 as lv = event_new(lit("load"), dw);
    listeners_run(G_global, lv, lit("load"), 2, 0);
    // <body>'s handler is the window's: pages set it there as often as on the window.
    let is i64 as bd = query_one(doc_node, "body");
    if (is_ptr(bd) == 1) {
        let is i64 as bon = get_slow(bd, lit("onload"), NOIC());
        if (is_ptr(bon) == 1 && kind_of(bon) == K_FN) { call_guarded(bon, bd, lv); }
    }
}
// The event at a node: 1 when a listener ran, 2 more if it stopped the default.
// info, when there is one: x, y, button, the key's text and its length, its number.
fn js_dispatch(node as i64, tp as i64, tn as i64, info as *i64) as i64 {
    let is i64 as anchor = 0;
    gc_stack_top = cast(i64, &anchor) + 1024;
    let is ex.Frame as f;
    let is i64 as code = ex.begin(&f);
    if (code != 0) { report_uncaught(code); flush(); return 1; }
    ex.enter(&f);
    if (tn == 9 && *cast(*u8, tp) == 95) {
        window_load();
        ex.leave(&f);
        run_micro();
        flush();
        return 0;
    }
    let is i64 as w = wrap(node);
    let is i64 as evt = event_new(str_new(tp, tn), w);
    if (cast(i64, info) != 0) {
        let is *Obj as eo = cast(*Obj, evt);
        obj_add(eo, lit("clientX"), box_i(info[0])); obj_add(eo, lit("clientY"), box_i(info[1]));
        obj_add(eo, lit("pageX"), box_i(info[0])); obj_add(eo, lit("pageY"), box_i(info[1]));
        obj_add(eo, lit("button"), box_i(info[2]));
        if (info[4] > 0) {
            let is i64 as kt = str_new(info[3], info[4]);
            obj_add(eo, lit("key"), kt); obj_add(eo, lit("code"), kt);
            obj_add(eo, lit("keyCode"), box_i(info[5])); obj_add(eo, lit("which"), box_i(info[5]));
        }
    }
    let is i64 as ran = fire_event(w, evt);
    let is i64 as prevented = cast(i64, get_slow(evt, S_prevented, NOIC()) == TRUEV);
    ex.leave(&f);
    run_micro();
    flush();
    if (prevented == 1) { return ran | 2; }
    return ran;
}
// A fetch came back: status 0 when it could not be had.
// A script added by a script: the text run as a script of this page, then load or error on it.
let is i64 as cur_script with mut = 0;
fn n_cur_script(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 { return wrap(cur_script); }
fn js_run_script(data as i64, n as i64, node as i64, ok as i64) as i64 {
    let is i64 as anchor = 0;
    gc_stack_top = cast(i64, &anchor) + 1024;
    let is i64 as w = wrap(node);
    let is i64 as was = cur_script;
    if (ok != 0) {
        cur_script = node;
        let is ex.Frame as f;
        let is i64 as code = ex.begin(&f);
        if (code != 0) { report_uncaught(code); }
        else {
            ex.enter(&f);
            eval_text(cast(*Str, str_new(data, n)));
            ex.leave(&f);
        }
        cur_script = was;
    }
    if (ok != 2) {
        let is ex.Frame as g;
        let is i64 as code2 = ex.begin(&g);
        if (code2 != 0) { report_uncaught(code2); }
        else {
            ex.enter(&g);
            if (ok == 1) { fire_event(w, event_new(lit("load"), w)); }
            else { fire_event(w, event_new(lit("error"), w)); }
            ex.leave(&g);
        }
    }
    run_micro();
    flush();
    return 1;
}
// A message from another window, as JSON, for this window's listeners.
fn js_message(data as i64, n as i64, origin as i64, from as i64) as i64 {
    let is i64 as anchor = 0;
    gc_stack_top = cast(i64, &anchor) + 1024;
    let is ex.Frame as f;
    let is i64 as code = ex.begin(&f);
    if (code != 0) { report_uncaught(code); flush(); return 0; }
    ex.enter(&f);
    // What came for a port goes to the port; __msgIn has nothing for the window then.
    let is i64 as got = rt_fcall(rt_global_or_undef(lit("__msgIn")), UNDEF, 2, str_new(data, n), box_i(from), UNDEF, UNDEF);
    if (got == NULLV) { ex.leave(&f); run_micro(); flush(); return 1; }
    let is i64 as ev = event_new(lit("message"), G_global);
    rt_seti(ev, lit("data"), get_slow(got, lit("data"), NOIC()));
    rt_seti(ev, lit("origin"), str_new(origin, cstrlen(cast(*u8, origin))));
    rt_seti(ev, lit("source"), rt_fcall(rt_global_or_undef(lit("__win")), UNDEF, 1, box_i(from), UNDEF, UNDEF, UNDEF));
    rt_seti(ev, lit("lastEventId"), lit(""));
    rt_seti(ev, lit("ports"), get_slow(got, lit("ports"), NOIC()));
    listeners_run(G_global, ev, lit("message"), 2, 0);
    ex.leave(&f);
    run_micro();
    flush();
    return 1;
}
fn js_fetch_done(id as i64, status as i64, data as i64, n as i64, ctype as i64) as i64 {
    let is i64 as anchor = 0;
    gc_stack_top = cast(i64, &anchor) + 1024;
    let is ex.Frame as f;
    let is i64 as code = ex.begin(&f);
    if (code != 0) { report_uncaught(code); flush(); return 0; }
    ex.enter(&f);
    let is i64 as text = str_new(data, n);
    let is i64 as ty = str_new(ctype, cstrlen(cast(*u8, ctype)));
    rt_fcall(rt_global_or_undef(lit("__fetchDone")), UNDEF, 4, box_i(id), box_i(status), text, ty);
    ex.leave(&f);
    run_micro();
    flush();
    return 1;
}
