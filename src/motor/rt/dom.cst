// ── The document, through a table of the browser's functions ──
let is *i64 as host_t with mut = cast(*i64, 0);
let is i64 as H_QUERY with imut = 1;
let is i64 as H_QUERY_ALL with imut = 2;
let is i64 as H_SET_HTML with imut = 3;
let is i64 as H_SET_TEXT with imut = 4;
let is i64 as H_GET_TEXT with imut = 5;
let is i64 as H_GET_ATTR with imut = 6;
let is i64 as H_SET_ATTR with imut = 7;
let is i64 as H_CREATE with imut = 8;
let is i64 as H_APPEND with imut = 9;
let is i64 as H_TAG with imut = 10;
let is i64 as H_ROOT with imut = 11;
let is i64 as H_PARENT with imut = 12;
let is i64 as H_REMOVE with imut = 13;
let is i64 as H_LINK with imut = 14;        // first, last, next, prev by number
let is i64 as H_KIND with imut = 15;
let is i64 as H_TEXT_NODE with imut = 16;
let is i64 as H_INSERT with imut = 17;
let is i64 as H_DEL_ATTR with imut = 18;
let is i64 as H_GET_HTML with imut = 19;
let is i64 as H_CLONE with imut = 20;
let is i64 as H_NS with imut = 21;
let is i64 as H_CREATE_NS with imut = 22;
let is i64 as H_SET_DATA with imut = 23;
let is i64 as H_URL with imut = 25;
let is i64 as H_VIEWPORT with imut = 26;
let is i64 as H_RECT with imut = 27;
let is i64 as H_FRAGMENT with imut = 28;
let is i64 as H_COMMENT with imut = 29;
let is i64 as H_STATE with imut = 30;
let is i64 as H_FETCH with imut = 31;
let is i64 as H_EVAL with imut = 32;
let is i64 as H_COOKIE with imut = 33;
let is i64 as H_NAV with imut = 34;
let is i64 as H_FRAME with imut = 35;
let is i64 as H_ATTR with imut = 36;
let is i64 as H_SUBMIT with imut = 37;
let is i64 as H_BY_ID with imut = 38;
let is i64 as H_IMG with imut = 39;
let is i64 as H_AREA with imut = 40;
let is i64 as H_COMPUTED with imut = 24;
fn hc(i as i64) as *u8 { return cast(*u8, host_t[i]); }

let is i64 as P_NODE with mut = 10;
let is i64 as P_ELEMENT with mut = 10;
let is i64 as P_DOCUMENT with mut = 10;
let is i64 as P_EVENT with mut = 10;
let is i64 as P_STYLE with mut = 10;
let is i64 as doc_node with mut = 0;
let is i64 as wrap_tab with mut = 0;
let is i64 as wrap_sz with mut = 0;
let is i64 as wrap_n with mut = 0;
let is i64 as S_listeners with mut = 0;
let is i64 as S_stop with mut = 0;
let is i64 as S_stop_now with mut = 0;
let is i64 as S_prevented with mut = 0;
let is i64 as S_target with mut = 0;
let is i64 as S_currentTarget with mut = 0;
let is i64 as S_type with mut = 0;
let is i64 as S_phase with mut = 0;
let is i64 as S_bubbles with mut = 0;
let is i64 as S_style_cache with mut = 0;
let is i64 as S_cssText with mut = 0;
let is i64 as S_title with mut = 0;
let is i64 as V_relList with mut = 10;
let is i64 as V_location with mut = 10;

// Every name an element answers itself, as a table of interned strings. A name starting
// with * is a boolean attribute; with -, one that is null when absent.
let is [64]i64 as an_key with mut;
let is [64]*u8 as an_attr with mut;
let is i64 as an_n with mut = 0;
fn an(prop as *u8, attr as *u8) as void { an_key[an_n] = lit(prop); an_attr[an_n] = attr; an_n = an_n + 1; }
let is i64 as NK_MAX with imut = 40;
let is [40]i64 as nk with mut;
fn node_of(v as i64) as i64 {
    if (is_ptr(v) == 0 || kind_of(v) != K_HOST) { rt_error("TypeError", "not a DOM node"); return 0; }
    return cast(i64, cast(*Obj, v).env);
}
fn wrap_grow() as void {
    let is i64 as oldt = wrap_tab;
    let is i64 as olds = wrap_sz;
    wrap_sz = olds * 2;
    wrap_tab = os_map(wrap_sz * 16);
    let is i64 as i with mut = 0;
    while (i < olds) {
        let is i64 as k = *cast(*i64, oldt + i * 16);
        if (k != 0) {
            let is i64 as j with mut = ((k >> 4) * 2654435761) & (wrap_sz - 1);
            while (*cast(*i64, wrap_tab + j * 16) != 0) { j = (j + 1) & (wrap_sz - 1); }
            *cast(*i64, wrap_tab + j * 16) = k;
            *cast(*i64, wrap_tab + j * 16 + 8) = *cast(*i64, oldt + i * 16 + 8);
        }
        i = i + 1;
    }
    syscall(11, oldt, olds * 16);
}
fn wrap(node as i64) as i64 {
    if (node == 0) { return NULLV; }
    if (wrap_n * 2 >= wrap_sz) { wrap_grow(); }
    let is i64 as i with mut = ((node >> 4) * 2654435761) & (wrap_sz - 1);
    while (1 == 1) {
        let is i64 as k = *cast(*i64, wrap_tab + i * 16);
        if (k == node) { return *cast(*i64, wrap_tab + i * 16 + 8); }
        if (k == 0) { break; }
        i = (i + 1) & (wrap_sz - 1);
    }
    let is i64 as pr with mut = P_ELEMENT;
    if (node == doc_node) { pr = P_DOCUMENT; }
    else if (call(hc(H_KIND), node) != 1) { pr = P_NODE; }
    let is i64 as v = obj_with(pr, root_for(pr));
    let is *Obj as o = cast(*Obj, v);
    o.kind = K_HOST;
    o.env = cast(*i64, node);
    *cast(*i64, wrap_tab + i * 16) = node;
    *cast(*i64, wrap_tab + i * 16 + 8) = v;
    wrap_n = wrap_n + 1;
    return v;
}
fn attr_value(node as i64, name as *u8, none as i64) as i64 {
    let is i64 as out with mut = 0;
    let is i64 as n = call(hc(H_GET_ATTR), node, cast(i64, name), cstrlen(name), cast(i64, &out));
    if (n < 0) { return none; }
    return str_new(out, n);
}
fn attr_set(node as i64, name as *u8, v as i64) as void {
    let is *Str as s = str_of(v);
    call(hc(H_SET_ATTR), node, cast(i64, name), cstrlen(name), cast(i64, s.bytes), s.len);
}
fn query_one(root as i64, sel as *u8) as i64 {
    return wrap(call(hc(H_QUERY), root, cast(i64, sel), cstrlen(sel)));
}
fn node_list(node as i64, elements as i64) as i64 {
    let is i64 as r = arr_new(8);
    let is i64 as c with mut = call(hc(H_LINK), node, 0);
    while (c != 0) {
        if (elements == 0 || call(hc(H_KIND), c) == 1) { arr_push(r, wrap(c)); }
        c = call(hc(H_LINK), c, 2);
    }
    return r;
}
fn kin(node as i64, which as i64, elements as i64) as i64 {
    let is i64 as c with mut = call(hc(H_LINK), node, which);
    if (elements == 1) {
        let is i64 as step with mut = which;
        if (which == 0) { step = 2; }
        if (which == 1) { step = 3; }
        while (c != 0 && call(hc(H_KIND), c) != 1) { c = call(hc(H_LINK), c, step); }
    }
    return wrap(c);
}
fn host_str(fnum as i64, node as i64) as i64 {
    let is i64 as out with mut = 0;
    let is i64 as n = call(hc(fnum), node, cast(i64, &out));
    return str_new(out, n);
}
fn host_str_op(fnum as i64, op as i64) as i64 {
    let is i64 as out with mut = 0;
    let is i64 as n = call(hc(fnum), op, cast(i64, &out), 0);
    return str_new(out, n);
}
fn n_navigate(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    // __navigate(url, replace): where the page goes once this script has finished.
    let is *Str as u = str_of(a);
    call(hc(H_NAV), cast(i64, u.bytes), u.len, cast(i64, rt_truthy(b)));
    return UNDEF;
}
fn n_attrs(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    // __attrs(element): [name, value] of each attribute, in order.
    let is i64 as out = arr_new(4);
    let is i64 as node = node_of(a);
    let is i64 as i with mut = 0;
    while (1 == 1) {
        let is [4]i64 as at;
        if (call(hc(H_ATTR), node, i, cast(i64, &at)) == 0) { break; }
        let is i64 as pair = arr_new(2);
        arr_push(pair, str_new(at[0], at[1]));
        arr_push(pair, str_new(at[2], at[3]));
        arr_push(out, pair);
        i = i + 1;
    }
    return out;
}
fn n_form_submit(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    call(hc(H_SUBMIT), node_of(a));
    return UNDEF;
}
fn n_random_u32(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    let is [1]i64 as r;
    r[0] = 0;
    if (syscall(318, &r, 4, 0) != 4) { return rt_error("Error", "no random source"); }
    return box_d(cast(f64, r[0] & 4294967295));
}
fn n_run_slot(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    // __runScriptSlot(number): one of this page's big scripts, compiled by itself, now.
    let is i64 as r = call(hc(H_FRAME), 7, int_of(a));
    if (r == 0) { return UNDEF; }
    let is *i64 as ans = cast(*i64, r);
    eval_text(cast(*Str, str_new(ans[0], ans[1])));
    return UNDEF;
}
fn n_frame(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    // __frame(what, argument): a number. 5 is the window of an <iframe> element.
    let is i64 as op = int_of(a);
    let is i64 as arg with mut = 0;
    if (op == 5 || op == 14 || op == 15) { arg = node_of(b); }
    else if (op == 4 || op == 8 || op == 9 || op == 10 || op == 12) { arg = int_of(b); }
    // Its name, of the window with this number: a string, "" for none.
    if (op == 12) {
        let is *i64 as r = cast(*i64, call(hc(H_FRAME), op, arg));
        if (cast(i64, r) == 0) { return lit(""); }
        return str_new(r[0], r[1]);
    }
    return box_i(call(hc(H_FRAME), op, arg));
}
fn n_frame_post(e as *i64, t as i64, a as i64, b as i64, c as i64, d as i64) as i64 {
    // __framePost(window number, text, target origin).
    let is *Str as text = str_of(b);
    let is *Str as want = str_of(c);
    let is [5]i64 as info;
    info[0] = int_of(a); info[1] = cast(i64, text.bytes); info[2] = text.len; info[3] = cast(i64, want.bytes); info[4] = want.len;
    call(hc(H_FRAME), 6, cast(i64, &info));
    return UNDEF;
}
fn style_of(ov as i64) as i64 {
    let is *Obj as o = cast(*Obj, ov);
    let is i64 as i = shape_find(o.shape, S_style_cache);
    if (i >= 0) { return o.slots[i]; }
    let is i64 as st = obj_with(P_STYLE, root_for(P_STYLE));
    let is *Obj as so = cast(*Obj, st);
    so.kind = K_STYLE;
    so.env = o.env;
    obj_add_flags(o, S_style_cache, st, P_NONENUM);
    return st;
}
// 0 when this name is not one the element answers itself.
// document.f is the form named f, and form.q the field named q: what the name finds, if a
// property of that name has not already been found. 0 for nothing.
fn named_item(ov as i64, node as i64, key as i64) as i64 {
    if (is_ptr(key) == 0 || kind_of(key) != K_STR) { return 0; }
    let is *Str as ks = cast(*Str, key);
    if (ks.len == 0 || ks.len > 200) { return 0; }
    let is i64 as q with mut = 0;
    while (q < ks.len) {
        let is i64 as ch = cast(i64, ks.bytes[q]);
        let is i64 as plain = cast(i64, (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95 || ch == 45);
        if (plain == 0) { return 0; }
        q = q + 1;
    }
    // A method of the object is found after this, and is what is nearly always being asked for.
    let is i64 as pw with mut = ov;
    while (is_ptr(pw) == 1 && is_obj(pw) == 1) {
        if (shape_find(cast(*Obj, pw).shape, key) >= 0) { return 0; }
        pw = cast(*Obj, pw).proto;
    }
    let is i64 as sel with mut = 0;
    if (node == doc_node) {
        sel = str_concat(str_concat(lit("form[name=\""), key), lit("\"],img[name=\""));
        sel = str_concat(str_concat(sel, key), lit("\"],embed[name=\""));
        sel = str_concat(str_concat(sel, key), lit("\"],iframe[name=\""));
        sel = str_concat(str_concat(sel, key), lit("\"]"));
    } else {
        let is *Str as tn = cast(*Str, str_lower_tag(node));
        if (tn.len != 4 || tn.bytes[0] != 102 || tn.bytes[1] != 111 || tn.bytes[2] != 114 || tn.bytes[3] != 109) { return 0; }
        sel = str_concat(str_concat(lit("[name=\""), key), lit("\"],[id=\""));
        sel = str_concat(str_concat(sel, key), lit("\"]"));
    }
    let is *Str as ss = cast(*Str, sel);
    let is [1024]u8 as big;
    let is i64 as i with mut = 0;
    while (i < ss.len && i < 1023) { big[i] = ss.bytes[i]; i = i + 1; }
    big[i] = 0;
    let is i64 as found = call(hc(H_QUERY), node, cast(i64, &big), i);
    if (found == 0) { return 0; }
    return wrap(found);
}
fn str_lower_tag(node as i64) as i64 {
    if (call(hc(H_KIND), node) != 1) { return lit(""); }
    return host_str(H_TAG, node);
}
let is i64 as K_width with mut = 0;
let is i64 as K_height with mut = 0;
fn host_get(ov as i64, key as i64) as i64 {
    let is i64 as node = node_of(ov);
    if (node == doc_node && key == S_title) { return host_str(H_URL, 1); }
    if (key == S_value) {
        let is i64 as av with mut = 0;
        let is i64 as an2 = call(hc(H_AREA), node, 0, 0, 0, cast(i64, &av));
        if (an2 >= 0) { return str_new(av, an2); }
    }
    if (key == K_width || key == K_height) {
        let is i64 as dim = call(hc(H_IMG), node, 4 + cast(i64, key == K_height));
        if (dim >= 0) { return box_i(dim); }
    }
    let is i64 as i with mut = 0;
    while (i < an_n) {
        if (an_key[i] == key) {
            let is *u8 as at0 = an_attr[i];
            if (cast(i64, at0[0]) == 42) {
                let is i64 as out with mut = 0;
                return box_b(cast(i32, call(hc(H_GET_ATTR), node, cast(i64, at0) + 1, cstrlen(at0) - 1, cast(i64, &out)) >= 0));
            }
            if (cast(i64, at0[0]) == 45) { return attr_value(node, cast(*u8, cast(i64, at0) + 1), NULLV); }
            if (cast(i64, at0[0]) == 61) {
                // A URL reads back absolute, as the base makes it.
                let is i64 as raw = attr_value(node, cast(*u8, cast(i64, at0) + 1), lit(""));
                let is *Str as rs = cast(*Str, raw);
                if (rs.len == 0) { return raw; }
                let is i64 as abs = rt_global_or_undef(lit("__abs"));
                if (abs == UNDEF) { return raw; }
                return rt_fcall(abs, UNDEF, 1, raw, UNDEF, UNDEF, UNDEF);
            }
            return attr_value(node, at0, lit(""));
        }
        i = i + 1;
    }
    let is i64 as w with mut = 0;
    while (w < NK_MAX) { if (nk[w] == key) { break; } w = w + 1; }
    if (w == NK_MAX) { return named_item(ov, node, key); }
    if (w == 0) {                                                      // textContent
        if (node == doc_node) { return NULLV; }
        return host_str(H_GET_TEXT, node);
    }
    if (w == 1) { return host_str(H_GET_HTML, node); }                 // innerHTML
    if (w == 2 || w == 3 || w == 4) {                                  // tagName, nodeName, localName
        let is i64 as kd = call(hc(H_KIND), node);
        if (kd == 3) { return lit("#text"); }
        if (kd == 8) { return lit("#comment"); }
        if (kd == 9) { return lit("#document"); }
        if (kd == 11) { return lit("#document-fragment"); }
        let is i64 as s = host_str(H_TAG, node);
        if (w == 4 || call(hc(H_NS), node) != 0) { return s; }
        return map_case(cast(*Str, s), 97, 122, -32);
    }
    if (w == 5) { return V_relList; }
    if (w == 6) { return wrap(call(hc(H_PARENT), node)); }             // parentNode
    if (w == 7) {                                                      // parentElement
        let is i64 as p = call(hc(H_PARENT), node);
        if (p != 0 && call(hc(H_KIND), p) == 1) { return wrap(p); }
        return NULLV;
    }
    if (w == 8) { return box_i(call(hc(H_KIND), node)); }              // nodeType
    if (w == 9) { return kin(node, 0, 0); }                            // firstChild
    if (w == 10) { return kin(node, 1, 0); }                           // lastChild
    if (w == 11) { return kin(node, 2, 0); }                           // nextSibling
    if (w == 12) { return kin(node, 3, 0); }                           // previousSibling
    if (w == 13) { return kin(node, 0, 1); }                           // firstElementChild
    if (w == 14) { return kin(node, 1, 1); }                           // lastElementChild
    if (w == 15) { return kin(node, 2, 1); }                           // nextElementSibling
    if (w == 16) { return kin(node, 3, 1); }                           // previousElementSibling
    if (w == 17) { return node_list(node, 0); }                        // childNodes
    if (w == 18) { return node_list(node, 1); }                        // children
    if (w == 19) {                                                     // ownerDocument
        if (node == doc_node) { return NULLV; }
        return wrap(doc_node);
    }
    if (w == 20) {                                                     // namespaceURI
        let is i64 as ns = call(hc(H_NS), node);
        if (call(hc(H_KIND), node) != 1) { return NULLV; }
        if (ns == 1) { return lit("http://www.w3.org/2000/svg"); }
        if (ns == 2) { return lit("http://www.w3.org/1998/Math/MathML"); }
        return lit("http://www.w3.org/1999/xhtml");
    }
    if (w == 21) { return style_of(ov); }
    if (w == 22 || w == 23) {                                          // nodeValue, data
        let is i64 as kd = call(hc(H_KIND), node);
        if (kd == 3 || kd == 8) { return host_str(H_GET_TEXT, node); }
        return NULLV;
    }
    if (w == 24) {                                                     // isConnected
        let is i64 as x with mut = node;
        while (x != 0) { if (x == doc_node) { return TRUEV; } x = call(hc(H_PARENT), x); }
        return FALSEV;
    }
    if (w == 25) {                                                     // classList
        let is i64 as ctor = rt_global_or_undef(lit("__ClassList"));
        rt_argc = 1;
        return rt_new(ctor, ov, UNDEF, UNDEF, UNDEF);
    }
    if (w == 26) { return G_global; }                                  // defaultView
    if (node == doc_node) {
        if (w == 27) { return query_one(node, "body"); }
        if (w == 28) { return query_one(node, "head"); }
        if (w == 29) { return query_one(node, "html"); }
        if (w == 30) { return doc_state; }                             // readyState
        if (w == 31) {                                                 // activeElement
            let is i64 as fo = call(hc(H_STATE), 0, 0);
            if (fo != 0) { return wrap(fo); }
            return query_one(node, "body");
        }
        if (w == 32) { return V_location; }                            // location
        if (w == 34) { return host_str(H_URL, 0); }                    // URL
        if (w == 35) { return host_str_op(H_COOKIE, 0); }              // cookie
    }
    if (w == 36) { return box_i(call(hc(H_RECT), node, 2)); }          // offsetWidth
    if (w == 37) { return box_i(call(hc(H_RECT), node, 3)); }          // offsetHeight
    return 0;
}
fn host_set(ov as i64, key as i64, v as i64) as i32 {
    let is i64 as node = node_of(ov);
    if (node == doc_node && key == nk[35]) {
        let is *Str as cv = str_of(v);
        call(hc(H_COOKIE), 1, cast(i64, cv.bytes), cv.len);
        return 1;
    }
    if (node == doc_node && key == S_title) { return 1; }
    if (key == S_value) {
        let is *Str as av = str_of(to_str(v));
        if (call(hc(H_AREA), node, 1, cast(i64, av.bytes), av.len, 0) >= 0) { return 1; }
    }
    let is i64 as i with mut = 0;
    while (i < an_n) {
        if (an_key[i] == key) {
            let is *u8 as at0 = an_attr[i];
            if (cast(i64, at0[0]) == 42) {
                let is *u8 as nm = cast(*u8, cast(i64, at0) + 1);
                if (rt_truthy(v) == 1) { call(hc(H_SET_ATTR), node, cast(i64, nm), cstrlen(nm), cast(i64, nm), 0); }
                else { call(hc(H_DEL_ATTR), node, cast(i64, nm), cstrlen(nm)); }
                return 1;
            }
            if (cast(i64, at0[0]) == 45 || cast(i64, at0[0]) == 61) { attr_set(node, cast(*u8, cast(i64, at0) + 1), v); return 1; }
            attr_set(node, at0, v);
            return 1;
        }
        i = i + 1;
    }
    if (key == nk[1]) {
        let is *Str as s = str_of(v);
        call(hc(H_SET_HTML), node, cast(i64, s.bytes), s.len);
        return 1;
    }
    if (key == nk[0]) {
        let is *Str as s with mut = cast(*Str, lit(""));
        if (v != NULLV && v != UNDEF) { s = str_of(v); }
        call(hc(H_SET_TEXT), node, cast(i64, s.bytes), s.len);
        return 1;
    }
    if (key == nk[22] || key == nk[23]) {
        let is *Str as s = str_of(v);
        call(hc(H_SET_DATA), node, cast(i64, s.bytes), s.len);
        return 1;
    }
    return 0;
}
// style: the style attribute, read and written one property at a time.
fn css_name(key as i64) as i64 {
    // backgroundColor to background-color.
    let is *Str as s = cast(*Str, key);
    let is i64 as out with mut = lit("");
    let is i64 as st with mut = 0;
    let is i64 as i with mut = 0;
    while (i < s.len) {
        let is i64 as c = cast(i64, s.bytes[i]);
        if (c >= 65 && c <= 90) {
            out = str_concat(out, sub_str(s, st, i));
            let is [2]u8 as b;
            b[0] = cast(u8, 45); b[1] = cast(u8, c + 32);
