fn style_find(sv as *Str, name as *Str, a_out as *i64, b_out as *i64, vs_out as *i64) as i32 {
    // The declaration of a name in the attribute's text: its span, and where its value starts.
    let is i64 as i with mut = 0;
    while (i < sv.len) {
        let is i64 as st = i;
        while (i < sv.len && cast(i64, sv.bytes[i]) != 59) { i = i + 1; }
        let is i64 as en = i;
        let is i64 as a with mut = st;
        while (a < en && is_space(cast(i64, sv.bytes[a])) == 1) { a = a + 1; }
        let is i64 as c with mut = a;
        while (c < en && cast(i64, sv.bytes[c]) != 58) { c = c + 1; }
        let is i64 as ne with mut = c;
        while (ne > a && is_space(cast(i64, sv.bytes[ne - 1])) == 1) { ne = ne - 1; }
        if (ne - a == name.len) {
            let is i64 as j with mut = 0;
            while (j < name.len && fold(cast(i64, sv.bytes[a + j])) == cast(i64, name.bytes[j])) { j = j + 1; }
            if (j == name.len) { *a_out = st; *b_out = en; *vs_out = c + 1; return 1; }
        }
        i = en + 1;
    }
    return 0;
}
