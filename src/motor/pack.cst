// What the browser carries inside itself, as tools/motor_pack.cst lays it out: "MPK1", how many,
// and then for each its name's length, the name with a zero, its length, its bytes.
fn _get(p as *u8) as i64 { return *cast(*i64, p); }
fn _same(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    return cast(i64, a[i] == b[i]);
}
fn find(b as *u8, name as *u8, n as *i64) as *u8 {
    let is i64 as count = _get(cast(*u8, cast(i64, b) + 4));
    let is i64 as at with mut = cast(i64, b) + 12;
    let is i64 as i with mut = 0;
    while (i < count) {
        let is i64 as nl = _get(cast(*u8, at));
        let is *u8 as nm = cast(*u8, at + 8);
        let is i64 as sz = _get(cast(*u8, at + 8 + nl + 1));
        let is *u8 as data = cast(*u8, at + 8 + nl + 1 + 8);
        if (_same(nm, name) == 1) { *n = sz; return data; }
        at = at + 8 + nl + 1 + 8 + sz;
        i = i + 1;
    }
    return cast(*u8, 0);
}
// Every file whose name starts with /, handed to add(path, data, size).
fn each_std(b as *u8, add as *u8) as void {
    let is i64 as count = _get(cast(*u8, cast(i64, b) + 4));
    let is i64 as at with mut = cast(i64, b) + 12;
    let is i64 as i with mut = 0;
    while (i < count) {
        let is i64 as nl = _get(cast(*u8, at));
        let is *u8 as nm = cast(*u8, at + 8);
        let is i64 as sz = _get(cast(*u8, at + 8 + nl + 1));
        let is i64 as data = at + 8 + nl + 1 + 8;
        if (nm[0] == 47) { call(add, cast(i64, nm), data, sz); }
        at = data + sz;
        i = i + 1;
    }
}
