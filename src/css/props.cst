    if (p == P_ANIMATION_ITERATION_COUNT) { return 4; }
    if (p == P_ANIMATION_TIMING_FUNCTION) { return 32; }
    if (p == P_CONTENT) { return 32; }
    if (p == P_TEXT_DECORATION_LINE) { return 64; }
    if (p == P_VERTICAL_ALIGN) { return 3; }
    if (p == P_OUTLINE_WIDTH) { return 1; }
    if (p == P_OUTLINE_COLOR) { return 8; }
    if (p == P_OUTLINE_OFFSET) { return 1; }
    if (p == P_ACCENT_COLOR) { return 8; }
    if (p == P_FILL) { return 24; }
    if (p == P_STROKE) { return 24; }
    if (p == P_COLOR) { return 8; }
    if (p == P_FONT_FAMILY) { return 32; }
    if (p == P_FONT_SIZE) { return 3; }
    if (p == P_FONT_WEIGHT) { return 4; }
    if (p == P_LINE_HEIGHT) { return 7; }
    if (p == P_TEXT_INDENT) { return 3; }
    if (p == P_LIST_STYLE_IMAGE) { return 16; }
    if (p == P_BORDER_SPACING_H) { return 1; }
    if (p == P_BORDER_SPACING_V) { return 1; }
    if (p == P_LETTER_SPACING) { return 1; }
    if (p == P_WORD_SPACING) { return 1; }
    if (p == P_X_DECORATIONS) { return 64; }
    return 0;
}

// The keywords a property takes, each followed by a space. Null for none.
fn keywords_of(p as i64) as *u8 {
    if (p == P_DISPLAY) { return "block inline inline-block list-item flow-root none table inline-table table-row table-row-group table-header-group table-footer-group table-column table-column-group table-cell table-caption flex inline-flex grid inline-grid contents "; }
    if (p == P_POSITION) { return "static relative absolute fixed sticky "; }
    if (p == P_FLOAT) { return "none left right "; }
    if (p == P_CLEAR) { return "none left right both "; }
    if (p == P_TOP) { return "auto "; }
    if (p == P_RIGHT) { return "auto "; }
    if (p == P_BOTTOM) { return "auto "; }
    if (p == P_LEFT) { return "auto "; }
    if (p == P_Z_INDEX) { return "auto "; }
    if (p == P_MARGIN_TOP) { return "auto "; }
    if (p == P_MARGIN_RIGHT) { return "auto "; }
    if (p == P_MARGIN_BOTTOM) { return "auto "; }
    if (p == P_MARGIN_LEFT) { return "auto "; }
    if (p == P_BORDER_TOP_WIDTH) { return "thin medium thick "; }
    if (p == P_BORDER_RIGHT_WIDTH) { return "thin medium thick "; }
    if (p == P_BORDER_BOTTOM_WIDTH) { return "thin medium thick "; }
    if (p == P_BORDER_LEFT_WIDTH) { return "thin medium thick "; }
    if (p == P_BORDER_TOP_STYLE) { return "none hidden dotted dashed solid double groove ridge inset outset "; }
    if (p == P_BORDER_RIGHT_STYLE) { return "none hidden dotted dashed solid double groove ridge inset outset "; }
    if (p == P_BORDER_BOTTOM_STYLE) { return "none hidden dotted dashed solid double groove ridge inset outset "; }
    if (p == P_BORDER_LEFT_STYLE) { return "none hidden dotted dashed solid double groove ridge inset outset "; }
    if (p == P_WIDTH) { return "auto min-content max-content fit-content "; }
    if (p == P_HEIGHT) { return "auto min-content max-content fit-content "; }
    if (p == P_MIN_WIDTH) { return "auto min-content max-content fit-content "; }
    if (p == P_MAX_WIDTH) { return "none min-content max-content fit-content "; }
    if (p == P_MIN_HEIGHT) { return "auto min-content max-content fit-content "; }
    if (p == P_MAX_HEIGHT) { return "none min-content max-content fit-content "; }
    if (p == P_BOX_SIZING) { return "content-box border-box "; }
    if (p == P_OVERFLOW_X) { return "visible hidden clip scroll auto "; }
    if (p == P_OVERFLOW_Y) { return "visible hidden clip scroll auto "; }
    if (p == P_STROKE_WIDTH) { return "auto "; }
    if (p == P_STROKE_MITERLIMIT) { return "auto "; }
    if (p == P_STROKE_OPACITY) { return "auto "; }
    if (p == P_FILL_OPACITY) { return "auto "; }
    if (p == P_STROKE_LINECAP) { return "auto butt round square "; }
    if (p == P_STROKE_LINEJOIN) { return "auto miter round bevel "; }
    if (p == P_FILL_RULE) { return "auto nonzero evenodd "; }
    if (p == P_BACKGROUND_IMAGE) { return "none "; }
    if (p == P_BACKGROUND_REPEAT) { return "repeat repeat-x repeat-y no-repeat space round "; }
    if (p == P_BACKGROUND_POSITION_X) { return "left center right "; }
    if (p == P_BACKGROUND_POSITION_Y) { return "top center bottom "; }
    if (p == P_BACKGROUND_SIZE_W) { return "auto cover contain "; }
    if (p == P_BACKGROUND_SIZE_H) { return "auto "; }
    if (p == P_MASK_IMAGE) { return "none "; }
    if (p == P_MASK_REPEAT) { return "repeat repeat-x repeat-y no-repeat space round "; }
    if (p == P_MASK_POSITION_X) { return "left center right "; }
    if (p == P_MASK_POSITION_Y) { return "top center bottom "; }
    if (p == P_MASK_SIZE_W) { return "auto cover contain "; }
    if (p == P_MASK_SIZE_H) { return "auto "; }
    if (p == P_X_GRADIENT) { return "none "; }
    if (p == P_BOX_SHADOW) { return "none "; }
    if (p == P_FLEX_DIRECTION) { return "row row-reverse column column-reverse "; }
    if (p == P_FLEX_WRAP) { return "nowrap wrap wrap-reverse "; }
    if (p == P_FLEX_BASIS) { return "auto content min-content max-content fit-content "; }
    if (p == P_JUSTIFY_CONTENT) { return "flex-start flex-end center space-between space-around space-evenly start end left right normal stretch "; }
    if (p == P_ALIGN_ITEMS) { return "normal stretch flex-start flex-end center baseline start end "; }
    if (p == P_ALIGN_SELF) { return "auto normal stretch flex-start flex-end center baseline start end "; }
