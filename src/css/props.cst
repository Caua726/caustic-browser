    if (p == P_MASK_POSITION_Y) { return 3; }
    if (p == P_MASK_SIZE_W) { return 3; }
    if (p == P_MASK_SIZE_H) { return 3; }
    if (p == P_X_GRADIENT) { return 32; }
    if (p == P_BOX_SHADOW) { return 32; }
    if (p == P_FLEX_GROW) { return 4; }
    if (p == P_FLEX_SHRINK) { return 4; }
    if (p == P_FLEX_BASIS) { return 3; }
    if (p == P_ORDER) { return 64; }
    if (p == P_ROW_GAP) { return 3; }
    if (p == P_COLUMN_GAP) { return 3; }
    if (p == P_CONTAINER_NAME) { return 32; }
    if (p == P_COLUMN_COUNT) { return 64; }
    if (p == P_COLUMN_WIDTH) { return 1; }
    if (p == P_GRID_TEMPLATE_COLUMNS) { return 32; }
    if (p == P_GRID_TEMPLATE_ROWS) { return 32; }
    if (p == P_GRID_TEMPLATE_AREAS) { return 32; }
    if (p == P_GRID_AREA_NAME) { return 32; }
    if (p == P_GRID_AUTO_COLUMNS) { return 32; }
    if (p == P_GRID_AUTO_ROWS) { return 32; }
    if (p == P_GRID_ROW_START) { return 64; }
    if (p == P_GRID_COLUMN_START) { return 64; }
    if (p == P_GRID_ROW_END) { return 64; }
    if (p == P_GRID_COLUMN_END) { return 64; }
    if (p == P_SCROLL_PADDING_TOP) { return 3; }
