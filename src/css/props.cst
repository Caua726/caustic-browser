    if (p == P_HEIGHT) { return 3; }
    if (p == P_MIN_WIDTH) { return 3; }
    if (p == P_MAX_WIDTH) { return 3; }
    if (p == P_MIN_HEIGHT) { return 3; }
    if (p == P_MAX_HEIGHT) { return 3; }
    if (p == P_OPACITY) { return 6; }
