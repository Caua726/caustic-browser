    if (p == P_STROKE_OPACITY) { return 4; }
    if (p == P_FILL_OPACITY) { return 4; }
    if (p == P_BACKGROUND_COLOR) { return 8; }
    if (p == P_BACKGROUND_IMAGE) { return 16; }
    if (p == P_BACKGROUND_POSITION_X) { return 3; }
    if (p == P_BACKGROUND_POSITION_Y) { return 3; }
