    if (p == P_GRID_COLUMN_END) { return "auto "; }
    if (p == P_SCROLL_PADDING_TOP) { return "auto "; }
    if (p == P_TRANSFORM) { return "none "; }
    if (p == P_TRANSFORM_ORIGIN_X) { return "auto "; }
    if (p == P_TRANSFORM_ORIGIN_Y) { return "auto "; }
    if (p == P_TRANSITION_PROPERTY) { return "all none "; }
    if (p == P_TRANSITION_DURATION) { return "none "; }
    if (p == P_TRANSITION_DELAY) { return "none "; }
    if (p == P_TRANSITION_TIMING_FUNCTION) { return "none "; }
    if (p == P_ANIMATION_NAME) { return "none "; }
    if (p == P_ANIMATION_ITERATION_COUNT) { return "infinite "; }
    if (p == P_ANIMATION_DIRECTION) { return "normal reverse alternate alternate-reverse "; }
    if (p == P_ANIMATION_FILL_MODE) { return "none forwards backwards both "; }
    if (p == P_ANIMATION_TIMING_FUNCTION) { return "none "; }
    if (p == P_TABLE_LAYOUT) { return "auto fixed "; }
    if (p == P_CONTENT) { return "none normal "; }
    if (p == P_TEXT_DECORATION_LINE) { return "none underline overline line-through "; }
    if (p == P_VERTICAL_ALIGN) { return "baseline sub super top text-top middle bottom text-bottom "; }
    if (p == P_OUTLINE_WIDTH) { return "thin medium thick "; }
    if (p == P_OUTLINE_STYLE) { return "auto none hidden dotted dashed solid double groove ridge inset outset "; }
    if (p == P_VISIBILITY) { return "visible hidden collapse "; }
    if (p == P_ACCENT_COLOR) { return "auto "; }
    if (p == P_FILL) { return "none auto "; }
    if (p == P_STROKE) { return "none auto "; }
    if (p == P_FONT_SIZE) { return "xx-small x-small small medium large x-large xx-large xxx-large smaller larger "; }
    if (p == P_FONT_WEIGHT) { return "normal bold bolder lighter "; }
    if (p == P_FONT_STYLE) { return "normal italic oblique "; }
    if (p == P_LINE_HEIGHT) { return "normal "; }
    if (p == P_TEXT_ALIGN) { return "left right center justify start end -internal-center -webkit-center -moz-center -webkit-left -webkit-right -moz-left -moz-right "; }
    if (p == P_TEXT_TRANSFORM) { return "none uppercase lowercase capitalize "; }
    if (p == P_WHITE_SPACE) { return "normal nowrap pre pre-wrap pre-line break-spaces "; }
    if (p == P_LIST_STYLE_TYPE) { return "disc circle square decimal decimal-leading-zero lower-alpha upper-alpha lower-latin upper-latin lower-roman upper-roman none "; }
    if (p == P_LIST_STYLE_POSITION) { return "outside inside "; }
    if (p == P_LIST_STYLE_IMAGE) { return "none "; }
    if (p == P_BORDER_COLLAPSE) { return "separate collapse "; }
    if (p == P_CAPTION_SIDE) { return "top bottom "; }
    if (p == P_CURSOR) { return "auto default none context-menu help pointer progress wait cell crosshair text vertical-text alias copy move no-drop not-allowed grab grabbing e-resize n-resize ne-resize nw-resize s-resize se-resize sw-resize w-resize ew-resize ns-resize nesw-resize nwse-resize col-resize row-resize all-scroll zoom-in zoom-out "; }
    if (p == P_POINTER_EVENTS) { return "auto none "; }
    if (p == P_SCROLL_BEHAVIOR) { return "auto smooth "; }
    if (p == P_LETTER_SPACING) { return "normal "; }
    if (p == P_WORD_SPACING) { return "normal "; }
    if (p == P_WORD_BREAK) { return "normal break-all keep-all break-word "; }
    if (p == P_OVERFLOW_WRAP) { return "normal break-word anywhere "; }
    return null;
}

fn set_initial(v as *Values) as void {
