fn _lower(c as i64) as i64 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

// Which word of a space-separated list s[0..n] is, ignoring case; -1 for none.
fn _word(list as *u8, s as *u8, n as i64) as i64 {
    let is i64 as at with mut = 0;
    let is i64 as k with mut = 0;
    while (list[at] != 0) {
        let is i64 as i with mut = 0;
        while (i < n && _lower(cast(i64, s[i])) == cast(i64, list[at + i])) { i = i + 1; }
        if (i == n && list[at + i] == 32) { return k; }
        while (list[at] != 32) { at = at + 1; }
        at = at + 1;
        k = k + 1;
    }
    return 0 - 1;
}

fn prop_lookup(s as *u8, n as i64) as i64 { return _word(_PROPS, s, n); }

// The keyword's K_ number, 0 for a word this browser has no use for.
fn kw_lookup(s as *u8, n as i64) as i64 { return _word(_KEYWORDS, s, n) + 1; }

fn in_list(list as *u8, s as *u8, n as i64) as i64 {
    if (_word(list, s, n) >= 0) { return 1; }
    return 0;
}

fn flags_of(p as i64) as i64 {
    if (p == P_TOP) { return 3; }
    if (p == P_RIGHT) { return 3; }
    if (p == P_BOTTOM) { return 3; }
    if (p == P_LEFT) { return 3; }
    if (p == P_Z_INDEX) { return 64; }
    if (p == P_MARGIN_TOP) { return 3; }
    if (p == P_MARGIN_RIGHT) { return 3; }
    if (p == P_MARGIN_BOTTOM) { return 3; }
    if (p == P_MARGIN_LEFT) { return 3; }
    if (p == P_PADDING_TOP) { return 3; }
    if (p == P_PADDING_RIGHT) { return 3; }
    if (p == P_PADDING_BOTTOM) { return 3; }
    if (p == P_PADDING_LEFT) { return 3; }
