        let is i64 as n with mut = 0;
        let is i64 as more with mut = 1;
        while (more == 1 && t.pos < t.len && n < MAX_TMP - 4) {
            let is i64 as ch = _peek(t);
            if (_is_alnum(ch) == 1) { _tmp_push(t, ch); t.pos = t.pos + 1; n = n + 1; }
            else {
                if (ch == 59) { _tmp_push(t, ch); t.pos = t.pos + 1; n = n + 1; }
                more = 0;
            }
        }
        // tmp[0] is the '&'; candidate names run from tmp[1].
        let is i64 as best with mut = 0 - 1;
        let is i64 as bestlen with mut = 0;
        let is i64 as cand with mut = n;
        while (cand > 0 && best < 0) {
            let is i64 as hit = _ent_lookup(t, 1, cand);
            if (hit >= 0) { best = hit; bestlen = cand; }
            else { cand = cand - 1; }
        }
        if (best < 0) {
            // Nothing matched: the '&' is text and everything after it is
            // reconsumed as an ambiguous ampersand — `&foo` stays `&foo`.
            _ref_push(t, 38);
            t.pos = start;
            t.tmplen = 0;
            t.state = ST_AMBIGUOUS_AMP;
            return;
        }
        let is i64 as semi with mut = 0;
        if (t.tmp[bestlen] == cast(u8, 59)) { semi = 1; }
        if (semi == 0) {
            // A name missing its semicolon, inside an attribute value, followed
            // by '=' or an alphanumeric, is NOT a reference: `?a=1&nots=2` must
            // stay as written. Outside an attribute the same input IS the
            // entity — the two contexts genuinely differ.
            // The character after the matched name. It is inside tmp when the
            // match stopped short of everything consumed, and is the NEXT
            // INPUT character when the match used all of it — `&not=` consumes
            // `not` and stops at `=`, which never enters tmp. Reading only tmp
            // made that case an entity and turned `?a=1&not=2` into `?a=1¬=2`.
            if (_in_attr(t) == 1) {
                let is i64 as nxt with mut = 0;
                if (bestlen < n) { nxt = cast(i64, t.tmp[bestlen + 1]); }
                else {
                    if (t.pos < t.len) { nxt = _peek(t); }
                }
                if (nxt == 61 || _is_alnum(nxt) == 1) {
                    let is i64 as k with mut = 0;
                    while (k <= n) { _ref_push(t, cast(i64, t.tmp[k])); k = k + 1; }
                    t.tmplen = 0;
                    t.state = t.ret_state;
                    return;
                }
            }
            t.errors = t.errors + 1;
        }
        let is *u8 as v = ent.ent_value(best);
        let is i64 as i with mut = 0;
        while (v[i] != 0) { _ref_push(t, cast(i64, v[i])); i = i + 1; }
        i = bestlen + 1;
        while (i <= n) { _ref_push(t, cast(i64, t.tmp[i])); i = i + 1; }
        t.tmplen = 0;
        t.state = t.ret_state;
        return;
    }
    if (st == ST_AMBIGUOUS_AMP) {
        if (_is_alnum(c) == 1) { t.pos = t.pos + 1; _ref_push(t, c); return; }
        if (c == 59) { t.errors = t.errors + 1; }
        t.state = t.ret_state;
        return;
    }
    if (st == ST_NUMERIC_REF) {
        if (c == 120 || c == 88) { t.pos = t.pos + 1; _tmp_push(t, c); t.state = ST_HEX_REF_START; return; }
        t.state = ST_DEC_REF_START;
        return;
    }
    if (st == ST_HEX_REF_START || st == ST_DEC_REF_START) {
        let is i64 as ok with mut = 0;
        if (st == ST_HEX_REF_START) { ok = _is_hex(c); } else { ok = _is_digit(c); }
        if (ok == 1) {
            if (st == ST_HEX_REF_START) { t.state = ST_HEX_REF; } else { t.state = ST_DEC_REF; }
            return;
        }
        // `&#` or `&#x` with nothing usable after it stays as written.
        t.errors = t.errors + 1;
        let is i64 as i with mut = 0;
        while (i < t.tmplen) { _ref_push(t, cast(i64, t.tmp[i])); i = i + 1; }
        t.tmplen = 0;
        t.state = t.ret_state;
        return;
    }
    if (st == ST_HEX_REF) {
        if (_is_hex(c) == 1) { t.pos = t.pos + 1; _num_hex(t, c); return; }
        if (c == 59) { t.pos = t.pos + 1; t.state = ST_NUMERIC_REF_END; return; }
        t.errors = t.errors + 1;
        t.state = ST_NUMERIC_REF_END;
        return;
    }
    if (st == ST_DEC_REF) {
        if (_is_digit(c) == 1) { t.pos = t.pos + 1; _num_dec(t, c); return; }
        if (c == 59) { t.pos = t.pos + 1; t.state = ST_NUMERIC_REF_END; return; }
        t.errors = t.errors + 1;
        t.state = ST_NUMERIC_REF_END;
        return;
    }
    if (st == ST_NUMERIC_REF_END) {
        _num_finish(t);
        t.tmplen = 0;
        t.state = t.ret_state;
        return;
    }

    // Unreachable for any state above. Consuming a character rather than
    // spinning means a state added later without a branch here makes progress
    // and shows up as wrong output instead of a hang.
    t.pos = t.pos + 1;
}

// --- the loop ------------------------------------------------------------
//
// Run the machine until it stages a token. A character run that ended goes out
// first and the staged token waits in `pending`.
fn tok_next(t as *Tokenizer) as i64 {
    if (t.pending != 0) {
        let is i64 as k = t.pending;
        t.pending = 0;
        return k;
    }
    t.textlen = 0;
    while (t.staged == 0) { _step(t); }
    let is i64 as k = t.staged;
    t.staged = 0;
    if (t.textlen > 0) {
        t.pending = k;
        return TOK_CHAR;
    }
    return k;
}

// --- reading the current token -------------------------------------------
fn tok_text(t as *Tokenizer) as *u8 { return t.text; }
fn tok_text_len(t as *Tokenizer) as i64 { return t.textlen; }
fn tok_name(t as *Tokenizer) as *u8 { return cast(*u8, &t.name); }
fn tok_name_len(t as *Tokenizer) as i64 { return t.namelen; }
fn tok_self_closing(t as *Tokenizer) as i64 { return t.self_closing; }
fn tok_nattr(t as *Tokenizer) as i64 { return t.nattr; }
fn tok_attr_name(t as *Tokenizer, i as i64) as *u8 {
    return cast(*u8, cast(i64, t.arena) + t.an_off[i]);
}
fn tok_attr_name_len(t as *Tokenizer, i as i64) as i64 { return t.an_len[i]; }
fn tok_attr_value(t as *Tokenizer, i as i64) as *u8 {
    return cast(*u8, cast(i64, t.arena) + t.av_off[i]);
}
fn tok_attr_value_len(t as *Tokenizer, i as i64) as i64 { return t.av_len[i]; }
fn tok_doctype_public(t as *Tokenizer) as *u8 { return cast(*u8, &t.pub_id); }
fn tok_doctype_public_len(t as *Tokenizer) as i64 { return t.pub_len; }
fn tok_has_public(t as *Tokenizer) as i64 { return t.has_pub; }
fn tok_doctype_system(t as *Tokenizer) as *u8 { return cast(*u8, &t.sys_id); }
fn tok_doctype_system_len(t as *Tokenizer) as i64 { return t.sys_len; }
fn tok_has_system(t as *Tokenizer) as i64 { return t.has_sys; }
fn tok_force_quirks(t as *Tokenizer) as i64 { return t.force_quirks; }
fn tok_errors(t as *Tokenizer) as i64 { return t.errors; }
