// caustic-browser — the window, and what will one day be a page inside it.
//
//   browser           run it
//   browser --check   drive the window through its tabs and close; exit 0 = pass

use "std/io.cst" as io;
use "std/env.cst" as env;
use "caustic-media/ui/ui.cst" as ui;
use "ui/browser.cst" as browser;

// Kept here because it must not move while it is open.
let is ui.program.Program as prog with mut;

fn _is_check(s as *u8) as i32 {
    let is *u8 as want = "--check";
    let is i64 as i with mut = 0;
    while (want[i] != 0) {
        if (s[i] != want[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, s[i] == 0);
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is i32 as checking = cast(i32, env.argc() > 1 && _is_check(env.argv(1)) == 1);
    if (ui.program.open(&prog, cast(*u8, 0)) == 0) {
        io.write_str(2, "caustic-browser: no fonts on this system\n");
        return 1;
    }
    if (browser.open(&prog) == 0) {
        io.write_str(2, "caustic-browser: could not open a window\n");
        ui.program.close(&prog);
        return 1;
    }
    let is i64 as fails with mut = 0;
    if (checking == 1) { fails = browser.check(); }
    else { browser.run(); }
    ui.program.close(&prog);
    browser.free_docs();
    if (checking == 0) { return 0; }
    if (fails != 0) { return cast(i32, fails); }
    io.write_str(1, "browser: all checks pass\n");
    return 0;
}
