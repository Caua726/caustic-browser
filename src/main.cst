// caustic-browser — the window, and what will one day be a page inside it.
//
//   browser                    run it
//   browser ADDRESS            run it, with this page open: a URL or a path
//   browser --check            drive the window through its tabs and close; exit 0 = pass
//   browser --dump-dom FILE    parse an HTML file and print its tree; opens no window
//   browser --dump-css FILE    parse a stylesheet and print what was understood; no window

use "std/io.cst" as io;
use "std/env.cst" as env;
if (__target_is_linux) use "std/os/linux.cst" as linux;
use "caustic-media/ui/ui.cst" as ui;
use "ui/browser.cst" as browser;
use "dom/dom.cst" as dom;
use "dom/dump.cst" as dump;
use "html/tree.cst" as tree;
use "base/arena.cst" as arena;
use "css/sheet.cst" as sheet;
use "css/dump.cst" as cssdump;
use "loader/file.cst" as file;

// Kept here because it must not move while it is open.
let is ui.program.Program as prog with mut;

fn _is_arg(s as *u8, want as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (want[i] != 0) {
        if (s[i] != want[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, s[i] == 0);
}

fn _dump_dom(path as *u8) as i32 {
    let is file.File as f with mut;
    if (file.read(path, &f) != 0) {
        io.write_str(2, "caustic-browser: could not read ");
        io.write_str(2, path);
        io.write_str(2, "\n");
        return 1;
    }
    let is dom.Document as d with mut;
    dom.init(&d);
    if (tree.parse(&d, f.data, f.len) != 0) {
        io.write_str(2, "caustic-browser: out of memory\n");
        return 1;
    }
    dump.dump(&d, 1);
    dom.free(&d);
    file.free(&f);
    return 0;
}

// An .html file prints the rules of its <style> elements; anything else is a stylesheet.
fn _dump_css(path as *u8) as i32 {
    let is file.File as f with mut;
    if (file.read(path, &f) != 0) {
        io.write_str(2, "caustic-browser: could not read ");
        io.write_str(2, path);
        io.write_str(2, "\n");
        return 1;
    }
    let is arena.Arena as a with mut;
    arena.init(&a);
    let is sheet.Sheet as s with mut;
    sheet.init(&s, &a);
    let is i64 as n with mut = 0;
    while (path[n] != 0) { n = n + 1; }
    let is i64 as html = cast(i64, n > 5 && path[n - 5] == 46 && path[n - 4] == 104 && path[n - 3] == 116 && path[n - 2] == 109 && path[n - 1] == 108);
    if (html == 0) {
        sheet.parse(&s, f.data, f.len, sheet.ORIGIN_AUTHOR, cast(*u8, 0));
    } else {
        let is dom.Document as d with mut;
        dom.init(&d);
        if (tree.parse(&d, f.data, f.len) != 0) {
            io.write_str(2, "caustic-browser: out of memory\n");
            return 1;
        }
        _dump_styles(d.node, &s);
        dom.free(&d);
    }
    cssdump.dump(&s, 1);
    arena.free(&a);
    file.free(&f);
    return 0;
}

fn _dump_styles(n as *dom.Node, s as *sheet.Sheet) as void {
    let is *dom.Node as x with mut = n.first;
    while (x != null) {
        if (x.kind == dom.ELEMENT) {
            if (x.name_len == 5 && x.name[0] == 115 && x.name[1] == 116 && x.name[2] == 121 && x.name[3] == 108 && x.name[4] == 101) {
                let is *dom.Node as t with mut = x.first;
                while (t != null) {
                    if (t.kind == dom.TEXT) { sheet.parse(s, t.text, t.text_len, sheet.ORIGIN_AUTHOR, cast(*u8, 0)); }
                    t = t.next;
                }
            } else {
                _dump_styles(x, s);
            }
        }
        x = x.next;
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (env.argc() > 1 && _is_arg(env.argv(1), "--dump-dom") == 1) {
        if (env.argc() != 3) {
            io.write_str(2, "usage: browser --dump-dom FILE\n");
            return 2;
        }
        return _dump_dom(env.argv(2));
    }
    if (env.argc() > 1 && _is_arg(env.argv(1), "--dump-css") == 1) {
        if (env.argc() != 3) {
            io.write_str(2, "usage: browser --dump-css FILE\n");
            return 2;
        }
        return _dump_css(env.argv(2));
    }
    // browser --run URL: load it, run its scripts, and when nothing more is coming print the
    // document as it then stands and end.
    let is i64 as run_mode = cast(i64, env.argc() > 2 && _is_arg(env.argv(1), "--run") == 1);
    let is i32 as checking = cast(i32, env.argc() > 1 && _is_arg(env.argv(1), "--check") == 1);
    if (ui.program.open(&prog, cast(*u8, 0)) == 0) {
        io.write_str(2, "caustic-browser: no fonts on this system\n");
        return 1;
    }
    if (browser.open(&prog) == 0) {
        io.write_str(2, "caustic-browser: could not open a window\n");
        ui.program.close(&prog);
        return 1;
    }
    let is i64 as fails with mut = 0;
    // Anything else on the command line is where to start.
    if (checking == 0 && env.argc() > 1) {
        let is *u8 as a with mut = env.argv(1);
        if (run_mode == 1) { a = env.argv(2); browser.report_when_settled(); }
        let is i64 as n with mut = 0;
        while (a[n] != 0) { n = n + 1; }
        browser.open_address(a, n);
    }
    if (checking == 1) { fails = browser.check(); }
    else { browser.run(); }
    ui.program.close(&prog);
    browser.free_docs();
    if (checking == 1 && fails == 0) { io.write_str(1, "browser: all checks pass\n"); }
    // The fetcher's threads never end by themselves, and returning from here would only
    // end this one.
    if (__target_is_linux) { linux.exit(fails); }
    return 0;
}
